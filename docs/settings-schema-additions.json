[
  {
    "name": "Design System — Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Controls ALL fonts across the entire store. One change here updates every heading, button, nav, and body text automatically."
      },
      {
        "type": "header",
        "content": "Global Fonts"
      },
      {
        "type": "font_picker",
        "id": "uc_font_heading",
        "label": "Heading font",
        "default": "poppins_n6",
        "info": "Used for all H1–H5 headings. Default: Poppins."
      },
      {
        "type": "font_picker",
        "id": "uc_font_body",
        "label": "Body font",
        "default": "poppins_n4",
        "info": "Used for body copy, labels, captions. Default: Poppins."
      },
      {
        "type": "range",
        "id": "uc_font_size_base",
        "label": "Base font size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Specialized Fonts"
      },
      {
        "type": "select",
        "id": "uc_nav_font_source",
        "label": "Navigation font",
        "options": [
          { "value": "body",    "label": "Inherit body font" },
          { "value": "heading", "label": "Inherit heading font" },
          { "value": "custom",  "label": "Custom font (select below)" }
        ],
        "default": "body",
        "info": "Controls header nav links."
      },
      {
        "type": "font_picker",
        "id": "uc_font_nav",
        "label": "Custom navigation font",
        "default": "manrope_n4",
        "info": "Only used when Navigation font is set to Custom."
      },
      {
        "type": "select",
        "id": "uc_btn_font_source",
        "label": "Button font",
        "options": [
          { "value": "body",    "label": "Inherit body font (recommended)" },
          { "value": "heading", "label": "Inherit heading font" }
        ],
        "default": "body"
      },
      {
        "type": "select",
        "id": "uc_product_title_font_source",
        "label": "Product title font",
        "options": [
          { "value": "heading", "label": "Inherit heading font (recommended)" },
          { "value": "body",    "label": "Inherit body font" },
          { "value": "custom",  "label": "Custom font" }
        ],
        "default": "heading"
      },
      {
        "type": "font_picker",
        "id": "uc_font_product_title",
        "label": "Custom product title font",
        "default": "poppins_n6",
        "info": "Only used when Product title font is set to Custom."
      },
      {
        "type": "header",
        "content": "Font Weights & Styles"
      },
      {
        "type": "select",
        "id": "uc_font_weight_heading",
        "label": "Heading weight",
        "options": [
          { "value": "500", "label": "Medium (500)" },
          { "value": "600", "label": "SemiBold (600)" },
          { "value": "700", "label": "Bold (700)" },
          { "value": "800", "label": "ExtraBold (800)" },
          { "value": "900", "label": "Black (900)" }
        ],
        "default": "700"
      },
      {
        "type": "select",
        "id": "uc_font_weight_body",
        "label": "Body weight",
        "options": [
          { "value": "300", "label": "Light (300)" },
          { "value": "400", "label": "Regular (400)" },
          { "value": "500", "label": "Medium (500)" }
        ],
        "default": "400"
      },
      {
        "type": "select",
        "id": "uc_btn_font_weight",
        "label": "Button weight",
        "options": [
          { "value": "400", "label": "Regular (400)" },
          { "value": "500", "label": "Medium (500)" },
          { "value": "600", "label": "SemiBold (600)" },
          { "value": "700", "label": "Bold (700)" }
        ],
        "default": "600"
      },
      {
        "type": "select",
        "id": "uc_letter_spacing_heading",
        "label": "Heading letter spacing",
        "options": [
          { "value": "tight",  "label": "Tight (−0.02em)" },
          { "value": "normal", "label": "Normal (0)" },
          { "value": "wide",   "label": "Wide (+0.05em)" }
        ],
        "default": "tight"
      },
      {
        "type": "select",
        "id": "uc_letter_spacing_nav",
        "label": "Navigation letter spacing",
        "options": [
          { "value": "tight",  "label": "Tight (0em)" },
          { "value": "normal", "label": "Normal (0.06em)" },
          { "value": "wide",   "label": "Wide (0.12em)" }
        ],
        "default": "normal",
        "info": "Slight letter spacing on nav gives a premium luxury feel."
      },
      {
        "type": "select",
        "id": "uc_line_height_body",
        "label": "Body line height",
        "options": [
          { "value": "compact",     "label": "Compact (1.5)" },
          { "value": "comfortable", "label": "Comfortable (1.7)" },
          { "value": "relaxed",     "label": "Relaxed (1.85)" }
        ],
        "default": "comfortable"
      }
    ]
  },

  {
    "name": "Design System — Brand Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Controls the core brand palette. One change here updates every button, icon, link, and highlight across the entire storefront. Individual sections can override these under their own settings."
      },
      {
        "type": "header",
        "content": "Brand Accent — Luxury Gold"
      },
      {
        "type": "color",
        "id": "uc_color_primary",
        "label": "Primary accent color",
        "default": "#B68A35",
        "info": "Luxury Gold. Used for buttons, links, icons, active nav, and highlights."
      },
      {
        "type": "color",
        "id": "uc_color_primary_dark",
        "label": "Accent hover / dark shade",
        "default": "#8F6824",
        "info": "Shown on button hover and active states."
      },
      {
        "type": "color",
        "id": "uc_color_secondary",
        "label": "Secondary accent",
        "default": "#C9A55A",
        "info": "Lighter gold for decorative accents and hover effects."
      },
      {
        "type": "header",
        "content": "Backgrounds"
      },
      {
        "type": "color",
        "id": "uc_color_bg",
        "label": "Page background",
        "default": "#F7F4EF",
        "info": "Warm Luxury Ivory. Applied to all pages: home, collection, product, cart, account."
      },
      {
        "type": "color",
        "id": "uc_color_surface",
        "label": "Alternate section background",
        "default": "#FCFAF7",
        "info": "Soft Cream. Used to create visual rhythm between alternating sections."
      },
      {
        "type": "color",
        "id": "uc_color_card_bg",
        "label": "Card / drawer background",
        "default": "#FFFFFF",
        "info": "Pure white. Used for product cards, blog cards, modals, drawers, and forms."
      },
      {
        "type": "header",
        "content": "Text Colors"
      },
      {
        "type": "color",
        "id": "uc_color_text",
        "label": "Heading / primary text",
        "default": "#171717",
        "info": "Luxury Charcoal. Used for all headings."
      },
      {
        "type": "color",
        "id": "uc_color_text_body",
        "label": "Body text",
        "default": "#555555"
      },
      {
        "type": "color",
        "id": "uc_color_text_muted",
        "label": "Secondary text",
        "default": "#7A7A7A",
        "info": "Captions, labels, descriptions."
      },
      {
        "type": "color",
        "id": "uc_color_text_light",
        "label": "Light / placeholder text",
        "default": "#A3A3A3",
        "info": "Placeholders, disabled states."
      },
      {
        "type": "header",
        "content": "Borders & Dividers"
      },
      {
        "type": "color",
        "id": "uc_color_border",
        "label": "Border color",
        "default": "#E6E0D6"
      },
      {
        "type": "color",
        "id": "uc_color_divider",
        "label": "Divider / hairline color",
        "default": "#EFE8DE",
        "info": "Used for thin horizontal lines between sections and content areas."
      },
      {
        "type": "header",
        "content": "Feedback & Status Colors"
      },
      {
        "type": "color",
        "id": "uc_color_success",
        "label": "Success",
        "default": "#4A7A54"
      },
      {
        "type": "color",
        "id": "uc_color_error",
        "label": "Error / sale price",
        "default": "#C24A3A"
      },
      {
        "type": "color",
        "id": "uc_color_warning",
        "label": "Warning",
        "default": "#C38C2D"
      },
      {
        "type": "header",
        "content": "Sale Badge"
      },
      {
        "type": "color",
        "id": "uc_color_sale_bg",
        "label": "Sale badge background",
        "default": "#B83D3D"
      },
      {
        "type": "color",
        "id": "uc_color_sale_text",
        "label": "Sale badge text",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Footer — Dark Scheme"
      },
      {
        "type": "color",
        "id": "uc_color_footer_bg",
        "label": "Footer background",
        "default": "#171717",
        "info": "Luxury dark charcoal."
      },
      {
        "type": "color",
        "id": "uc_color_footer_text",
        "label": "Footer text",
        "default": "#D4C9B8",
        "info": "Warm cream for legibility on dark background."
      },
      {
        "type": "color",
        "id": "uc_color_footer_border",
        "label": "Footer border / divider",
        "default": "#2E2A24"
      },
      {
        "type": "color",
        "id": "uc_rating_color",
        "label": "Star rating color",
        "default": "#B68A35",
        "info": "Gold stars for product reviews."
      }
    ]
  },

  {
    "name": "Design System — Layout & Spacing",
    "settings": [
      {
        "type": "range",
        "id": "uc_container_max",
        "label": "Max container width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1440,
        "info": "Maximum width of all page content areas."
      },
      {
        "type": "range",
        "id": "uc_content_max",
        "label": "Max content width (inner)",
        "min": 960,
        "max": 1440,
        "step": 20,
        "unit": "px",
        "default": 1280,
        "info": "Tighter max-width for article/text-heavy content."
      },
      {
        "type": "range",
        "id": "uc_section_padding",
        "label": "Section vertical padding (desktop)",
        "min": 40,
        "max": 160,
        "step": 8,
        "unit": "px",
        "default": 120,
        "info": "Scales down automatically on tablet (80px) and mobile (56px)."
      },
      {
        "type": "range",
        "id": "uc_card_padding",
        "label": "Card inner padding",
        "min": 12,
        "max": 48,
        "step": 4,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "uc_grid_gap",
        "label": "Grid gap",
        "min": 12,
        "max": 56,
        "step": 4,
        "unit": "px",
        "default": 32,
        "info": "Default spacing between grid items (cards, columns, etc.)."
      }
    ]
  },

  {
    "name": "Design System — Shape & Style",
    "settings": [
      {
        "type": "paragraph",
        "content": "Controls border radius for all elements. These values update every button, card, input, badge, drawer, and popup simultaneously."
      },
      {
        "type": "range",
        "id": "uc_radius_button",
        "label": "Button radius",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 10,
        "info": "0 = sharp corners. 10 = luxury soft. 100 = pill."
      },
      {
        "type": "range",
        "id": "uc_radius_card",
        "label": "Card radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 18,
        "info": "Applied to product cards, blog cards, and content panels."
      },
      {
        "type": "range",
        "id": "uc_radius_input",
        "label": "Input / field radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 10,
        "info": "Applied to all text inputs, select fields, and search bars."
      },
      {
        "type": "range",
        "id": "uc_radius_badge",
        "label": "Badge radius",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 100,
        "info": "Sale, New, and bestseller badge corner radius."
      },
      {
        "type": "range",
        "id": "uc_radius_image",
        "label": "Image corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 20,
        "info": "Applied to product images, blog thumbnails, and media."
      },
      {
        "type": "range",
        "id": "uc_radius_drawer",
        "label": "Drawer / sidebar radius",
        "min": 0,
        "max": 32,
        "step": 4,
        "unit": "px",
        "default": 24,
        "info": "Cart drawer, filter sidebar, mobile menu panel."
      },
      {
        "type": "range",
        "id": "uc_radius_popup",
        "label": "Popup / modal radius",
        "min": 0,
        "max": 32,
        "step": 4,
        "unit": "px",
        "default": 24,
        "info": "Quick view, cookie popup, announcement popup."
      }
    ]
  },

  {
    "name": "Design System — Shadows",
    "settings": [
      {
        "type": "paragraph",
        "content": "CSS box-shadow values. Keep them warm and subtle for a luxury feel. Example: '0 10px 30px rgba(0,0,0,0.08)'"
      },
      {
        "type": "text",
        "id": "uc_shadow_sm",
        "label": "Small shadow (hover elements)",
        "default": "0 4px 12px rgba(0,0,0,0.05)"
      },
      {
        "type": "text",
        "id": "uc_shadow_md",
        "label": "Medium shadow (cards at rest)",
        "default": "0 10px 30px rgba(0,0,0,0.08)"
      },
      {
        "type": "text",
        "id": "uc_shadow_lg",
        "label": "Large shadow (card hover / modals)",
        "default": "0 20px 60px rgba(0,0,0,0.10)"
      }
    ]
  },

  {
    "name": "Design System — Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "uc_animations_enabled",
        "label": "Enable scroll reveal animations",
        "default": true,
        "info": "Disable for faster perceived performance or for accessibility. Always off for users who prefer reduced motion."
      },
      {
        "type": "select",
        "id": "uc_transition_speed",
        "label": "Global transition speed",
        "options": [
          { "value": "fast",   "label": "Fast — snappy hover" },
          { "value": "normal", "label": "Normal — balanced (recommended)" },
          { "value": "slow",   "label": "Slow — cinematic luxury" }
        ],
        "default": "normal"
      },
      {
        "type": "select",
        "id": "uc_animation_easing",
        "label": "Animation easing",
        "options": [
          { "value": "ease",    "label": "Standard ease" },
          { "value": "premium", "label": "Premium deceleration (recommended)" },
          { "value": "spring",  "label": "Spring — subtle bounce" }
        ],
        "default": "premium"
      }
    ]
  },

  {
    "name": "Design System — Buttons",
    "settings": [
      {
        "type": "paragraph",
        "content": "Controls ALL buttons across the entire store. Individual sections may further override button colors via their own Section Colors settings."
      },
      {
        "type": "range",
        "id": "uc_btn_font_size",
        "label": "Button label size",
        "min": 11,
        "max": 16,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "uc_btn_padding_x",
        "label": "Button side padding",
        "min": 16,
        "max": 60,
        "step": 4,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "uc_btn_padding_y",
        "label": "Button top/bottom padding",
        "min": 8,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 13
      }
    ]
  },

  {
    "name": "Design System — Product Cards",
    "settings": [
      {
        "type": "select",
        "id": "uc_card_image_ratio",
        "label": "Product image ratio",
        "options": [
          { "value": "portrait",   "label": "Portrait (4:5) — recommended for beauty" },
          { "value": "square",     "label": "Square (1:1)" },
          { "value": "landscape",  "label": "Landscape (4:3)" }
        ],
        "default": "portrait",
        "info": "Upload product images at the matching ratio for best results. Recommended: 800 × 1000px."
      },
      {
        "type": "select",
        "id": "uc_card_hover_effect",
        "label": "Card hover effect",
        "options": [
          { "value": "lift",  "label": "Lift — rise up with shadow" },
          { "value": "glow",  "label": "Glow — gold border ring" },
          { "value": "scale", "label": "Scale — slight zoom" },
          { "value": "none",  "label": "None" }
        ],
        "default": "lift"
      },
      {
        "type": "checkbox",
        "id": "uc_show_quick_add",
        "label": "Show Quick Add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "uc_show_secondary_image",
        "label": "Show secondary image on hover",
        "default": true,
        "info": "Requires a second product image. Shows alternate angle on card hover."
      }
    ]
  }
]
