{%- comment -%}
  UC Blog card — custom editorial card (not Dawn).
  Accepts: article, show_date, show_author, show_excerpt, lazy_load
{%- endcomment -%}
{%- liquid
  assign uc_read_mins = article.content | strip_html | split: ' ' | size | divided_by: 200 | at_least: 1
  assign uc_lazy = lazy_load | default: true
  assign uc_has_image = false
  if article.image != blank
    assign uc_has_image = true
  endif
-%}
<article class="uc-blog-card">
  <a class="uc-blog-card__link" href="{{ article.url }}" aria-labelledby="UcBlogCard-{{ article.id }}">
    <div class="uc-blog-card__media{% unless uc_has_image %} uc-blog-card__media--empty{% endunless %}">
      {%- if uc_has_image -%}
        <img
          class="uc-blog-card__img"
          src="{{ article.image | image_url: width: 800 }}"
          srcset="{{ article.image | image_url: width: 480 }} 480w, {{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 990px) 280px, (min-width: 750px) 40vw, 92vw"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          {% if uc_lazy %}loading="lazy"{% else %}loading="eager" fetchpriority="high"{% endif %}
        >
      {%- else -%}
        <span class="uc-blog-card__ph" aria-hidden="true">
          <span class="uc-blog-card__ph-mark">UNIK</span>
        </span>
      {%- endif -%}
    </div>

    <div class="uc-blog-card__body">
      <p class="uc-blog-card__meta">
        {%- if show_date -%}<span>{{ article.published_at | date: '%b %d, %Y' }}</span>{%- endif -%}
        {%- if show_date -%}<span class="uc-blog-card__sep" aria-hidden="true">·</span>{%- endif -%}
        <span>{{ uc_read_mins }} min</span>
        {%- if show_author and article.author != blank -%}
          <span class="uc-blog-card__sep" aria-hidden="true">·</span>
          <span>{{ article.author }}</span>
        {%- endif -%}
      </p>
      <h2 class="uc-blog-card__title" id="UcBlogCard-{{ article.id }}">{{ article.title | escape }}</h2>
      {%- if show_excerpt -%}
        <p class="uc-blog-card__excerpt">
          {%- if article.excerpt != blank -%}
            {{ article.excerpt | strip_html | truncatewords: 18 }}
          {%- else -%}
            {{ article.content | strip_html | truncatewords: 18 }}
          {%- endif -%}
        </p>
      {%- endif -%}
      <span class="uc-blog-card__cta">Read article</span>
    </div>
  </a>
</article>
