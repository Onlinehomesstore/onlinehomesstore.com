{%- comment -%}
 UC Star Rating — stacked SVG rows (grid clip, not absolute escape).
 pct: 0-100 fill | class: extra classes | label: aria-label
{%- endcomment -%}
{%- liquid
  assign star_pct = pct | default: 100 | plus: 0
  if star_pct < 0
    assign star_pct = 0
  endif
  if star_pct > 100
    assign star_pct = 100
  endif
  assign star_class = class | default: 'uc-stars'
-%}
<span
  class="uc-stars {{ star_class }}"
  style="--uc-star-pct: {{ star_pct }}%; --pt-star-pct: {{ star_pct }}%; --pc-star-pct: {{ star_pct }}%; --pph-star-pct: {{ star_pct }}%; --pvr-star-pct: {{ star_pct }}%;"
  {%- if label != blank -%}
  aria-label="{{ label | escape }}"
  role="img"
  {%- else -%}
  aria-hidden="true"
  {%- endif -%}
>
  <span class="uc-stars__row uc-stars__row--empty">
    {%- for i in (1..5) -%}
      <svg class="uc-star-glyph" viewBox="0 0 20 20" width="20" height="20" focusable="false" aria-hidden="true"><path fill="currentColor" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.49L10 14.27l-4.94 2.43.94-5.49-4-3.9 5.53-.8z"/></svg>
    {%- endfor -%}
  </span>
  <span class="uc-stars__row uc-stars__row--fill">
    {%- for i in (1..5) -%}
      <svg class="uc-star-glyph" viewBox="0 0 20 20" width="20" height="20" focusable="false" aria-hidden="true"><path fill="currentColor" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.49L10 14.27l-4.94 2.43.94-5.49-4-3.9 5.53-.8z"/></svg>
    {%- endfor -%}
  </span>
</span>
