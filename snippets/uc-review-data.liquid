{%- comment -%}
  Include (not render) so parent Liquid can read:

    uc_review_source  metafield | shopify | loox | judgeme | fallback | none
    uc_reviews        live metafield list only
    uc_review_family  shampoo | gel | sachets | mask | set | care
    uc_review_avg
    uc_review_count
    uc_review_pct
    uc_reviews_live   true when a real source replaced the fallback

  New products inherit a family from handle, type, and title.
  Live metafields or a reviews app turn the fallback off automatically.
{%- endcomment -%}
{%- liquid
  assign uc_review_product = product
  if uc_review_product == blank
    assign uc_review_product = card_product
  endif

  assign uc_review_source = 'none'
  assign uc_reviews = nil
  assign uc_review_avg = 0
  assign uc_review_count = 0
  assign uc_review_pct = 0
  assign uc_reviews_live = false
  assign uc_review_family = 'care'

  assign uc_hay = uc_review_product.handle | append: ' ' | append: uc_review_product.type | append: ' ' | append: uc_review_product.title | downcase
  if uc_hay contains 'sachet'
    assign uc_review_family = 'sachets'
  elsif uc_hay contains 'gel'
    assign uc_review_family = 'gel'
  elsif uc_hay contains 'mask'
    assign uc_review_family = 'mask'
  elsif uc_hay contains 'conditioner' or uc_hay contains 'onion' or uc_hay contains 'biotine'
    assign uc_review_family = 'set'
  elsif uc_hay contains 'shampoo' or uc_hay contains 'dye' or uc_hay contains 'colour' or uc_hay contains 'color'
    assign uc_review_family = 'shampoo'
  endif

  assign uc_live_list = uc_review_product.metafields.custom.reviews.value
  if uc_live_list != blank and uc_live_list.size > 0
    assign uc_review_source = 'metafield'
    assign uc_reviews = uc_live_list
    assign uc_reviews_live = true
  endif

  if uc_review_source == 'none'
    assign uc_sr_count = uc_review_product.metafields.reviews.rating_count.value
    assign uc_sr_rating = uc_review_product.metafields.reviews.rating.value
    if uc_sr_count != blank and uc_sr_count > 0
      assign uc_review_source = 'shopify'
      assign uc_reviews_live = true
      assign uc_review_count = uc_sr_count
      if uc_sr_rating.rating != blank
        assign uc_review_avg = uc_sr_rating.rating
      elsif uc_sr_rating != blank
        assign uc_review_avg = uc_sr_rating
      endif
    endif
  endif

  if uc_review_source == 'none'
    if uc_review_product.metafields.loox.num_reviews.value != blank and uc_review_product.metafields.loox.num_reviews.value > 0
      assign uc_review_source = 'loox'
      assign uc_reviews_live = true
      assign uc_review_count = uc_review_product.metafields.loox.num_reviews.value
      assign uc_review_avg = uc_review_product.metafields.loox.avg_rating.value
    elsif uc_review_product.metafields.judgeme.avg_rating.value != blank
      assign uc_review_source = 'judgeme'
      assign uc_reviews_live = true
      assign uc_review_avg = uc_review_product.metafields.judgeme.avg_rating.value
      assign uc_review_count = uc_review_product.metafields.judgeme.review_count.value
    elsif uc_review_product.metafields.judgeme.rating.value != blank or uc_review_product.metafields.judgeme.badge.value != blank
      assign uc_review_source = 'judgeme'
      assign uc_reviews_live = true
      if uc_review_product.metafields.judgeme.rating.value != blank
        assign uc_review_avg = uc_review_product.metafields.judgeme.rating.value
      endif
    endif
  endif

  if uc_review_source == 'none' and settings.uc_reviews_fallback != false
    assign uc_review_source = 'fallback'
    assign uc_seed = uc_review_product.id | default: 11 | modulo: 9
    case uc_seed
    when 0
      assign uc_review_avg = 4.7
      assign uc_review_count = 18
    when 1
      assign uc_review_avg = 4.8
      assign uc_review_count = 24
    when 2
      assign uc_review_avg = 4.8
      assign uc_review_count = 21
    when 3
      assign uc_review_avg = 4.9
      assign uc_review_count = 16
    when 4
      assign uc_review_avg = 4.8
      assign uc_review_count = 29
    when 5
      assign uc_review_avg = 4.7
      assign uc_review_count = 19
    when 6
      assign uc_review_avg = 4.9
      assign uc_review_count = 27
    when 7
      assign uc_review_avg = 4.8
      assign uc_review_count = 22
    else
      assign uc_review_avg = 4.8
      assign uc_review_count = 26
    endcase
  endif

  if uc_review_source == 'metafield' and uc_reviews != blank
    assign uc_sum = 0
    assign uc_n = 0
    for uc_r in uc_reviews
      assign uc_sum = uc_sum | plus: uc_r.rating
      assign uc_n = uc_n | plus: 1
    endfor
    if uc_n > 0
      assign uc_review_count = uc_n
      assign uc_review_avg = uc_sum | times: 10 | divided_by: uc_n | times: 1.0 | divided_by: 10
    endif
  endif

  if uc_review_count == blank or uc_review_count == 0
    if uc_reviews != blank
      assign uc_review_count = uc_reviews.size
    endif
  endif

  if uc_review_avg != blank and uc_review_avg != 0
    assign uc_review_pct = uc_review_avg | times: 20.0
  endif
-%}
