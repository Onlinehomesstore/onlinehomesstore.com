{%- comment -%}
  Renders a theme asset image by filename (e.g. ohs-hero-1.jpg).
  Params: file, alt, class, loading, sizes
{%- endcomment -%}
{%- if file != blank -%}
  <img
    class="{{ class }}"
    src="{{ file | asset_url }}"
    alt="{{ alt | default: shop.name | escape }}"
    width="1200"
    height="1200"
    loading="{{ loading | default: 'lazy' }}"
    decoding="async"
    {% if sizes != blank %}sizes="{{ sizes }}"{% endif %}
  >
{%- endif -%}
