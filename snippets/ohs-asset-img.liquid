{%- comment -%}
  Renders a theme asset image by filename (e.g. ohs-hero-1.jpg).
  Params: file, alt, class, loading, sizes, width, height
{%- endcomment -%}
{%- if file != blank -%}
  <img
    class="ohs-asset-img{% if class != blank %} {{ class }}{% endif %}"
    src="{{ file | asset_url }}"
    alt="{{ alt | default: shop.name | escape }}"
    width="{{ width | default: 1200 }}"
    height="{{ height | default: 900 }}"
    loading="{{ loading | default: 'lazy' }}"
    decoding="async"
    {% if sizes != blank %}sizes="{{ sizes }}"{% endif %}
  >
{%- endif -%}
