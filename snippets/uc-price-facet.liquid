{% comment %}
  Premium price range inputs for UC facets.
  Accepts: filter, id_prefix (optional, default Filter-)
{% endcomment %}
{%- liquid
  assign id_prefix = id_prefix | default: 'Filter-'
  assign gte_id = id_prefix | append: filter.label | escape | append: '-GTE'
  assign lte_id = id_prefix | append: filter.label | escape | append: '-LTE'
-%}

<div class="uf-price__row">
  <label class="uf-price__field" for="{{ gte_id }}">
    <span class="uf-price__label">{{ 'products.facets.from' | t }}</span>
    <span class="uf-price__currency">{{ cart.currency.symbol }}</span>
    <input
      class="uf-price__input"
      name="{{ filter.min_value.param_name }}"
      id="{{ gte_id }}"
      type="text"
      inputmode="decimal"
      placeholder="0"
      data-pattern="\d| |,|\."
      data-min="0"
      data-max="{{ filter.range_max | money_without_currency }}"
      {%- if filter.min_value.value -%}
        value="{{ filter.min_value.value | money_without_currency }}"
      {%- endif -%}
    >
  </label>
  <label class="uf-price__field" for="{{ lte_id }}">
    <span class="uf-price__label">{{ 'products.facets.to' | t }}</span>
    <span class="uf-price__currency">{{ cart.currency.symbol }}</span>
    <input
      class="uf-price__input"
      name="{{ filter.max_value.param_name }}"
      id="{{ lte_id }}"
      type="text"
      inputmode="decimal"
      placeholder="{{ filter.range_max | money_without_currency }}"
      data-pattern="\d| |,|\."
      data-min="0"
      data-max="{{ filter.range_max | money_without_currency }}"
      {%- if filter.max_value.value -%}
        value="{{ filter.max_value.value | money_without_currency }}"
      {%- endif -%}
    >
  </label>
</div>
