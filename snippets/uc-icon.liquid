{%- comment -%}
 ============================================================================
 UC ICON - shared Lucide icon library (single source of truth)
 ----------------------------------------------------------------------------
 Authentic Lucide icons (https://lucide.dev), inline SVG, no dependencies.
 Every section can render icons from here so the whole site stays consistent.

 Parameters:
 icon: {String} Icon name (required). See the case list below.
 size: {Number} Pixel size for width and height. Default 24.
 class: {String} Extra CSS class(es) on the <svg>.
 stroke: {Number} Stroke width. Default 1.75.
 label: {String} Accessible label. If provided the icon is exposed to
 screen readers; otherwise it is decorative (aria-hidden).

 Usage:
 {% render 'uc-icon', icon: 'droplet' %}
 {% render 'uc-icon', icon: 'heart', size: 18, class: 'my-class' %}
 {% render 'uc-icon', icon: 'truck', label: 'Free shipping' %}
 ============================================================================
{%- endcomment -%}

{%- liquid
 assign uc_icon = icon | default: 'check'
 assign uc_size = size | default: 24
 assign uc_class = class | default: ''
 assign uc_stroke = stroke | default: 1.75
-%}

<svg
 class="uc-icon uc-icon--{{ uc_icon }} {{ uc_class }}"
 xmlns="http://www.w3.org/2000/svg"
 width="{{ uc_size }}"
 height="{{ uc_size }}"
 viewBox="0 0 24 24"
 fill="none"
 stroke="currentColor"
 stroke-width="{{ uc_stroke }}"
 stroke-linecap="round"
 stroke-linejoin="round"
 {% if label != blank %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true" focusable="false"{% endif %}
>
