{%- comment -%}
 UC Star Rating - CSS-driven stars (avoids UTF-8 mojibake in Liquid files)
 Parameters:
 pct - fill percentage 0 - 100 (default: 100)
 class - CSS class(es), e.g. pt__stars, pc-card__stars
 label - optional aria-label; omit for decorative stars
{%- endcomment -%}
{%- liquid
 assign star_pct = pct | default: 100
 assign star_class = class | default: 'uc-stars'
-%}
<span
 class="{{ star_class }}"
 style="--uc-star-pct: {{ star_pct }}%; --pt-star-pct: {{ star_pct }}%; --pc-star-pct: {{ star_pct }}%; --pph-star-pct: {{ star_pct }}%; --pvr-star-pct: {{ star_pct }}%;"
 {%- if label != blank -%}
 aria-label="{{ label | escape }}"
 {%- else -%}
 aria-hidden="true"
 {%- endif -%}
></span>
