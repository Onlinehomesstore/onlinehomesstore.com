{%- liquid
  assign s = section_settings
-%}
<div class="pph__purchase-panel" data-pph-purchase-panel>
 {%- unless product.has_only_default_variant -%}
 <div class="pph__variants" data-pph-variants>
 {%- for option in product.options_with_values -%}
 {%- liquid
 assign option_idx = forloop.index0
 assign is_color = false
 assign opt_lc = option.name | downcase
 if opt_lc == 'color' or opt_lc == 'colour' or opt_lc == 'shade' or opt_lc == 'finish' or opt_lc == 'couleur'
 assign is_color = true
 endif
 -%}
 <div class="pph__option" data-pph-option="{{ option_idx }}">
 <div class="pph__option-label">
 <span class="pph__option-name">{{ option.name }}:</span>
 <span class="pph__option-selected" data-pph-selected="{{ option_idx }}">{{ option.selected_value }}</span>
 </div>
 {%- if is_color and s.variant_style != 'pills' -%}
 <div class="pph__variant-cards" role="group" aria-label="Select {{ option.name }}">
 {%- for value in option.values -%}
 {%- liquid
 assign is_selected = false
 if value == option.selected_value
 assign is_selected = true
 endif
 assign value_available = false
 assign swatch_image = nil
 for v in product.variants
 if v.options[option_idx] == value
 if v.available
 assign value_available = true
 endif
 if swatch_image == nil and v.featured_media
 assign swatch_image = v.featured_media.preview_image
 endif
 endif
 endfor
 -%}
 <button
 type="button"
 class="pph__variant-card{% if is_selected %} is-active{% endif %}{% unless value_available %} is-unavailable{% endunless %}"
 data-pph-pill="{{ option_idx }}"
 data-value="{{ value | escape }}"
 aria-pressed="{{ is_selected }}"
 aria-label="{{ option.name }}: {{ value }}"
 {% unless value_available %}disabled{% endunless %}
 >
 <span class="pph__variant-card__swatch">
 {%- if swatch_image -%}
 {{
 swatch_image
 | image_url: width: 240
 | image_tag: loading: 'lazy', class: 'pph__variant-card__img', alt: value, widths: '120, 180, 240'
 }}
 {%- else -%}
 <span class="pph__variant-card__fallback" data-swatch-name="{{ value | handleize }}" aria-hidden="true"></span>
 {%- endif -%}
 </span>
 <span class="pph__variant-card__label">{{ value }}</span>
 {%- unless value_available -%}
 <span class="pph__variant-card__badge">{{ s.soldout_text | default: 'Sold out' | escape }}</span>
 {%- endunless -%}
 </button>
 {%- endfor -%}
 </div>
 {%- else -%}
 <div class="pph__pills" role="group" aria-label="Select {{ option.name }}">
 {%- for value in option.values -%}
 {%- assign is_selected = false -%}
 {%- if value == option.selected_value -%}{%- assign is_selected = true -%}{%- endif -%}
 <button
 type="button"
 class="pph__pill{% if is_color %} pph__pill--color{% endif %}{% if is_selected %} is-active{% endif %}"
 data-pph-pill="{{ option_idx }}"
 data-value="{{ value | escape }}"
 aria-pressed="{{ is_selected }}"
 aria-label="{{ option.name }}: {{ value }}"
 {%- if is_color -%}
 style="--pill-color: {{ value | downcase | replace: ' ', '' }}"
 {%- endif -%}
 >{{ value }}</button>
 {%- endfor -%}
 </div>
 {%- endif -%}
 </div>
 {%- endfor -%}
 </div>
 {%- endunless -%}

 {%- form 'product', product, id: form_id, class: 'pph__form', novalidate: 'novalidate' -%}
 <input type="hidden" name="id" value="{{ cv.id }}" data-pph-variant-id>

 <div class="pph__form-row">
 <div class="pph__qty" data-pph-qty>
 <button type="button" class="pph__qty-btn" data-pph-minus aria-label="Decrease quantity">
 {%- render 'uc-icon', icon: 'minus', size: 14 -%}
 </button>
 <input
 type="number"
 name="quantity"
 value="1"
 min="1"
 class="pph__qty-input"
 aria-label="Quantity"
 data-pph-qty-val
 inputmode="numeric"
 pattern="[0-9]*"
 >
 <button type="button" class="pph__qty-btn" data-pph-plus aria-label="Increase quantity">
 {%- render 'uc-icon', icon: 'plus', size: 14 -%}
 </button>
 </div>

 <button
 type="submit"
 name="add"
 class="uc-btn uc-btn--premium uc-btn--block uc-btn--ripple pph__atc"
 data-pph-atc
 data-atc-text="{{ s.atc_text | default: 'Add to cart' | escape }}"
 {% unless cv.available %}disabled{% endunless %}
 >
 <span class="pph__atc-icon" aria-hidden="true">
 {%- render 'uc-icon', icon: 'shopping-cart', size: 18 -%}
 </span>
 <span class="pph__atc-text">
 {%- if cv.available -%}
 {{ s.atc_text | default: 'Add to cart' }}
 {%- else -%}
 {{ s.soldout_text | default: 'Sold out' }}
 {%- endif -%}
 </span>
 <span class="pph__atc-spinner" hidden aria-hidden="true">
 <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="32" stroke-linecap="round"/></svg>
 </span>
 </button>
 </div>

 {%- if s.show_buy_now -%}
 <button
 type="button"
 class="uc-btn uc-btn--premium uc-btn--block pph__buy-fast"
 data-pph-buy-now
 {% unless cv.available %}disabled{% endunless %}
 >
 <span class="pph__buy-fast-icon" aria-hidden="true">
 {%- render 'uc-icon', icon: 'zap', size: 18 -%}
 </span>
 <span class="pph__buy-fast-text">{{ s.buy_now_text | default: 'Buy Now' }}</span>
 </button>
 {%- endif -%}
 {%- if s.show_dynamic_checkout -%}
 <div class="pph__buynow pph__buynow--wallets">{{ form | payment_button }}</div>
 {%- endif -%}

 {%- endform -%}
</div>
