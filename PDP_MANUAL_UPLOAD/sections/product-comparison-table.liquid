{%- comment -%}
 ============================================================================
 PRODUCT COMPARISON TABLE
 ----
 Unified feature-matrix comparison. Three columns: Feature | Our Brand | Others.
 Visually distinct from `product-why-us.liquid` (which uses two separate cards).
 Here rows animate in sequentially when visible, giving a "reveal" effect.

 Reuses: uc-design-tokens.css, uc-components.css, uc-icon.liquid.
 Adds: product-comparison-table.css.
 JS: ~20-line inline IntersectionObserver (no extra file).
 CSS prefix: pct-
 ============================================================================
{%- endcomment -%}
{{ 'product-comparison-table.css' | asset_url | stylesheet_tag }}

{%- liquid
 assign s = section.settings
 assign uid = section.id
 assign row_blocks = section.blocks | where: 'type', 'comparison_row'
-%}

{%- assign uc_sec_scope = '#ComparisonTable-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #ComparisonTable-{{ uid }} {
 --pct-pad-top: {{ s.padding_top | default: 64 }}px;
 --pct-pad-bottom: {{ s.padding_bottom | default: 64 }}px;
 }
 {%- if s.accent_color != blank -%}
 #ComparisonTable-{{ uid }} { --pct-accent: {{ s.accent_color }}; }
 {%- endif -%}
 {%- if s.background_color != blank -%}
 #ComparisonTable-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="ComparisonTable-{{ uid }}"
 class="pct uc-sec color-{{ s.color_scheme }}"
 data-pct-section
>
 <div class="pct__inner uc-sec__container">

 {%- comment -%} Section header {%- endcomment -%}
 <header class="pct__header">
 {%- if s.eyebrow != blank -%}
 <p class="pct__eyebrow">{{ s.eyebrow | escape }}</p>
 {%- endif -%}
 {%- if s.heading != blank -%}
 <h2 class="pct__heading uc-sec__heading">{{ s.heading | escape }}</h2>
 {%- endif -%}
 {%- if s.subtitle != blank -%}
 <p class="pct__subtitle">{{ s.subtitle | escape }}</p>
 {%- endif -%}
 </header>

 {%- if row_blocks.size > 0 -%}
 {%- comment -%} Comparison table {%- endcomment -%}
 <div class="pct__table-wrap">
 <div class="pct__table" role="table" aria-label="Product comparison">

 {%- comment -%} Table head {%- endcomment -%}
 <div class="pct__thead" role="rowgroup">
 <div class="pct__tr pct__tr--head" role="row">
 <div class="pct__th pct__th--feature" role="columnheader">Feature</div>
 <div class="pct__th pct__th--ours" role="columnheader">
 {%- if s.our_logo != blank -%}
 {%- assign pct_logo_alt = s.our_brand_name | default: 'Our Brand' | escape -%}
 {{
 s.our_logo
 | image_url: width: 120
 | image_tag: loading: 'lazy', class: 'pct__th-logo', alt: pct_logo_alt, widths: '60, 90, 120'
 }}
 {%- endif -%}
 <span class="pct__th-name">{{ s.our_brand_name | default: 'Our Brand' | escape }}</span>
 <span class="pct__th-badge">
 {%- render 'uc-icon', icon: 'shield-check', size: 14 -%}
 Premium
 </span>
 </div>
 <div class="pct__th pct__th--others" role="columnheader">
 <span class="pct__th-name">{{ s.others_name | default: 'Others' | escape }}</span>
 </div>
 </div>
 </div>

 {%- comment -%} Table body {%- endcomment -%}
 <div class="pct__tbody" role="rowgroup" data-pct-rows>
 {%- for block in row_blocks -%}
 {%- assign even = forloop.index | modulo: 2 -%}
 <div
 class="pct__tr pct__tr--data{% if even == 0 %} pct__tr--alt{% endif %}"
 role="row"
 style="--pct-row: {{ forloop.index0 }}"
 {{ block.shopify_attributes }}
 >
 {%- comment -%} Feature name {%- endcomment -%}
 <div class="pct__td pct__td--feature" role="cell">
 {{ block.settings.feature | escape }}
 </div>

 {%- comment -%} Our brand value {%- endcomment -%}
 <div class="pct__td pct__td--ours" role="cell">
 {%- if block.settings.our_value != blank -%}
 <span class="pct__val pct__val--text">{{ block.settings.our_value | escape }}</span>
 {%- elsif block.settings.our_check -%}
 <span class="pct__val pct__val--check" aria-label="Yes">
 {%- render 'uc-icon', icon: 'check-circle-2', size: 20 -%}
 </span>
 {%- else -%}
 <span class="pct__val pct__val--cross" aria-label="No">
 {%- render 'uc-icon', icon: 'x-circle', size: 20 -%}
 </span>
 {%- endif -%}
 </div>

 {%- comment -%} Others value {%- endcomment -%}
 <div class="pct__td pct__td--others" role="cell">
 {%- if block.settings.others_value != blank -%}
 <span class="pct__val pct__val--text pct__val--muted">{{ block.settings.others_value | escape }}</span>
 {%- elsif block.settings.others_check -%}
 <span class="pct__val pct__val--check pct__val--muted" aria-label="Yes">
 {%- render 'uc-icon', icon: 'check-circle-2', size: 20 -%}
 </span>
 {%- else -%}
 <span class="pct__val pct__val--cross" aria-label="No">
 {%- render 'uc-icon', icon: 'x-circle', size: 20 -%}
 </span>
 {%- endif -%}
 </div>
 </div>
 {%- endfor -%}
 </div>
 </div>
 </div>
 {%- endif -%}

 {%- if s.cta_label != blank -%}
 <div class="pct__cta">
 <a href="{{ s.cta_link | default: '#' }}" class="uc-btn uc-btn--premium">
 {{ s.cta_label | escape }}
 </a>
 </div>
 {%- endif -%}

 </div>
</section>

<script>
 (function () {
 var section = document.getElementById('ComparisonTable-{{ uid }}');
 var rows = section && section.querySelector('[data-pct-rows]');
 if (!rows || !window.IntersectionObserver) {
 if (rows) rows.querySelectorAll('.pct__tr--data').forEach(function (r) { r.classList.add('is-in'); });
 return;
 }
 var io = new IntersectionObserver(function (entries, obs) {
 entries.forEach(function (e) {
 if (!e.isIntersecting) return;
 obs.unobserve(e.target);
 e.target.querySelectorAll('.pct__tr--data').forEach(function (r, i) {
 setTimeout(function () { r.classList.add('is-in'); }, i * 55);
 });
 });
 }, { threshold: 0.1 });
 io.observe(rows);
 })();
</script>

{% schema %}
{
 "name": "UC Comparison table",
 "tag": "section",
 "class": "section section-comparison-table",
 "max_blocks": 20,
 "settings": [
 { "type": "header", "content": "Section header" },
 { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "The difference is clear" },
 { "type": "text", "id": "heading", "label": "Heading", "default": "Why we are better" },
 { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Side-by-side comparison so you can make an informed decision." },

 { "type": "header", "content": "Columns" },
 { "type": "paragraph", "content": "Recommended: 240 x 80 px PNG/SVG under 50 KB." },
 { "type": "image_picker", "id": "our_logo", "label": "Our brand logo (240x80)" },
 { "type": "text", "id": "our_brand_name", "label": "Our brand name", "default": "Our Brand" },
 { "type": "text", "id": "others_name", "label": "Competitors column label", "default": "Others" },

 { "type": "header", "content": "CTA" },
 { "type": "text", "id": "cta_label", "label": "CTA button label" },
 { "type": "url", "id": "cta_link", "label": "CTA link" },

 { "type": "header", "content": "Layout" },
 { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
 { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },

 { "type": "header", "content": "UC - Responsive spacing" },
 { "type": "range", "id": "pad_top_lg", "label": "Top padding - laptop (990px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
 { "type": "range", "id": "pad_top_xxl", "label": "Top padding - large desktop (1440px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
 { "type": "range", "id": "container_max_lg", "label": "Container max width - laptop+", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
 { "type": "select", "id": "container_mode", "label": "Container", "default": "boxed", "options": [{"value":"boxed","label":"Boxed"},{"value":"full","label":"Full width"}] },
 { "type": "header", "content": "UC - Typography overrides" },
 { "type": "checkbox", "id": "use_custom_section_styles", "label": "Override global typography", "default": false },
 { "type": "range", "id": "h_size_xs", "label": "Heading size - mobile", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 28 },
 { "type": "range", "id": "h_size_lg", "label": "Heading size - laptop+", "min": 24, "max": 88, "step": 2, "unit": "px", "default": 40 },
 { "type": "range", "id": "h_size_xxl", "label": "Heading size - large desktop", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 44 },
 { "type": "header", "content": "UC - Section colors" },
 { "type": "checkbox", "id": "use_global_colors", "label": "Use global brand colors", "default": true },

 { "type": "header", "content": "Colours" },
 { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
 { "type": "color", "id": "background_color", "label": "Background override" },
 { "type": "color", "id": "accent_color", "label": "Accent colour override" }
 ],
 "blocks": [
 {
 "type": "comparison_row",
 "name": "Comparison Row",
 "settings": [
 { "type": "text", "id": "feature", "label": "Feature name", "default": "Grey Hair Coverage" },
 { "type": "text", "id": "our_value", "label": "Our value (text  -  leave empty for check/cross)" },
 { "type": "checkbox", "id": "our_check", "label": "Our brand has this feature", "default": true },
 { "type": "text", "id": "others_value", "label": "Others value (text  -  leave empty for check/cross)" },
 { "type": "checkbox", "id": "others_check", "label": "Others have this feature", "default": false }
 ]
 }
 ],
 "presets": [
 {
 "name": "Comparison Table",
 "blocks": [
 { "type": "comparison_row", "settings": { "feature": "Grey Hair Coverage", "our_value": "100%", "our_check": true, "others_value": "Partial", "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "Longevity", "our_value": "Up to 6 weeks", "our_check": true, "others_value": "2 - 3 weeks", "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "Natural Finish", "our_check": true, "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "Hair Friendly Formula", "our_check": true, "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "No Ammonia", "our_check": true, "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "Easy Application", "our_check": true, "others_check": true } },
 { "type": "comparison_row", "settings": { "feature": "Mess Free", "our_check": true, "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "Premium Ingredients", "our_check": true, "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "Money Back Guarantee", "our_value": "30 Days", "our_check": true, "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "Customer Support", "our_value": "24 / 7", "our_check": true, "others_check": false } },
 { "type": "comparison_row", "settings": { "feature": "Price / Value", "our_value": "Excellent", "our_check": true, "others_value": "Poor", "others_check": false } }
 ]
 },
 {
 "name": "Content - Ingredient / feature comparison",
 "settings": {
 "heading": "How UNIK Care compares"
 }
 }
 ]
}
