{%- comment -%}
 ============================================================================
 PRODUCT HOW IT WORKS
 ----
 Premium numbered timeline section.
 Desktop: horizontal timeline with animated connecting line.
 Tablet (<= 989px): 2-column grid.
 Mobile (<= 749px): vertical timeline with left-side line.

 Reuses: uc-design-tokens.css, uc-components.css, uc-icon.liquid.
 Adds: product-how-it-works.css, product-how-it-works.js (40 lines).
 CSS prefix: hiw-
 ============================================================================
{%- endcomment -%}
{{ 'product-how-it-works.css' | asset_url | stylesheet_tag }}

{%- liquid
 assign s = section.settings
 assign uid = section.id
 assign step_blocks = section.blocks | where: 'type', 'step'
-%}

{%- assign uc_sec_scope = '#HowItWorks-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #HowItWorks-{{ uid }} {
 --hiw-pad-top: {{ s.padding_top | default: 72 }}px;
 --hiw-pad-bottom: {{ s.padding_bottom | default: 72 }}px;
 --hiw-step-count: {{ step_blocks.size | default: 5 }};
 }
 {%- if s.accent_color != blank -%}
 #HowItWorks-{{ uid }} { --hiw-accent: {{ s.accent_color }}; }
 {%- endif -%}
 {%- if s.background_color != blank -%}
 #HowItWorks-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="HowItWorks-{{ uid }}"
 class="hiw uc-sec color-{{ s.color_scheme }}"
 data-hiw-section
>
 <div class="hiw__inner uc-sec__container">

 {%- comment -%} Section header {%- endcomment -%}
 {% render 'uc-section-header',
 eyebrow: s.eyebrow,
 heading: s.heading,
 description: s.subtitle,
 header_class: 'hiw__header'
 %}

 {%- if step_blocks.size > 0 -%}
 {%- comment -%} Timeline wrapper {%- endcomment -%}
 <div class="hiw__timeline" data-hiw-timeline aria-label="{{ s.heading | escape }} steps">

 {%- comment -%} Animated connecting line (desktop: horizontal, mobile: vertical) {%- endcomment -%}
 <div class="hiw__line-track" aria-hidden="true">
 <div class="hiw__line"></div>
 <div class="hiw__line-progress"></div>
 </div>

 {%- comment -%} Steps {%- endcomment -%}
 {%- for block in step_blocks -%}
 {%- assign step_num = forloop.index -%}
 {%- assign delay_ms = forloop.index0 | times: 100 -%}
 <article
 class="hiw__step"
 data-hiw-step="{{ forloop.index0 }}"
 style="--hiw-delay: {{ delay_ms }}ms"
 {{ block.shopify_attributes }}
 >
 <div class="hiw__step-head">
 <div class="hiw__step-circle" aria-label="Step {{ step_num }}">
 <span class="hiw__step-num">{{ step_num | prepend: '0' | slice: -2, 2 }}</span>
 </div>
 {%- comment -%} Connector dot {%- endcomment -%}
 {%- unless forloop.last -%}
 <div class="hiw__step-dot" aria-hidden="true"></div>
 {%- endunless -%}
 </div>

 {%- if block.settings.icon != blank -%}
 <div class="hiw__step-icon" aria-hidden="true">
 {%- render 'uc-icon', icon: block.settings.icon, size: 22 -%}
 </div>
 {%- elsif block.settings.illustration != blank -%}
 <div class="hiw__step-illus">
 {{
 block.settings.illustration
 | image_url: width: 120
 | image_tag: loading: 'lazy', alt: '', widths: '60, 90, 120'
 }}
 </div>
 {%- endif -%}

 <div class="hiw__step-body">
 {%- if block.settings.title != blank -%}
 <h3 class="hiw__step-title">{{ block.settings.title | escape }}</h3>
 {%- endif -%}
 {%- if block.settings.description != blank -%}
 <p class="hiw__step-desc">{{ block.settings.description | escape }}</p>
 {%- endif -%}
 {%- if block.settings.duration != blank -%}
 <span class="hiw__step-duration">
 {%- render 'uc-icon', icon: 'clock', size: 13 -%}
 {{ block.settings.duration | escape }}
 </span>
 {%- endif -%}
 {%- if block.settings.tip != blank -%}
 <div class="hiw__step-tip">
 {%- render 'uc-icon', icon: 'lightbulb', size: 13 -%}
 {{ block.settings.tip | escape }}
 </div>
 {%- endif -%}
 </div>
 </article>
 {%- endfor -%}
 </div>

 <div class="hiw__focus" data-hiw-focus aria-live="polite">
 {%- for block in step_blocks -%}
 <div
 class="hiw__focus-panel{% if forloop.first %} is-active{% endif %}"
 data-hiw-focus-panel="{{ forloop.index0 }}"
 >
 {%- if block.settings.title != blank -%}
 <p class="hiw__focus-step"><span>Step</span><strong>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</strong></p>
 <h3 class="hiw__focus-title">{{ block.settings.title | escape }}</h3>
 {%- endif -%}
 {%- if block.settings.description != blank -%}
 <p class="hiw__focus-desc">{{ block.settings.description | escape }}</p>
 {%- endif -%}
 {%- if block.settings.tip != blank -%}
 <p class="hiw__focus-tip">{{ block.settings.tip | escape }}</p>
 {%- endif -%}
 </div>
 {%- endfor -%}
 </div>
 {%- endif -%}

 </div>
</section>

<script src="{{ 'product-how-it-works.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
 "name": "UC How it works",
 "tag": "section",
 "class": "section section-how-it-works",
 "max_blocks": 8,
 "settings": [
 { "type": "header", "content": "Section header" },
 { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Simple process" },
 { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
 { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "From first application to visible results - it's that simple." },

 { "type": "header", "content": "Layout" },
 { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
 { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },

 { "type": "header", "content": "UC - Responsive spacing" },
 { "type": "range", "id": "pad_top_lg", "label": "Top padding - laptop (990px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
 { "type": "range", "id": "pad_top_xxl", "label": "Top padding - large desktop (1440px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
 { "type": "range", "id": "container_max_lg", "label": "Container max width - laptop+", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
 { "type": "select", "id": "container_mode", "label": "Container", "default": "boxed", "options": [{"value":"boxed","label":"Boxed"},{"value":"full","label":"Full width"}] },
 { "type": "header", "content": "UC - Typography overrides" },
 { "type": "checkbox", "id": "use_custom_section_styles", "label": "Override global typography", "default": false },
 { "type": "range", "id": "h_size_xs", "label": "Heading size - mobile", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 28 },
 { "type": "range", "id": "h_size_lg", "label": "Heading size - laptop+", "min": 24, "max": 88, "step": 2, "unit": "px", "default": 40 },
 { "type": "range", "id": "h_size_xxl", "label": "Heading size - large desktop", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 44 },
 { "type": "header", "content": "UC - Section colors" },
 { "type": "checkbox", "id": "use_global_colors", "label": "Use global brand colors", "default": true },

 { "type": "header", "content": "Colours" },
 { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
 { "type": "color", "id": "background_color", "label": "Background override" },
 { "type": "color", "id": "accent_color", "label": "Accent colour override" }
 ],
 "blocks": [
 {
 "type": "step",
 "name": "Step",
 "settings": [
 { "type": "text", "id": "icon", "label": "Lucide icon name (e.g. droplets, hand, timer)", "default": "droplets" },
 { "type": "paragraph", "content": "Recommended: 1200 x 1200 px square. WebP/JPG under 250 KB." },
 { "type": "image_picker", "id": "illustration", "label": "Illustration (1200x1200)" },
 { "type": "text", "id": "title", "label": "Step title", "default": "Apply Product" },
 { "type": "text", "id": "description", "label": "Description", "default": "Work a small amount through dry or damp hair." },
 { "type": "text", "id": "duration", "label": "Duration (optional)", "default": "2 minutes" },
 { "type": "text", "id": "tip", "label": "Pro tip (optional)" }
 ]
 }
 ],
 "presets": [
 {
 "name": "How It Works",
 "blocks": [
 { "type": "step", "settings": { "icon": "droplets", "title": "Apply Product", "description": "Work a small amount evenly through dry or damp hair from roots to tips.", "duration": "2 min" } },
 { "type": "step", "settings": { "icon": "hand", "title": "Massage In", "description": "Gently massage for 60 seconds to ensure even coverage.", "duration": "1 min", "tip": "Use fingertips, not nails" } },
 { "type": "step", "settings": { "icon": "timer", "title": "Leave for 15 Minutes", "description": "Allow the formula to work. Cover with a warm towel for deeper penetration.", "duration": "15 min" } },
 { "type": "step", "settings": { "icon": "waves", "title": "Rinse Thoroughly", "description": "Rinse with cool water until completely clear.", "duration": "2 min" } },
 { "type": "step", "settings": { "icon": "sparkles", "title": "Reveal Results", "description": "Style as usual. Noticeable improvement from first use.", "tip": "Best results with 3+ applications" } }
 ]
 },
 {
 "name": "Content - How it works (steps)",
 "settings": {
 "eyebrow": "Simple process",
 "heading": "How it works"
 }
 }
 ]
}
{% endschema %}
