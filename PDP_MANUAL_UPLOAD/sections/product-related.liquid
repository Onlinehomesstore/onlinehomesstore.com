{%- comment -%}
 ============================================================================
 PRODUCT RELATED  -  Section 11
 ----
 Uses Shopify Product Recommendations API.
 When `recommendations.performed` is false (normal page load), the section
 renders a loading placeholder. product-related.js fetches the section HTML
 from `/recommendations/products?section_id=...&product_id=...` and replaces
 the inner container  -  at which point `recommendations.performed` is true
 and the card grid is server-rendered.
 Fallback: manual product blocks if merchant adds them.

 Reuses: uc-design-tokens.css, uc-components.css, uc-product-card.liquid,
 uc-product-card.css, uc-product-card.js.
 Adds: product-related.css, product-related.js.
 CSS prefix: prel-
 ============================================================================
{%- endcomment -%}
{{ 'uc-product-card.css' | asset_url | stylesheet_tag }}
{{ 'product-related.css' | asset_url | stylesheet_tag }}

{%- liquid
 assign s = section.settings
 assign uid = section.id
 assign manual_blocks = section.blocks | where: 'type', 'product'
-%}

{%- assign uc_sec_scope = '#ProductRelated-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #ProductRelated-{{ uid }} {
 --prel-pad-top: {{ s.padding_top | default: 72 }}px;
 --prel-pad-bottom: {{ s.padding_bottom | default: 72 }}px;
 --pc-card-radius: {{ s.card_radius | default: 18 }}px;
 }
 {%- if s.background_color != blank -%}
 #ProductRelated-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="ProductRelated-{{ uid }}"
 class="prel uc-sec color-{{ s.color_scheme }}"
 data-prel-section="{{ uid }}"
 data-prel-product-id="{{ product.id }}"
 data-prel-limit="{{ s.products_to_show | default: 4 }}"
 data-prel-intent="{{ s.recommendation_intent | default: 'related' }}"
>
 <div class="prel__inner uc-sec__container" data-prel-inner>

 {%- comment -%} Header (always visible) {%- endcomment -%}
 {% render 'uc-section-header',
 eyebrow: s.eyebrow,
 heading: s.heading,
 description: s.subtitle,
 header_class: 'prel__header'
 %}

 {%- if recommendations.performed -%}
 {%- comment -%} Rendered via recommendations API  -  products available {%- endcomment -%}
 {%- if recommendations.products_count > 0 -%}
 <div class="prel__grid">
 {%- for rec in recommendations.products -%}
 {%- render 'uc-product-card',
 product: rec,
 image_ratio: s.image_ratio,
 show_rating: s.show_rating,
 show_quick_add: s.show_quick_add,
 show_savings: s.show_savings,
 show_vendor: s.show_vendor,
 lazy: true,
 section_id: uid,
 card_index: forloop.index
 -%}
 {%- endfor -%}
 </div>
 {%- else -%}
 {%- comment -%} No recommendations  -  try manual fallback {%- endcomment -%}
 {%- if manual_blocks.size > 0 -%}
 <div class="prel__grid">
 {%- for block in manual_blocks -%}
 {%- if block.settings.product != blank -%}
 {%- render 'uc-product-card',
 product: block.settings.product,
 image_ratio: s.image_ratio,
 show_rating: s.show_rating,
 show_quick_add: s.show_quick_add,
 show_savings: s.show_savings,
 lazy: true,
 section_id: uid,
 card_index: forloop.index,
 badge_type: block.settings.badge_type,
 badge_label: block.settings.badge_label
 -%}
 {%- endif -%}
 {%- endfor -%}
 </div>
 {%- endif -%}
 {%- endif -%}

 {%- elsif manual_blocks.size > 0 -%}
 {%- comment -%} Not fetched yet  -  show manual blocks as initial state {%- endcomment -%}
 <div class="prel__grid">
 {%- for block in manual_blocks -%}
 {%- if block.settings.product != blank -%}
 {%- render 'uc-product-card',
 product: block.settings.product,
 image_ratio: s.image_ratio,
 show_rating: s.show_rating,
 show_quick_add: s.show_quick_add,
 show_savings: s.show_savings,
 lazy: true,
 section_id: uid,
 card_index: forloop.index,
 badge_type: block.settings.badge_type,
 badge_label: block.settings.badge_label
 -%}
 {%- endif -%}
 {%- endfor -%}
 </div>

 {%- else -%}
 {%- comment -%} Loading placeholder (JS will replace this) {%- endcomment -%}
 <div class="prel__skeleton" data-prel-skeleton aria-hidden="true">
 {%- for i in (1..4) -%}
 <div class="prel__skeleton-card">
 <div class="prel__skeleton-img"></div>
 <div class="prel__skeleton-line"></div>
 <div class="prel__skeleton-line prel__skeleton-line--short"></div>
 </div>
 {%- endfor -%}
 </div>
 {%- endif -%}

 </div>
</section>

<script src="{{ 'uc-product-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-related.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
 "name": "Related Products",
 "tag": "section",
 "class": "section section-product-related",
 "max_blocks": 12,
 "settings": [
 { "type": "header", "content": "Section header" },
 { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Explore more" },
 { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
 { "type": "text", "id": "subtitle", "label": "Subtitle" },

 { "type": "header", "content": "Recommendations" },
 { "type": "range", "id": "products_to_show", "label": "Number of products", "min": 2, "max": 8, "step": 2, "default": 4 },
 { "type": "select", "id": "recommendation_intent", "label": "Recommendation type", "options": [{"value": "related", "label": "Related products"}, {"value": "complementary", "label": "Complementary products"}], "default": "related" },

 { "type": "header", "content": "Card options" },
 { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [{"value": "portrait", "label": "Portrait (3:4)"}, {"value": "square", "label": "Square (1:1)"}, {"value": "landscape", "label": "Landscape (4:3)"}], "default": "portrait" },
 { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
 { "type": "checkbox", "id": "show_quick_add", "label": "Show Quick Add button", "default": true },
 { "type": "checkbox", "id": "show_savings", "label": "Show savings badge", "default": true },
 { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
 { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },

 { "type": "header", "content": "Layout" },
 { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
 { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },

 { "type": "header", "content": "UC - Responsive spacing" },
 { "type": "range", "id": "pad_top_lg", "label": "Top padding - laptop (990px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
 { "type": "range", "id": "pad_top_xxl", "label": "Top padding - large desktop (1440px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
 { "type": "range", "id": "container_max_lg", "label": "Container max width - laptop+", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
 { "type": "select", "id": "container_mode", "label": "Container", "default": "boxed", "options": [{"value":"boxed","label":"Boxed"},{"value":"full","label":"Full width"}] },
 { "type": "header", "content": "UC - Typography overrides" },
 { "type": "checkbox", "id": "use_custom_section_styles", "label": "Override global typography", "default": false },
 { "type": "range", "id": "h_size_xs", "label": "Heading size - mobile", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 28 },
 { "type": "range", "id": "h_size_lg", "label": "Heading size - laptop+", "min": 24, "max": 88, "step": 2, "unit": "px", "default": 40 },
 { "type": "range", "id": "h_size_xxl", "label": "Heading size - large desktop", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 44 },
 { "type": "header", "content": "UC - Section colors" },
 { "type": "checkbox", "id": "use_global_colors", "label": "Use global brand colors", "default": true },

 { "type": "header", "content": "Colours" },
 { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
 { "type": "color", "id": "background_color", "label": "Background override" }
 ],
 "blocks": [
 {
 "type": "product",
 "name": "Manual product (fallback)",
 "settings": [
 { "type": "product", "id": "product", "label": "Product" },
 { "type": "select", "id": "badge_type", "label": "Badge type", "options": [{"value": "auto", "label": "Auto"}, {"value": "sale", "label": "Sale"}, {"value": "bestseller", "label": "Best Seller"}, {"value": "new", "label": "New"}], "default": "auto" },
 { "type": "text", "id": "badge_label", "label": "Custom badge label" }
 ]
 }
 ],
 "enabled_on": { "templates": ["product"] },
 "presets": [{ "name": "Related Products" }]
}
{% endschema %}
