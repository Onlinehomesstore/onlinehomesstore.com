{%- comment -%}
 UC Brand Timeline - journey / process milestones for story and B2B pages.
 CSS prefix: ubt-
{%- endcomment -%}
{{ 'uc-brand-timeline.css' | asset_url | stylesheet_tag }}
<script src="{{ 'uc-brand-timeline.js' | asset_url }}" defer="defer"></script>

{%- liquid
 assign s = section.settings
 assign uid = section.id
 assign milestones = section.blocks | where: 'type', 'milestone'
-%}

{%- assign uc_sec_scope = '#UcBrandTimeline-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #UcBrandTimeline-{{ uid }} {
 {%- if s.accent_color != blank -%}--ubt-accent: {{ s.accent_color }};{%- endif -%}
 }
 {%- if s.background_color != blank -%}
 #UcBrandTimeline-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="UcBrandTimeline-{{ uid }}"
 class="ubt uc-sec color-{{ s.color_scheme }}"
 data-ubt-section
>
 <div class="uc-sec__container">
 {% render 'uc-subpage-section-head',
 eyebrow: s.eyebrow,
 heading: s.heading,
 description: s.subtitle,
 align: 'center',
 header_class: 'ubt__header',
 reveal: true
 %}

 {%- if milestones.size > 0 -%}
 <div class="ubt__track">
 <div class="ubt__line" aria-hidden="true">
 <div class="ubt__line-fill"></div>
 </div>
 <div class="ubt__items">
 {%- for block in milestones -%}
 <article class="ubt__item" data-uc-reveal style="--ucs-delay: {{ forloop.index0 | times: 70 }}ms" {{ block.shopify_attributes }}>
 <span class="ubt__dot" aria-hidden="true"></span>
 <div class="ubt__meta">
 {%- if block.settings.year != blank -%}
 <p class="ubt__year">{{ block.settings.year | escape }}</p>
 {%- endif -%}
 </div>
 <div class="ubt__card">
 {%- if block.settings.title != blank -%}
 <h3 class="ubt__title">{{ block.settings.title | escape }}</h3>
 {%- endif -%}
 {%- if block.settings.description != blank -%}
 <p class="ubt__desc">{{ block.settings.description | escape }}</p>
 {%- endif -%}
 {%- if block.settings.image != blank -%}
 <div class="ubt__thumb">
 {%- assign ubt_img_alt = block.settings.image_alt | default: block.settings.title | escape -%}
 {{
 block.settings.image
 | image_url: width: 800
 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 400px, 92vw', alt: ubt_img_alt
 }}
 </div>
 {%- endif -%}
 </div>
 </article>
 {%- endfor -%}
 </div>
 </div>
 {%- endif -%}
 </div>
</section>

{% schema %}
{
 "name": "UC Brand timeline",
 "tag": "section",
 "class": "section section-uc-brand-timeline",
 "disabled_on": { "groups": ["header", "footer"] },
 "max_blocks": 16,
 "settings": [
 { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our journey" },
 { "type": "text", "id": "heading", "label": "Heading", "default": "Built on trust, perfected over time" },
 { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Key milestones that shaped the UNIK Care standard." },
 { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
 { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
 { "type": "header", "content": "UC - Responsive spacing" },
 { "type": "range", "id": "pad_top_lg", "label": "Top padding - laptop+", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
 { "type": "range", "id": "container_max_lg", "label": "Container max width - laptop+", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 960 },
 { "type": "checkbox", "id": "use_global_colors", "label": "Use global brand colors", "default": true },
 { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
 { "type": "color", "id": "background_color", "label": "Background override" },
 { "type": "color", "id": "accent_color", "label": "Accent / timeline colour" }
 ],
 "blocks": [
 {
 "type": "milestone",
 "name": "Milestone",
 "settings": [
 { "type": "text", "id": "year", "label": "Year or label", "default": "2019" },
 { "type": "text", "id": "title", "label": "Title", "default": "The beginning" },
 { "type": "textarea", "id": "description", "label": "Description", "default": "UNIK Care launches with a focus on gentle, salon-grade hair colour." },
 { "type": "paragraph", "content": "Recommended: 800 x 800 px square. WebP/JPG under 200 KB." },
 { "type": "image_picker", "id": "image", "label": "Image (800x800)" },
 { "type": "text", "id": "image_alt", "label": "Image alt text" }
 ]
 }
 ],
 "presets": [
 {
 "name": "UC Brand timeline",
 "blocks": [
 { "type": "milestone", "settings": { "year": "2019", "title": "Founded on craftsmanship", "description": "Our founders set out to make premium hair colour accessible without compromise." } },
 { "type": "milestone", "settings": { "year": "2021", "title": "100,000 customers", "description": "A growing community trusted UNIK Care for natural-looking results at home." } },
 { "type": "milestone", "settings": { "year": "2024", "title": "Next-generation formulas", "description": "Expanded ranges with botanical extracts and dermatologist-tested care." } }
 ]
 },
 {
 "name": "About - Brand journey timeline",
 "settings": {
 "eyebrow": "Our journey",
 "heading": "Milestones that matter"
 }
 },
 {
 "name": "B2B - Partner process timeline",
 "settings": {
 "eyebrow": "Process",
 "heading": "From application to partnership"
 }
 }
 ]
}
{% endschema %}
