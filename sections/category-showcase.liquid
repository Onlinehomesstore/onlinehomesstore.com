{%- comment -%}
 ============================================================================
 CATEGORY COLLECTION SHOWCASE
 ----------------------------------------------------------------------------
 Premium, luxury collection showcase for Online Store 2.0 (Dawn compatible).

 - Inherits the theme's typography, buttons, radii and color schemes via the
 native Dawn CSS custom properties, so it matches the rest of the store.
 - Desktop / laptop grid, tablet 2-up, mobile elegant swipe slider.
 - Zero external libraries. Vanilla JS in a <category-showcase> custom element.
 - Fully editable from the theme editor (section + per-card block settings).

 Paste this file into /sections and add the section from the theme editor.
 ============================================================================
{%- endcomment -%}
{%- liquid
 assign s = section.settings

 assign cols_desktop = s.columns_desktop | default: 4
 assign cols_tablet = s.columns_tablet | default: 2
 assign cols_mobile = s.columns_mobile | default: 1

 assign pad_top = s.padding_top | default: 52
 assign pad_bottom = s.padding_bottom | default: 52

 assign uid = section.id
-%}

{%- assign uc_sec_scope = '#CategoryShowcase-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- comment -%} -------- Per-section scoped variables (kept tiny, no duplication) -------- {%- endcomment -%}
<style>
 #CategoryShowcase-{{ uid }} {
 --cs-cols-desktop: {{ cols_desktop }};
 --cs-cols-tablet: {{ cols_tablet }};
 --cs-cols-mobile: {{ cols_mobile }};
 --cs-gap: {{ s.card_gap | default: 24 }}px;
 --cs-card-radius: {{ s.card_radius | default: 18 }}px;
 --cs-card-shadow: {{ s.card_shadow | default: 18 }};
 --cs-overlay: {{ s.overlay_strength | default: 45 | divided_by: 100.0 }};
 --cs-ratio: {{ s.image_ratio | default: 125 | divided_by: 100.0 }};
 --cs-object-fit: {{ s.image_object_fit | default: 'cover' }};
 --cs-pad-top: {{ pad_top }}px;
 --cs-pad-bottom: {{ pad_bottom }}px;
 --cs-container-max: {% if s.full_width %}none{% else %}{{ s.container_width | default: 1200 }}px{% endif %};
 }
 {%- if s.background_gradient != blank -%}
 #CategoryShowcase-{{ uid }} { background: {{ s.background_gradient }}; }
 {%- elsif s.background_color != blank -%}
 #CategoryShowcase-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
 {%- if s.text_color != blank -%}
 #CategoryShowcase-{{ uid }} .category-showcase__inner { color: {{ s.text_color }}; }
 {%- endif -%}
</style>

<category-showcase
 id="CategoryShowcase-{{ uid }}"
 class="category-showcase color-{{ s.color_scheme }} {% if s.background_gradient == blank and s.background_color == blank %}gradient{% endif %}"
 data-slider="{{ s.enable_slider }}"
 data-hover="{{ s.enable_hover }}"
 data-animate="{{ s.enable_animation }}"
 data-zoom="{{ s.enable_image_zoom }}"
 data-autoplay="{{ s.autoplay }}"
 data-autoplay-speed="{{ s.autoplay_speed | default: 5 | times: 1000 }}"
 data-loop="{{ s.slider_loop }}"
>
 <div class="category-showcase__inner"{% if s.text_color != blank or s.text_color_mobile != blank %} data-uc-theme-text style="{% if s.text_color != blank %}--uc-theme-text: {{ s.text_color }}; color: {{ s.text_color }};{% endif %}{% if s.text_color_mobile != blank %}--uc-theme-text-mobile: {{ s.text_color_mobile }};{% endif %}"{% endif %}>

 {%- capture cs_header_arrows -%}
 {%- if s.enable_slider and s.show_arrows -%}
 <div class="category-showcase__arrows" data-cs-arrows hidden>
 <button class="category-showcase__arrow" type="button" data-cs-prev aria-label="Previous">
 {% render 'uc-icon', icon: 'chevron-left', size: 18 %}
 </button>
 <button class="category-showcase__arrow" type="button" data-cs-next aria-label="Next">
 {% render 'uc-icon', icon: 'chevron-right', size: 18 %}
 </button>
 </div>
 {%- endif -%}
 {%- endcapture -%}
 {%- comment -%} ----------------------------- SECTION HEADER ----------------------------- {%- endcomment -%}
 {% render 'uc-section-header',
 subheading: s.subheading,
 heading: s.heading,
 description: s.description,
 button_label: s.button_label,
 button_link: s.button_link,
 reveal: s.enable_animation,
 actions_html: cs_header_arrows
 %}

 {%- comment -%} ------------------------------- CARD GRID -------------------------------- {%- endcomment -%}
 {%- if section.blocks.size > 0 -%}
 <ul class="category-showcase__grid"
 data-cs-track
 role="list"
 {% unless s.enable_slider %}data-uc-mobile-scroll{% endunless %}
 {% if s.enable_slider %}tabindex="0" aria-label="{{ s.heading | default: 'Collections' | escape }}"{% endif %}>
 {%- for block in section.blocks -%}
 {%- liquid
 assign col = block.settings.collection
 if col == blank and block.settings.button_link != blank
 assign _cs_link = block.settings.button_link | split: '?' | first
 if _cs_link contains '/collections/'
 assign _cs_handle = _cs_link | split: '/collections/' | last | split: '/' | first
 if _cs_handle != blank
 assign col = collections[_cs_handle]
 endif
 endif
 endif

 assign card_image = block.settings.image
 if card_image == blank and col != blank
 assign card_image = col.featured_image
 if card_image == blank and col.products.first != blank
 assign card_image = col.products.first.featured_image
 endif
 endif

 assign card_title = block.settings.heading
 if card_title == blank
 assign card_title = col.title
 endif

 assign card_desc = block.settings.description
 if card_desc == blank and col.description != blank
 assign card_desc = col.description | strip_html | truncatewords: 18
 endif

 assign card_url = block.settings.button_link
 if card_url == blank and col != blank
 assign card_url = col.url
 elsif card_url == blank and block.settings.collection != blank
 assign card_url = routes.collections_url | append: '/' | append: block.settings.collection
 endif

 assign hide_classes = ''
 if block.settings.hide_desktop
 assign hide_classes = hide_classes | append: ' cs-hide-desktop'
 endif
 if block.settings.hide_mobile
 assign hide_classes = hide_classes | append: ' cs-hide-mobile'
 endif

 assign focal = block.settings.image_position | default: 'center center'

 assign text_align = block.settings.text_alignment | default: 'left'
 assign body_align = 'flex-start'
 if text_align == 'center'
 assign body_align = 'center'
 elsif text_align == 'right'
 assign body_align = 'flex-end'
 endif
 -%}
 <li class="category-showcase__cell{{ hide_classes }}"
 data-cs-slide
 {% if s.enable_animation %}data-cs-reveal style="--cs-delay: {{ block.settings.animation_delay | default: 0 }}ms;"{% endif %}
 {{ block.shopify_attributes }}>
 <article class="cs-card uc-card-stable"
 style="--cs-text-align: {{ text_align }}; --cs-body-align: {{ body_align }};{% if block.settings.overlay_strength != blank %}--cs-overlay: {{ block.settings.overlay_strength | divided_by: 100.0 }};{% endif %}">
 {%- if card_url != blank -%}
 <a class="cs-card__link" href="{{ card_url }}" aria-label="{{ card_title | escape }}"></a>
 {%- endif -%}

 <div class="cs-card__media">
 {%- if card_image != blank -%}
 {%- capture sizes -%}(min-width: 990px) calc((min({{ s.container_width | default: 1200 }}px, 100vw) - {{ cols_desktop | minus: 1 | times: 24 }}px) / {{ cols_desktop }}), (min-width: 750px) 45vw, 85vw{%- endcapture -%}
 <img class="cs-card__img"
 src="{{ card_image | image_url: width: 600 }}"
 srcset="{{ card_image | image_url: width: 400 }} 400w,
 {{ card_image | image_url: width: 600 }} 600w,
 {{ card_image | image_url: width: 800 }} 800w"
 sizes="{{ sizes }}"
 width="{{ card_image.width }}"
 height="{{ card_image.height }}"
 alt="{{ card_image.alt | default: card_title | escape }}"
 loading="{% if forloop.index > 2 %}lazy{% else %}eager{% endif %}"
 {% if s.enable_lazy and forloop.index > cols_desktop %}fetchpriority="low"{% endif %}
 decoding="async"
 style="object-fit: cover; object-position: {{ focal }};">
 {%- else -%}
 {%- liquid
   assign ohs_fallback = 'ohs-cat-baby.jpg'
   assign _title_down = card_title | downcase
   if _title_down contains 'rattle' or _title_down contains 'teether'
     assign ohs_fallback = 'ohs-cat-rattles.jpg'
   elsif _title_down contains 'plush' or _title_down contains 'soft'
     assign ohs_fallback = 'ohs-cat-plush.jpg'
   elsif _title_down contains 'musical'
     assign ohs_fallback = 'ohs-cat-musical.jpg'
   elsif _title_down contains 'sensory'
     assign ohs_fallback = 'ohs-cat-sensory.jpg'
   elsif _title_down contains 'gym' or _title_down contains 'mat'
     assign ohs_fallback = 'ohs-cat-gyms.jpg'
   elsif _title_down contains 'educational' or _title_down contains 'learning'
     assign ohs_fallback = 'ohs-cat-educational.jpg'
   elsif _title_down contains 'wooden'
     assign ohs_fallback = 'ohs-cat-wooden.jpg'
   elsif _title_down contains 'block'
     assign ohs_fallback = 'ohs-cat-blocks.jpg'
   elsif _title_down contains 'bath'
     assign ohs_fallback = 'ohs-cat-bath.jpg'
   elsif _title_down contains 'pretend'
     assign ohs_fallback = 'ohs-cat-pretend.jpg'
   elsif _title_down contains 'puzzle' or _title_down contains 'game'
     assign ohs_fallback = 'ohs-cat-puzzles.jpg'
   endif
 -%}
 <img class="cs-card__img" src="{{ ohs_fallback | asset_url }}" alt="{{ card_title | escape }}" loading="lazy" decoding="async" width="800" height="800" style="object-fit: cover; object-position: {{ focal }};">
 {%- endif -%}

 {%- if s.enable_gradient -%}
 <span class="cs-card__scrim" aria-hidden="true"></span>
 {%- endif -%}

 {%- if s.enable_badge and block.settings.badge != blank -%}
 <span class="cs-card__badge cs-card__badge--{{ block.settings.badge_position | default: 'top-left' }}"
 style="color: {{ block.settings.badge_color | default: '#111' }}; background: {{ block.settings.badge_background | default: '#ffffff' }};">
 {{ block.settings.badge }}
 </span>
 {%- endif -%}
 </div>

 <div class="cs-card__body">
 <div class="cs-card__text">
 {%- if card_title != blank -%}
 <h3 class="cs-card__title">{{ card_title }}</h3>
 {%- endif -%}

 {%- if false and s.enable_count and col != blank -%}
 {%- assign product_word = 'products' -%}
 {%- if col.all_products_count == 1 -%}{%- assign product_word = 'product' -%}{%- endif -%}
 <p class="cs-card__count">{{ col.all_products_count }} {{ product_word }}</p>
 {%- endif -%}

 {%- if s.enable_description and card_desc != blank -%}
 <p class="cs-card__desc">{{ card_desc }}</p>
 {%- endif -%}
 </div>

 {%- if s.enable_button and card_url != blank -%}
 {%- assign btn_style = block.settings.button_style | default: 'ghost' -%}
 <span class="cs-card__cta button button--{{ btn_style }}{% if block.settings.button_full_width %} cs-card__cta--full{% endif %}">
 <span>{{ block.settings.button_text | default: 'Shop now' }}</span>
 <svg class="cs-arrow" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="15" height="15">
 <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
 </svg>
 </span>
 {%- endif -%}
 </div>
 </article>
 </li>
 {%- endfor -%}
 </ul>

 {%- if s.enable_slider and s.show_pagination -%}
 <div class="category-showcase__dots" data-cs-dots role="group" aria-label="Collection slides" hidden></div>
 {%- endif -%}
 {%- else -%}
 <div class="category-showcase__empty">Add category blocks to display your collections here.</div>
 {%- endif -%}
 </div>
</category-showcase>

{% stylesheet %}
 /* Layout, header, grid, arrows: uc-showcase.css */

 .category-showcase__cell { min-width: 0; }

 /* --------------------------------- Card --------------------------------- */
 .cs-card {
 position: relative;
 display: flex;
 flex-direction: column;
 height: 100%;
 text-align: var(--cs-text-align, left);
 border-radius: var(--cs-card-radius, var(--card-radius));
 background: var(--surface-color);
 overflow: hidden;
 box-shadow: 0 1px 2px rgba(var(--color-foreground), 0.04),
 0 calc(var(--cs-card-shadow) * 0.5px) calc(var(--cs-card-shadow) * 1.4px) rgba(var(--color-foreground), 0.08);
 transition: transform var(--transition-slow), box-shadow var(--transition-slow);
 will-change: transform;
 }

 .cs-card__link {
 position: absolute;
 inset: 0;
 z-index: 3;
 text-indent: -9999px;
 overflow: hidden;
 }
 .cs-card__link:focus-visible {
 outline: 0.2rem solid rgb(var(--color-foreground));
 outline-offset: -0.4rem;
 border-radius: var(--cs-card-radius);
 }

 .cs-card__media {
 position: relative;
 aspect-ratio: 1 / var(--cs-ratio);
 overflow: hidden;
 border-radius: var(--cs-card-radius) var(--cs-card-radius) 0 0;
 background: rgba(var(--color-foreground), 0.05);
 }

 .cs-card__img {
 width: 100%;
 height: 100%;
 object-fit: var(--cs-object-fit, cover);
 display: block;
 transform-origin: center center;
 transition: transform 0.7s var(--ease-premium, cubic-bezier(0.22, 1, 0.36, 1));
 backface-visibility: hidden;
 will-change: transform;
 }
 .cs-card__placeholder { display: grid; place-items: center; }
 .cs-card__placeholder-svg { width: 60%; height: 60%; opacity: 0.3; }

 .cs-card__scrim {
 position: absolute;
 inset: 0;
 z-index: 1;
 pointer-events: none;
 background: linear-gradient(to top, rgba(0, 0, 0, var(--cs-overlay)) 0%, rgba(0, 0, 0, calc(var(--cs-overlay) * 0.35)) 38%, rgba(0, 0, 0, 0) 68%);
 transition: opacity var(--transition-slow);
 }

 /* --------------------------------- Badge -------------------------------- */
 .cs-card__badge {
 position: absolute;
 z-index: 2;
 padding: 0.5rem 0.9rem;
 font-size: 11px;
 font-weight: 600;
 letter-spacing: 0.1em;
 text-transform: uppercase;
 line-height: 1;
 border-radius: var(--button-radius);
 box-shadow: var(--shadow-small);
 white-space: nowrap;
 }
 .cs-card__badge--top-left { top: 1rem; inset-inline-start: 1rem; }
 .cs-card__badge--top-right { top: 1rem; inset-inline-end: 1rem; }
 .cs-card__badge--bottom-left { bottom: 1rem; inset-inline-start: 1rem; }
 .cs-card__badge--bottom-right { bottom: 1rem; inset-inline-end: 1rem; }

 /* --------------------------------- Body --------------------------------- */
 .cs-card__body {
 position: relative;
 z-index: 2;
 display: flex;
 flex-direction: column;
 gap: 1rem;
 flex: 1 1 auto;
 padding: 1.35rem 1.4rem 1.5rem;
 }

 .cs-card__text {
 display: flex;
 flex-direction: column;
 gap: 0.5rem;
 transition: transform var(--transition-slow);
 }

 .cs-card__title {
 margin: 0;
 font-family: var(--font-heading-family);
 font-weight: 700;
 font-size: 20px;
 line-height: 1.22;
 letter-spacing: -0.01em;
 color: #2a2a2a;
 }

 .cs-card__count {
 display: none !important;
 margin: 0;
 }

 .cs-card__desc {
 margin: 0;
 font-size: 14px;
 line-height: 1.5;
 color: #2a2a2a;
 }

 .cs-card__cta {
 margin-top: auto;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 gap: 0.5rem;
 align-self: var(--cs-body-align, flex-start);
 }
 .cs-card__cta--full { align-self: stretch; width: 100%; }

 /* Button variants built on Dawn's .button base (outlined / ghost) so they
 inherit the theme's font, radius and sizing while matching the header. */
 .category-showcase .button {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 gap: 0.5rem;
 }
 .category-showcase .button--outlined {
 background: transparent;
 color: rgb(var(--color-foreground));
 box-shadow: 0 0 0 1px rgba(var(--color-foreground), 0.55);
 transition: box-shadow var(--transition-normal), background var(--transition-normal), color var(--transition-normal);
 }
 .category-showcase .button--outlined::after,
 .category-showcase .button--outlined::before { display: none; }
 .category-showcase .button--outlined:hover {
 background: rgb(var(--color-foreground));
 color: rgb(var(--color-background));
 box-shadow: 0 0 0 1px rgb(var(--color-foreground));
 }
 .category-showcase .button--ghost {
 background: transparent;
 color: rgb(var(--color-foreground));
 border: 0;
 box-shadow: none;
 padding-inline: 0;
 min-width: 0;
 transition: opacity var(--transition-normal);
 }
 .category-showcase .button--ghost::after,
 .category-showcase .button--ghost::before { display: none; }
 .category-showcase .button--ghost:hover { opacity: 0.65; }

 /* Arrow micro-interaction (header + card CTA) */
 .cs-arrow { transition: transform var(--transition-normal); }
 .category-showcase__header-btn:hover .cs-arrow,
 .cs-card__cta .cs-arrow { transform: translateX(0); }

 /* ------------------------------- Hover FX ------------------------------- */
 .category-showcase[data-hover="true"] .cs-card:hover {
 transform: translate3d(0, -4px, 0);
 }
 .category-showcase[data-hover="true"] .cs-card.uc-3d-card:hover {
 transform: none;
 }
 .category-showcase[data-hover="true"] .cs-card::after {
 content: "";
 position: absolute;
 inset: 0;
 z-index: 4;
 border-radius: var(--cs-card-radius);
 pointer-events: none;
 box-shadow: inset 0 0 0 1px rgba(var(--color-foreground), 0);
 transition: box-shadow var(--transition-slow);
 }
 .category-showcase[data-hover="true"] .cs-card:hover::after {
 box-shadow: inset 0 0 0 1px rgba(var(--color-foreground), 0.14);
 }
 .category-showcase[data-hover="true"][data-zoom="true"] .cs-card:hover .cs-card__img { transform: scale(var(--card-hover-image-scale, 1.04)); }
 .category-showcase[data-hover="true"] .cs-card:hover .cs-card__scrim { opacity: 1.15; }
 .category-showcase[data-hover="true"] .cs-card:hover .cs-card__cta .cs-arrow { transform: translateX(4px); }

 /* ------------------------------ Scroll reveal --------------------------- */
 .category-showcase[data-animate="true"] [data-cs-reveal] {
 opacity: 0;
 transform: translateY(24px);
 }
 .category-showcase[data-animate="true"] [data-cs-reveal].cs-is-visible {
 opacity: 1;
 transform: none;
 transition: opacity 0.7s var(--ease-premium, cubic-bezier(0.22, 1, 0.36, 1)) var(--cs-delay, 0ms), transform 0.7s var(--ease-premium, cubic-bezier(0.22, 1, 0.36, 1)) var(--cs-delay, 0ms);
 }

 /* -------------------------------- Slider dots --------------------------- */
 .category-showcase__dots {
 display: flex;
 justify-content: center;
 gap: 0.5rem;
 margin-top: 1.5rem;
 }
 .category-showcase__dot {
 width: 8px;
 height: 8px;
 padding: 0;
 border: 0;
 border-radius: 100px;
 background: rgba(var(--color-foreground), 0.22);
 cursor: pointer;
 transition: width var(--transition-normal), background var(--transition-normal);
 }
 .category-showcase__dot.is-active { width: 22px; background: rgb(var(--color-foreground)); }
 .category-showcase__dot:focus-visible { outline: 0.2rem solid rgb(var(--color-foreground)); outline-offset: 3px; }

 .category-showcase__empty {
 padding: var(--space-9);
 text-align: center;
 border: 1px dashed var(--border-color);
 border-radius: var(--cs-card-radius);
 }

 /* Category-only slider drag helpers */

 @media screen and (max-width: 749px) {
 .category-showcase[data-slider="true"].cs-dragging .category-showcase__grid { scroll-snap-type: none; }
 .category-showcase[data-slider="true"].cs-dragging .cs-card__link { pointer-events: none; }
 }
 @media screen and (min-width: 750px) {
 .cs-hide-desktop { display: none !important; }
 }
 @media screen and (max-width: 749px) {
 .cs-hide-mobile { display: none !important; }
 }

 /* ---------------------------- Reduced motion ---------------------------- */
 @media (prefers-reduced-motion: reduce) {
 .category-showcase *,
 .category-showcase *::before,
 .category-showcase *::after {
 transition-duration: 0.001ms !important;
 animation-duration: 0.001ms !important;
 }
 .category-showcase[data-animate="true"] [data-cs-reveal] { opacity: 1 !important; transform: none !important; }
 .category-showcase[data-slider="true"] .category-showcase__grid { scroll-behavior: auto; }
 }
{% endstylesheet %}

{% javascript %}
 class CategoryShowcase extends HTMLElement {
 constructor() {
 super();
 this.track = this.querySelector('[data-cs-track]');
 this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 this._onResize = this._onResize.bind(this);
 }

 connectedCallback() {
 if (!this.track) return;
 this._setupReveal();
 this._setupArrows();
 this._setupDots();
 this._setupDrag();
 this._setupAutoplay();
 window.addEventListener('resize', this._onResize, { passive: true });
 this._onResize();
 }

 disconnectedCallback() {
 window.removeEventListener('resize', this._onResize);
 this._stopAutoplay();
 if (this._io) this._io.disconnect();
 }

 get isSlider() {
   /* Slider works on all breakpoints when enabled in theme settings */
   return this.dataset.slider === 'true';
 }

 /* ------------------------------ Reveal ------------------------------ */
 _setupReveal() {
 if (this.dataset.animate !== 'true' || this.reduced || !('IntersectionObserver' in window)) {
 this.querySelectorAll('[data-cs-reveal]').forEach((el) => el.classList.add('cs-is-visible'));
 return;
 }
 this._io = new IntersectionObserver((entries, obs) => {
 entries.forEach((entry) => {
 if (entry.isIntersecting) {
 entry.target.classList.add('cs-is-visible');
 obs.unobserve(entry.target);
 }
 });
 }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
 this.querySelectorAll('[data-cs-reveal]').forEach((el) => this._io.observe(el));
 }

 /* ------------------------------ Arrows ------------------------------ */
 _setupArrows() {
 this.arrowsWrap = this.querySelector('[data-cs-arrows]');
 if (!this.arrowsWrap) return;
 this.prevBtn = this.querySelector('[data-cs-prev]');
 this.nextBtn = this.querySelector('[data-cs-next]');
 this.prevBtn.addEventListener('click', () => this._scrollByCards(-1));
 this.nextBtn.addEventListener('click', () => this._scrollByCards(1));
 this.track.addEventListener('scroll', () => this._syncControls(), { passive: true });
 }

 _cellStep() {
 const cell = this.track.querySelector('[data-cs-slide]:not(.cs-hide-mobile)');
 if (!cell) return this.track.clientWidth;
 const gap = parseFloat(getComputedStyle(this.track).columnGap || getComputedStyle(this.track).gap) || 0;
 return cell.getBoundingClientRect().width + gap;
 }

 _scrollByCards(dir) {
 this._pauseAutoplay();
 const atEnd = this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - 2;
 const atStart = this.track.scrollLeft <= 2;
 if (this.dataset.loop === 'true') {
 if (dir > 0 && atEnd) { this.track.scrollTo({ left: 0, behavior: this.reduced ? 'auto' : 'smooth' }); return; }
 if (dir < 0 && atStart) { this.track.scrollTo({ left: this.track.scrollWidth, behavior: this.reduced ? 'auto' : 'smooth' }); return; }
 }
 this.track.scrollBy({ left: this._cellStep() * dir, behavior: this.reduced ? 'auto' : 'smooth' });
 }

 /* ------------------------------- Dots ------------------------------- */
 _setupDots() {
 this.dotsWrap = this.querySelector('[data-cs-dots]');
 if (!this.dotsWrap) return;
 }

 _buildDots() {
 if (!this.dotsWrap) return;
 const count = this._pageCount();
 if (this._dotCount === count) return;
 this._dotCount = count;
 this.dotsWrap.innerHTML = '';
 for (let i = 0; i < count; i++) {
 const dot = document.createElement('button');
 dot.type = 'button';
 dot.className = 'category-showcase__dot';
 dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
 dot.setAttribute('aria-current', i === 0 ? 'true' : 'false');
 dot.addEventListener('click', () => {
 this._pauseAutoplay();
 this.track.scrollTo({ left: this._cellStep() * i, behavior: this.reduced ? 'auto' : 'smooth' });
 });
 this.dotsWrap.appendChild(dot);
 }
 }

 _pageCount() {
 const step = this._cellStep();
 if (!step) return 0;
 return Math.max(1, Math.ceil((this.track.scrollWidth - this.track.clientWidth) / step) + 1);
 }

 /* --------------------------- Mouse drag ----------------------------- */
 _setupDrag() {
 let down = false, startX = 0, startLeft = 0, moved = false;
 const start = (e) => {
 if (!this.isSlider) return;
 down = true; moved = false;
 startX = e.pageX;
 startLeft = this.track.scrollLeft;
 };
 const move = (e) => {
 if (!down) return;
 const dx = e.pageX - startX;
 if (Math.abs(dx) > 4) { moved = true; this.classList.add('cs-dragging'); this._pauseAutoplay(); }
 this.track.scrollLeft = startLeft - dx;
 };
 const end = () => {
 if (!down) return;
 down = false;
 if (moved) setTimeout(() => this.classList.remove('cs-dragging'), 0);
 };
 this.track.addEventListener('mousedown', start);
 window.addEventListener('mousemove', move, { passive: true });
 window.addEventListener('mouseup', end);
 }

 /* ----------------------------- Autoplay ----------------------------- */
 _setupAutoplay() {
 if (this.dataset.autoplay !== 'true' || this.reduced) return;
 const speed = parseInt(this.dataset.autoplaySpeed, 10) || 5000;
 this._autoplaySpeed = speed;
 const io = new IntersectionObserver((entries) => {
 entries.forEach((e) => e.isIntersecting ? this._startAutoplay() : this._stopAutoplay());
 }, { threshold: 0.2 });
 io.observe(this);
 ['mouseenter', 'focusin', 'touchstart', 'pointerdown'].forEach((ev) =>
 this.addEventListener(ev, () => this._pauseAutoplay(), { passive: true }));
 this.addEventListener('mouseleave', () => this._startAutoplay());
 }

 _startAutoplay() {
 if (this.dataset.autoplay !== 'true' || this.reduced || !this.isSlider || this._timer) return;
 this._timer = setInterval(() => this._scrollByCards(1), this._autoplaySpeed);
 }
 _stopAutoplay() { if (this._timer) { clearInterval(this._timer); this._timer = null; } }
 _pauseAutoplay() {
 this._stopAutoplay();
 clearTimeout(this._resume);
 if (this.dataset.autoplay === 'true') this._resume = setTimeout(() => this._startAutoplay(), 4000);
 }

 /* ------------------------------ Sync -------------------------------- */
 _syncControls() {
 if (!this.isSlider) return;
 if (this.prevBtn && this.dataset.loop !== 'true') {
 this.prevBtn.disabled = this.track.scrollLeft <= 2;
 this.nextBtn.disabled = this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - 2;
 }
 if (this.dotsWrap && this._dotCount) {
 const idx = Math.round(this.track.scrollLeft / (this._cellStep() || 1));
 this.dotsWrap.querySelectorAll('.category-showcase__dot').forEach((d, i) => {
 const on = i === idx;
 d.classList.toggle('is-active', on);
 d.setAttribute('aria-current', on ? 'true' : 'false');
 });
 }
 }

 _onResize() {
 const slider = this.isSlider;
 if (this.arrowsWrap) this.arrowsWrap.hidden = !slider;
 if (this.dotsWrap) {
 this.dotsWrap.hidden = !slider;
 if (slider) this._buildDots();
 }
 if (slider) { this._buildDots(); this._syncControls(); this._startAutoplay(); }
 else this._stopAutoplay();
 }
 }

 if (!customElements.get('category-showcase')) {
 customElements.define('category-showcase', CategoryShowcase);
 }
