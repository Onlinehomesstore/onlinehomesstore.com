 {{ type | payment_type_svg_tag: class: 'uc-ft-payment-icon', width: 38, height: 24 }}
 </span>
 {%- endfor -%}
 </div>
 {%- endif -%}

 {%- if s.show_localization -%}
 <div class="uc-ft-localization">
 {%- if s.show_country_selector and localization.available_countries.size > 1 -%}
 {%- assign uc_ft_country_form_id = 'UcFtCountry-' | append: section.id -%}
 {%- form 'localization', id: uc_ft_country_form_id, class: 'uc-ft-localization__form' -%}
 <label class="uc-ft-sr-only" for="UcFtCountrySelect-{{ section.id }}">{{ 'localization.country_label' | t }}</label>
 <select id="UcFtCountrySelect-{{ section.id }}" name="country_code" class="uc-ft-localization__select" onchange="this.form.submit()">
 {%- for country in localization.available_countries -%}
 <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>
 {%- endfor -%}
 </select>
 {%- endform -%}
 {%- endif -%}
 {%- if s.show_language_selector and localization.available_languages.size > 1 -%}
 {%- assign uc_ft_lang_form_id = 'UcFtLang-' | append: section.id -%}
 {%- form 'localization', id: uc_ft_lang_form_id, class: 'uc-ft-localization__form' -%}
 <label class="uc-ft-sr-only" for="UcFtLangSelect-{{ section.id }}">{{ 'localization.language_label' | t }}</label>
 <select id="UcFtLangSelect-{{ section.id }}" name="locale_code" class="uc-ft-localization__select" onchange="this.form.submit()">
 {%- for language in localization.available_languages -%}
 <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name }}</option>
 {%- endfor -%}
 </select>
 {%- endform -%}
 {%- endif -%}
 </div>
 {%- endif -%}

 {%- comment -%} Policy Links {%- endcomment -%}
 {%- if has_privacy or has_refund or has_shipping or has_terms or s.policy_menu != blank -%}
 {%- comment -%} Policy links live in the Company column — avoid duplicate footer links overlapping scroll-to-top {%- endcomment -%}
 {%- endif -%}

 </div>
 </div>
 </div>

</footer>

<script src="{{ 'uc-footer.js' | asset_url }}" defer></script>

