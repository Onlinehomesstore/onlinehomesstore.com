{% comment %}
 uc-footer.liquid
 ═══════════════════════════════════════════════════════════════════════════════
 UC Footer Section - Shopify Online Store 2.0 / Dawn Compatible
 Structure:
 Part 1 - Newsletter Banner (dark rounded card, left content + right form)
 Part 2 - Main Footer Grid (brand · 3 nav columns · contact)
 Part 3 - Bottom Bar (copyright · payment icons · policy links)

 Assets: uc-footer.css · uc-footer.js
 All styles scoped to .uc-ft-section - zero global side effects.
 ═══════════════════════════════════════════════════════════════════════════════
{% endcomment %}

{% render 'uc-site-email' %}
{% render 'uc-site-contact' %}

{%- liquid
 assign s = section.settings

 # Navigation menus — Theme Editor menus first, never hardcode links
 assign nav_shop = linklists[s.nav_shop]
 assign nav_company = linklists[s.nav_company]
 assign nav_support = linklists[s.nav_support]

 # Accent color for CSS vars
 assign accent = s.accent_color | default: settings.uc_color_primary | default: '#B68A35'

 assign uc_ft_email = s.contact_email | default: uc_site_email
 assign uc_ft_phone = blank
 assign uc_ft_hours = s.contact_hours | default: uc_site_hours
 assign uc_ft_address = s.contact_address | default: uc_site_address
 assign uc_ft_whatsapp = blank
 assign uc_ft_map_url = s.contact_map_url | default: uc_site_map_url
 assign uc_ft_phone_href = uc_ft_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
 assign uc_ft_whatsapp_href = uc_ft_whatsapp | remove: ' ' | remove: '-' | remove: '+' | remove: '(' | remove: ')'

 assign uc_ft_ig = s.social_instagram | default: settings.social_instagram_link
 assign uc_ft_fb = s.social_facebook | default: settings.social_facebook_link
 assign uc_ft_tt = s.social_tiktok | default: settings.social_tiktok_link
 assign uc_ft_pin = s.social_pinterest | default: settings.social_pinterest_link
 assign uc_ft_yt = s.social_youtube | default: settings.social_youtube_link
 assign uc_ft_x = s.social_twitter | default: settings.social_twitter_link

 assign uc_ft_nl_form_id = 'uc-ft-nl-form-' | append: section.id
 assign uc_ft_nl_success = s.nl_success | default: 'You are in! Thank you for subscribing.'

 # Policy links (use Shopify policies if available)
 assign has_privacy = false
 assign has_refund = false
 assign has_shipping = false
 assign has_terms = false
 if shop.privacy_policy != blank
 assign has_privacy = true
 endif
 if shop.refund_policy != blank
 assign has_refund = true
 endif
 if shop.shipping_policy != blank
 assign has_shipping = true
 endif
 if shop.terms_of_service != blank
 assign has_terms = true
 endif
-%}

{%- assign uc_sec_scope = '#uc-ft-' | append: section.id -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #uc-ft-{{ section.id }} {
 --uc-ft-max: var(--page-width);
 --uc-ft-pt: {{ s.padding_top | default: 0 }}px;
 --uc-ft-bg: {{ s.bg_color | default: '#ffffff' }};
 --uc-ft-color: {{ s.text_color | default: '#2a2a2a' }};
 --uc-ft-heading-color: {{ s.heading_color | default: '#1a1a1a' }};
 --uc-ft-link-color: {{ s.link_color | default: '#5a5a5a' }};
 --uc-ft-muted: {{ s.muted_color | default: '#9ca3af' }};
 --uc-ft-accent: {{ accent }};
 --uc-ft-divider: 1px solid {{ s.divider_color | default: 'rgba(0,0,0,0.07)' }};
 --uc-ft-divider-color: {{ s.divider_color | default: 'rgba(0,0,0,0.07)' }};
 --uc-ft-logo-w: {{ s.logo_width | default: 140 }}px;
 --uc-ft-social-size: {{ s.social_size | default: 36 }}px;
 --uc-ft-social-bg: {{ s.social_bg | default: 'rgba(0,0,0,0.05)' }};
 --uc-ft-social-color: {{ s.social_color | default: '#5a5a5a' }};
 --uc-ft-social-hover-bg: {{ accent }};
 --uc-ft-icon-bg: {{ s.icon_bg | default: 'rgba(58,87,48,0.08)' }};
 --uc-ft-nl-bg: {{ s.nl_bg | default: '#3a5730' }};
 --uc-ft-nl-text: {{ s.nl_text_color | default: '#ffffff' }};
 --uc-ft-nl-radius: {{ s.nl_radius | default: 16 }}px;
 --uc-ft-nl-btn-bg: {{ s.nl_btn_bg | default: accent }};
 --uc-ft-nl-btn-color: {{ s.nl_btn_color | default: '#ffffff' }};
 --uc-ft-bottom-bg: {{ s.bottom_bg | default: 'transparent' }};
 --uc-ft-grid-cols: {{ s.grid_cols | default: '1.8fr 1fr 1fr 1fr 1.4fr' }};
 --uc-ft-nl-input-radius: {{ s.nl_input_radius | default: 10 }}px;
 --uc-ft-nl-glass-blur: {{ s.nl_glass_blur | default: 18 }}px;
 --uc-ft-nl-shadow: {{ s.nl_shadow_opacity | default: 12 | divided_by: 100.0 }};
 --uc-ft-pad-nl-d: {{ s.nl_pad_desktop | default: 40 }}px;
 --uc-ft-pad-nl-t: {{ s.nl_pad_tablet | default: 32 }}px;
 --uc-ft-pad-nl-m: {{ s.nl_pad_mobile | default: 24 }}px;
 --uc-ft-nl-radius-m: {{ s.nl_radius_mobile | default: s.nl_radius | default: 16 }}px;
 --uc-ft-nl-radius-t: {{ s.nl_radius_tablet | default: s.nl_radius | default: 20 }}px;
 }
{%- endstyle -%}

{{ 'uc-footer.css' | asset_url | stylesheet_tag }}

<footer
 class="uc-ft-section"
 id="uc-ft-{{ section.id }}"
 role="contentinfo"
 aria-label="{{ shop.name }} footer"
>

 {%- comment -%}═══════════════════════════════════════════════
 PART 1 - NEWSLETTER BANNER
 ═══════════════════════════════════════════════{%- endcomment -%}

 {%- if s.show_newsletter -%}
 <div class="uc-ft-nl-outer uc-ft-container">
 <div class="uc-ft-nl-banner{% if s.nl_glass %} uc-ft-nl-banner--glass{% endif %}{% if s.nl_elevated %} uc-ft-nl-banner--elevated{% endif %}" data-uc-theme-text style="--uc-theme-heading: var(--uc-ft-nl-text); --uc-theme-body: var(--uc-ft-nl-text);{% if s.nl_text_color_mobile != blank %}--uc-theme-heading-mobile: {{ s.nl_text_color_mobile }};--uc-theme-body-mobile: {{ s.nl_text_color_mobile }};--uc-theme-text-mobile: {{ s.nl_text_color_mobile }};{% endif %} color: var(--uc-ft-nl-text);">

 {%- comment -%} Left: Icon + Heading + Description {%- endcomment -%}
 <div class="uc-ft-nl-content">
 {%- if s.nl_show_icon -%}
 <div class="uc-ft-nl-icon" aria-hidden="true">
 {%- if s.nl_icon != blank -%}
 {{
 s.nl_icon
 | image_url: width: 60
 | image_tag: loading: 'lazy', alt: '', width: 22, height: 22
 }}
 {%- else -%}
 <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
 {%- endif -%}
 </div>
 {%- endif -%}

 <div class="uc-ft-nl-text">
 {%- if s.nl_eyebrow != blank -%}
 <p class="uc-ft-nl-eyebrow">{{ s.nl_eyebrow | escape }}</p>
 {%- endif -%}
 {%- if s.nl_heading != blank -%}
 <h2 class="uc-ft-nl-heading">{{ s.nl_heading | escape }}</h2>
 {%- endif -%}
 {%- if s.nl_desc != blank -%}
 <p class="uc-ft-nl-desc">{{ s.nl_desc | escape }}</p>
 {%- endif -%}
 </div>
 </div>

 {%- comment -%} Right: Newsletter Form {%- endcomment -%}
 <div class="uc-ft-nl-form-wrap">
 {%- form 'customer', id: uc_ft_nl_form_id, class: 'uc-ft-nl-form', data-uc-ft-nl: '', data-msg-required: 'Please enter your email address.', data-msg-invalid: 'Please enter a valid email address.', data-msg-success: uc_ft_nl_success, data-msg-error: 'Something went wrong. Please try again.' -%}
 <input type="hidden" name="contact[tags]" value="newsletter">
 <input type="hidden" name="contact[accepts_marketing]" value="true">

 <label
 for="uc-ft-nl-email-{{ section.id }}"
 class="uc-ft-sr-only"
 >{{ s.nl_placeholder | default: 'Enter your email' | escape }}</label>

 <input
 id="uc-ft-nl-email-{{ section.id }}"
 type="email"
 name="contact[email]"
 class="uc-ft-nl-input"
 placeholder="{{ s.nl_placeholder | default: 'Enter your email' | escape }}"
 autocomplete="email"
 required
 aria-required="true"
 >

 <button
 type="submit"
 class="uc-ft-nl-btn"
 aria-label="{{ s.nl_btn | default: 'Subscribe' | escape }}"
 >
 <span class="uc-ft-nl-btn__label">{{ s.nl_btn | default: 'Subscribe' | escape }}</span>
 <span class="uc-ft-nl-btn__spinner" aria-hidden="true"></span>
 <svg class="uc-ft-nl-btn__arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
 </button>
 {%- endform -%}

 <div class="uc-ft-nl-feedback" role="alert" aria-live="polite">
 {%- if form.posted_successfully? -%}
 {{ s.nl_success | default: 'You are in! Thank you for subscribing.' | escape }}
 {%- endif -%}
 </div>

 {%- if s.nl_note != blank -%}
 <p class="uc-ft-nl-note">{{ s.nl_note | escape }}</p>
 {%- endif -%}
 </div>

 </div>
 </div>
 {%- endif -%}

 {%- comment -%}═══════════════════════════════════════════════
 PART 2 - MAIN FOOTER GRID
 ═══════════════════════════════════════════════{%- endcomment -%}

 <div class="uc-ft-main">
 <div class="uc-ft-container uc-sec__container">
 <div class="uc-ft-grid">

 {%- comment -%} ── Column 1: Brand ── {%- endcomment -%}
 <div class="uc-ft-brand">
 <div class="uc-ft-brand__logo-wrap">
 <a href="{{ routes.root_url }}" class="uc-ft-brand__logo-link" aria-label="{{ shop.name | escape }} - Home">
 {%- if s.logo != blank -%}
 {%- assign logo_alt = s.logo.alt | default: shop.name | escape -%}
 {{
 s.logo
 | image_url: width: 280
 | image_tag:
 class: 'uc-ft-brand__logo',
 loading: 'lazy',
 alt: logo_alt,
 widths: '140, 210, 280'
 }}
 {%- else -%}
 <span class="uc-ft-brand__text-logo">{{ shop.name | escape }}</span>
 {%- if s.brand_tagline != blank -%}
 <span class="uc-ft-brand__tagline">{{ s.brand_tagline | escape }}</span>
 {%- endif -%}
 {%- endif -%}
 </a>
 </div>

 {%- if s.brand_desc != blank -%}
 <p class="uc-ft-brand__desc">{{ s.brand_desc | escape }}</p>
 {%- endif -%}

 {%- if s.trust_badge_1 != blank or s.trust_badge_2 != blank or s.trust_badge_3 != blank -%}
 <ul class="uc-ft-trust" role="list">
 {%- if s.trust_badge_1 != blank -%}<li class="uc-ft-trust__item">{{ s.trust_badge_1 | escape }}</li>{%- endif -%}
 {%- if s.trust_badge_2 != blank -%}<li class="uc-ft-trust__item">{{ s.trust_badge_2 | escape }}</li>{%- endif -%}
 {%- if s.trust_badge_3 != blank -%}<li class="uc-ft-trust__item">{{ s.trust_badge_3 | escape }}</li>{%- endif -%}
 </ul>
 {%- endif -%}

 {%- if uc_ft_whatsapp != blank -%}
 <a
 href="https://wa.me/{{ uc_ft_whatsapp_href }}"
 class="uc-ft-wa-cta"
 target="_blank"
 rel="noopener noreferrer"
 >
 <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
 <span>{{ s.mobile_whatsapp_label | default: 'Chat on WhatsApp' | escape }}</span>
 </a>
 {%- endif -%}

 {%- comment -%} Social Icons {%- endcomment -%}
 {%- if s.show_social -%}
 {%- liquid
 assign social_links = ''
 if uc_ft_ig != blank
 assign social_links = social_links | append: 'instagram'
 endif
 if uc_ft_fb != blank
 assign social_links = social_links | append: 'facebook'
 endif
 if uc_ft_tt != blank
 assign social_links = social_links | append: 'tiktok'
 endif
 if uc_ft_pin != blank
 assign social_links = social_links | append: 'pinterest'
 endif
 if uc_ft_yt != blank
 assign social_links = social_links | append: 'youtube'
 endif
 if uc_ft_x != blank
 assign social_links = social_links | append: 'twitter'
 endif
 if s.social_threads != blank
 assign social_links = social_links | append: 'threads'
 endif
 if s.social_linkedin != blank
 assign social_links = social_links | append: 'linkedin'
 endif
 if s.social_whatsapp != blank or uc_ft_whatsapp != blank
 assign social_links = social_links | append: 'whatsapp'
 endif
 if s.social_snapchat != blank
 assign social_links = social_links | append: 'snapchat'
 endif
 -%}
 {%- unless social_links == blank -%}
 <div class="uc-ft-follow">
 <h3 class="uc-ft-follow__title">{{ s.mobile_follow_label | default: 'Follow on' | escape }}</h3>
 <nav class="uc-ft-social" aria-label="Follow us on social media">
 {%- if uc_ft_ig != blank -%}
 <a href="{{ uc_ft_ig }}" class="uc-ft-social__link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
 </a>
 {%- endif -%}
 {%- if uc_ft_fb != blank -%}
 <a href="{{ uc_ft_fb }}" class="uc-ft-social__link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
 </a>
 {%- endif -%}
 {%- if uc_ft_tt != blank -%}
 <a href="{{ uc_ft_tt }}" class="uc-ft-social__link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.22a8.19 8.19 0 0 0 4.78 1.52V7.29a4.85 4.85 0 0 1-1.01-.6z"/></svg>
 </a>
 {%- endif -%}
 {%- if uc_ft_pin != blank -%}
 <a href="{{ uc_ft_pin }}" class="uc-ft-social__link" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
