{%- comment -%}
 ============================================================================
 PREMIUM PRODUCT HERO
 ----
 High-converting, premium above-the-fold product section for Dawn OS 2.0.
 Original implementation  -  not copied from any third-party source.

 Architecture:
 Left  -  sticky scroll-snap gallery (images + video, thumbnails, counter)
 Right  -  title -> price -> variants + qty + ATC -> trust -> delivery
 Left   -  sticky parallax gallery only
 Right  -  purchase panel + trust / delivery reassurance

 Reuses: uc-design-tokens.css, uc-icon.liquid (Lucide icons)
 Adds: premium-product-hero.css, premium-product-hero.js

 Preserves: Shopify dynamic checkout ({{ form | payment_button }})
 Native variant data structure (compatible with Dawn updates)
 AJAX cart via the store's shared cart:refresh / PUB_SUB events
 ============================================================================
{%- endcomment -%}
{{ 'premium-product-hero.css' | asset_url | stylesheet_tag }}
{%- include 'uc-review-data' -%}

{%- liquid
 assign s = section.settings
 assign uid = section.id
 assign cv = product.selected_or_first_available_variant

 assign on_sale = false
 if cv.compare_at_price > cv.price
 assign on_sale = true
 assign save_pct = cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price | round
 endif

 assign form_id = 'pph-form-' | append: uid

 assign trust_blocks = section.blocks | where: 'type', 'trust_icon'
 assign benefit_blocks = section.blocks | where: 'type', 'benefit'
 assign highlight_blocks = section.blocks | where: 'type', 'highlight'
 assign delivery_blocks = section.blocks | where: 'type', 'delivery_card'

 if highlight_blocks.size == 0 and s.use_benefits_as_highlights
 assign highlight_blocks = benefit_blocks
 endif

 assign save_amount = 0
 if on_sale
 assign save_amount = cv.compare_at_price | minus: cv.price
 endif

 assign has_media = false
 if product.media.size > 0
 assign has_media = true
 endif

 assign rating_value = blank
 assign review_count = blank
 assign rating_source = uc_review_source
 if uc_review_count > 0 and uc_review_avg != blank and uc_review_avg != 0
 assign rating_value = uc_review_avg
 assign review_count = uc_review_count
 assign rating_pct = uc_review_pct | round
 elsif s.rating_value != blank
 assign rating_value = s.rating_value
 assign review_count = s.review_count
 assign rating_source = 'settings'
 assign rating_pct = rating_value | times: 20 | round
 else
 assign rating_pct = 0
 endif

 assign product_subtitle = s.subtitle
 if product_subtitle == blank and product.metafields.custom.subtitle.value != blank
 assign product_subtitle = product.metafields.custom.subtitle.value
 elsif product_subtitle == blank and product.description != blank
 assign product_subtitle = product.description | strip_html | strip | truncate: 240
 endif
 assign gallery_col = s.gallery_col_width | default: 50
 assign info_col = 100 | minus: gallery_col
-%}

{%- assign pph_scope = '#ProductHero-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: pph_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #ProductHero-{{ uid }} {
 --pph-pad-top: {{ s.padding_top | default: 24 }}px;
 --pph-pad-bottom: {{ s.padding_bottom | default: 48 }}px;
 --pph-max-width: var(--page-width);
 --pph-col-gap: {{ s.col_gap | default: 48 }}px;
 --pph-radius: {{ s.border_radius | default: 12 }}px;
 --pph-star-color: {{ s.star_color | default: '#f5a623' }};
 --pph-star-pct: {{ rating_pct }}%;
 --pph-atc-radius: {{ s.atc_radius | default: 100 }}px;
 --pph-gallery-col: {{ gallery_col }}%;
 --pph-info-col: {{ info_col }}%;
 --pph-stack-gap: {{ s.stack_gap | default: 24 }}px;
 --pph-gallery-aspect: 1 / 1;
 --pph-gallery-fit: {{ s.gallery_image_fit | default: 'cover' }};
 --pph-accent: {{ s.accent_color | default: '#B68A35' }};
 }
 {%- if s.background_color != blank -%}
 #ProductHero-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
 {%- if s.heading_color != blank -%}
 #ProductHero-{{ uid }} { --pph-title-color: {{ s.heading_color }}; }
 {%- endif -%}
 {%- if s.heading_color_mobile != blank -%}
 #ProductHero-{{ uid }} { --pph-title-color-mobile: {{ s.heading_color_mobile }}; }
 {%- endif -%}
 {%- if s.accent_color != blank -%}
 #ProductHero-{{ uid }} { --pph-accent: {{ s.accent_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="ProductHero-{{ uid }}"
 class="pph uc-sec color-{{ s.color_scheme }}"
 data-section-id="{{ uid }}"
 data-pph-section
 {% if s.heading_color != blank or s.heading_color_mobile != blank %}data-uc-theme-text style="--uc-theme-heading: {{ s.heading_color | default: 'inherit' }};{% if s.heading_color_mobile != blank %}--uc-theme-heading-mobile: {{ s.heading_color_mobile }};{% else %}--uc-theme-heading-mobile: var(--pph-title-color-mobile, var(--uc-theme-heading));{% endif %}"{% endif %}
>
 <div class="pph__inner uc-sec__container">

 {%- comment -%} â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• GALLERY (left) â•â•â•â•â•â•â•â•â•â•â•â•â•â• {%- endcomment -%}
 <div class="pph__col pph__col--gallery">
 <div class="pph__gallery-sticky" data-pph-gallery-sticky>

 {%- comment -%} Main gallery viewer {%- endcomment -%}
 <div class="pph-gallery pph-gallery--frame" data-pph-gallery>
 <div class="pph-gallery__shell uc-3d-scene" data-pph-gallery-parallax>
 <div class="pph-gallery__viewport{% if s.gallery_image_fit == 'contain' %} pph-gallery__viewport--contain{% endif %}" data-uc-3d-image role="region" aria-label="Product images">
 {%- comment -%} Badges on main image (never over thumbs) {%- endcomment -%}
 <div class="pph__badges" aria-label="Product badges">
 {%- if s.show_badge_bestseller and s.badge_bestseller != blank -%}
 <span class="pph__badge pph__badge--bestseller">{{ s.badge_bestseller | escape }}</span>
 {%- endif -%}
 {%- if s.show_badge_new and s.badge_new != blank -%}
 <span class="pph__badge pph__badge--new">{{ s.badge_new | escape }}</span>
 {%- endif -%}
 {%- if on_sale -%}
 <span class="pph__badge pph__badge--sale">-{{ save_pct }}%</span>
 {%- endif -%}
 {%- if s.show_badge_lowstock and cv.inventory_quantity <= s.lowstock_threshold and cv.inventory_quantity > 0 -%}
 <span class="pph__badge pph__badge--low">{{ s.badge_lowstock | escape }}</span>
 {%- endif -%}
 {%- unless cv.available -%}
 <span class="pph__badge pph__badge--soldout">{{ s.soldout_text | default: 'Sold out' | escape }}</span>
 {%- endunless -%}
 </div>
 <ul
 class="pph-gallery__track"
 data-pph-track
 aria-live="polite"
 >
 {%- if has_media -%}
 {%- for media in product.media -%}
 <li
 class="pph-gallery__slide"
 data-pph-slide="{{ forloop.index0 }}"
 data-media-id="{{ media.id }}"
 data-media-type="{{ media.media_type }}"
 >
 {%- if media.media_type == 'image' -%}
 {%- liquid
 assign pph_zoom = media | image_url: width: 2400
 if forloop.first
 assign pph_loading = 'eager'
 else
 assign pph_loading = 'lazy'
 endif
 assign pph_alt = media.alt | default: product.title | escape
 -%}
 {{
 media
 | image_url: width: 1600
 | image_tag:
 class: 'pph-gallery__img',
 loading: pph_loading,
 widths: '600, 900, 1200, 1600, 2000',
 sizes: '(min-width: 990px) 50vw, 100vw',
 alt: pph_alt,
 data-zoom-src: pph_zoom
 }}
 {%- elsif media.media_type == 'video' -%}
 <div class="pph-gallery__video-wrap">
 <video
 class="pph-gallery__video"
 controls
 playsinline
 preload="metadata"
 poster="{{ media.preview_image | image_url: width: 900 }}"
 >
 {%- for source in media.sources -%}
 {%- if source.format == 'mp4' -%}
 <source src="{{ source.url }}" type="{{ source.mime_type }}">
 {%- endif -%}
 {%- endfor -%}
 </video>
 </div>
 {%- elsif media.media_type == 'external_video' -%}
 <div class="pph-gallery__video-wrap">
 <iframe
 src="https://www.youtube.com/embed/{{ media.external_id }}?rel=0"
 allow="autoplay; encrypted-media"
 loading="lazy"
 title="{{ media.alt | default: product.title | escape }}"
 ></iframe>
 </div>
 {%- endif -%}
 </li>
 {%- endfor -%}
 {%- else -%}
 <li class="pph-gallery__slide">
 {{ 'product-1' | placeholder_svg_tag: 'pph-gallery__img pph-gallery__img--placeholder' }}
 </li>
 {%- endif -%}
 </ul>

 {%- comment -%} Counter overlay {%- endcomment -%}
 {%- if has_media and product.media.size > 1 and s.show_image_counter -%}
 <div class="pph-gallery__counter" data-pph-counter aria-live="polite">
 1 / {{ product.media.size }}
 </div>
 {%- endif -%}

 {%- comment -%} Arrow navigation {%- endcomment -%}
 {%- if product.media.size > 1 -%}
 <button type="button" class="pph-gallery__arrow pph-gallery__arrow--prev" data-pph-prev aria-label="Previous image">
 {%- render 'uc-icon', icon: 'arrow-right', size: 20 -%}
 </button>
 <button type="button" class="pph-gallery__arrow pph-gallery__arrow--next" data-pph-next aria-label="Next image">
 {%- render 'uc-icon', icon: 'arrow-right', size: 20 -%}
 </button>
 {%- endif -%}
 </div>
 </div>{%- comment -%} /.pph-gallery__shell {%- endcomment -%}

 {%- comment -%} Thumbnails {%- endcomment -%}
 {%- if has_media and product.media.size > 1 and s.enable_thumbnails -%}
 <div class="pph-gallery__thumbs" data-pph-thumbs role="list" aria-label="Image thumbnails">
 {%- for media in product.media -%}
 <button
 type="button"
 class="pph-gallery__thumb{% if forloop.first %} is-active{% endif %}"
 data-pph-thumb="{{ forloop.index0 }}"
 data-media-id="{{ media.id }}"
 aria-label="View image {{ forloop.index }}"
 role="listitem"
 >
 {%- if media.media_type == 'image' or media.preview_image -%}
 {{
 media.preview_image | default: media
 | image_url: width: 160
 | image_tag: loading: 'lazy', class: 'pph-gallery__thumb-img', alt: '', widths: '80, 120, 160'
 }}
 {%- else -%}
 <span class="pph-gallery__thumb-video" aria-hidden="true">&#9654;</span>
 {%- endif -%}
 </button>
 {%- endfor -%}
 </div>
 {%- endif -%}
 </div>
 </div>{%- comment -%} /.pph__gallery-sticky {%- endcomment -%}
 </div>

 {%- comment -%} SUMMARY COLUMN {%- endcomment -%}
 <div class="pph__col pph__col--summary" data-pph-summary>
 <div class="pph__head">
 {%- if s.eyebrow != blank -%}
 <p class="uc-sec__eyebrow pph__eyebrow">{{ s.eyebrow | escape }}</p>
 {%- elsif s.show_vendor and product.vendor != blank -%}
 <a class="pph__vendor" href="{{ product.vendor | url_for_vendor | default: '#' }}">{{ product.vendor }}</a>
 {%- endif -%}

 <h1 class="pph__title" itemprop="name">{{ product.title }}</h1>

 {%- if s.show_rating and rating_value != blank -%}
 <a
 class="pph__rating pph__rating-link"
 href="{{ s.reviews_link | default: '#Upr' }}"
 data-pph-reviews-link
 data-review-source="{{ rating_source }}"
 {%- if uc_reviews_live -%}
 itemscope
 itemtype="https://schema.org/AggregateRating"
 {%- endif -%}
 >
 {%- if uc_reviews_live -%}
 <meta itemprop="ratingValue" content="{{ rating_value }}">
 <meta itemprop="bestRating" content="5">
 {%- endif -%}
 {%- assign pph_rating_label = 'Rated ' | append: rating_value | append: ' out of 5' -%}
 {%- render 'uc-star-rating', pct: rating_pct, class: 'pph__stars', label: pph_rating_label -%}
 <span class="pph__rating-value"{% if uc_reviews_live %} itemprop="ratingValue"{% endif %}>{{ rating_value }}</span>
 {%- if review_count != blank -%}
 <span class="pph__review-count">({{ review_count }}{% unless review_count contains 'review' %} reviews{% endunless %})</span>
 {%- endif -%}
 {%- if s.show_verified_badge and uc_reviews_live -%}
 <span class="pph__verified">
 {%- render 'uc-icon', icon: 'check', size: 12 -%}
 {{ s.verified_label | default: 'Verified buyers' | escape }}
 </span>
 {%- endif -%}
 </a>
 {%- endif -%}

 {%- if product_subtitle != blank -%}
 <p class="pph__subtitle">{{ product_subtitle | escape }}</p>
 {%- endif -%}
 </div>

 <div class="pph__price-block" data-pph-price>
 <span class="pph__price{% if on_sale %} pph__price--sale{% endif %}" data-pph-current-price>
 {{ cv.price | money }}
 </span>
 {%- if on_sale -%}
 <s class="pph__compare" data-pph-compare-price>{{ cv.compare_at_price | money }}</s>
 <span class="pph__save-badge" data-pph-save-badge>-{{ save_pct }}%</span>
 {%- else -%}
 <s class="pph__compare" data-pph-compare-price hidden></s>
 <span class="pph__save-badge" data-pph-save-badge hidden></span>
 {%- endif -%}
 </div>

 {%- if s.show_money_saved and on_sale -%}
 <p class="pph__save-line" data-pph-save-line>
 {{ s.money_saved_label | default: 'You save' | escape }}
 <strong data-pph-save-amount>{{ save_amount | money }}</strong>
 </p>
 {%- elsif s.show_money_saved -%}
 <p class="pph__save-line" data-pph-save-line hidden></p>
 {%- endif -%}

 {%- if s.installment_text != blank -%}
 <p class="pph__installment">{{ s.installment_text | escape }}</p>
 {%- endif -%}

 {%- if s.tax_info != blank -%}
 <p class="pph__tax-info">{{ s.tax_info | escape }}</p>
 {%- endif -%}

 {%- if s.show_stock_line -%}
 <p class="pph__stock" data-pph-stock aria-live="polite">
 {%- if cv.available -%}
 {%- if s.show_badge_lowstock and cv.inventory_quantity <= s.lowstock_threshold and cv.inventory_quantity > 0 -%}
 <span class="pph__stock--low">{{ s.low_stock_line | default: 'Only a few left in stock' | escape }}</span>
 {%- else -%}
 <span class="pph__stock--in">{{ s.in_stock_line | default: 'In stock - ready to ship' | escape }}</span>
 {%- endif -%}
 {%- else -%}
 <span class="pph__stock--out">{{ s.out_of_stock_line | default: 'Currently out of stock' | escape }}</span>
 {%- endif -%}
 </p>
 {%- endif -%}

 {%- if highlight_blocks.size > 0 -%}
 <ul class="pph__highlights" role="list" aria-label="Product highlights">
 {%- for block in highlight_blocks -%}
 <li class="pph__highlight" {{ block.shopify_attributes }}>
 {%- render 'uc-icon', icon: block.settings.icon, size: 14 -%}
 <span>{{ block.settings.text | escape }}</span>
 </li>
 {%- endfor -%}
 </ul>
 {%- endif -%}

 <div class="pph__buy-cluster" data-pph-buy-cluster>
 {%- render 'uc-pph-purchase-panel', product: product, section_settings: s, cv: cv, form_id: form_id -%}
 </div>

 <div class="pph__post-buy">
 {%- if trust_blocks.size > 0 -%}
 <div class="pph__trust-bar" aria-label="Product trust points">
 <ul class="pph__trust" role="list">
 {%- for block in trust_blocks -%}
 <li class="pph__trust-item" {{ block.shopify_attributes }} role="listitem">
 {%- render 'uc-icon', icon: block.settings.icon, size: 18 -%}
 <span class="pph__trust-copy">
 <strong class="pph__trust-label">{{ block.settings.label | escape }}</strong>
 {%- if block.settings.description != blank -%}
 <span class="pph__trust-desc">{{ block.settings.description | escape }}</span>
 {%- endif -%}
 </span>
 </li>
 {%- endfor -%}
 </ul>
 </div>
 {%- endif -%}

 {%- comment -%} Delivery cards {%- endcomment -%}
 {%- if delivery_blocks.size > 0 -%}
 <div class="pph__delivery" role="list" aria-label="Purchase reassurance">
 {%- for block in delivery_blocks -%}
 <div class="pph__delivery-card" {{ block.shopify_attributes }} role="listitem">
 <span class="pph__delivery-icon">
 {%- render 'uc-icon', icon: block.settings.icon, size: 22 -%}
 </span>
 <div class="pph__delivery-text">
 <strong class="pph__delivery-heading">{{ block.settings.heading | escape }}</strong>
 <span class="pph__delivery-body">{{ block.settings.description | escape }}</span>
 </div>
 </div>
 {%- endfor -%}
 </div>
 {%- endif -%}

 {%- if benefit_blocks.size > 0 and s.show_benefits_grid -%}
 <div class="pph__benefits-wrap">
 {%- if s.benefits_heading != blank -%}
 <p class="pph__section-label">{{ s.benefits_heading | escape }}</p>
 {%- endif -%}
 <ul class="pph__benefits" role="list">
 {%- for block in benefit_blocks limit: 4 -%}
 <li class="pph__benefit" {{ block.shopify_attributes }}>
 {%- render 'uc-icon', icon: block.settings.icon, size: 16 -%}
 <span class="pph__benefit-copy">
 <strong class="pph__benefit-title">{{ block.settings.title | default: block.settings.text | escape }}</strong>
 {%- if block.settings.description != blank -%}
 <span class="pph__benefit-desc">{{ block.settings.description | escape }}</span>
 {%- endif -%}
 </span>
 </li>
 {%- endfor -%}
 </ul>
 </div>
 {%- endif -%}

 </div>{%- comment -%} /.pph__post-buy {%- endcomment -%}

 </div>

 </div>
</section>

{%- comment -%} Product data island  -  lets JS update prices and availability without extra fetches {%- endcomment -%}
<script type="application/json" id="pph-data-{{ uid }}">
 {
 "productId": {{ product.id | json }},
 "lowStockThreshold": {{ s.lowstock_threshold | default: 5 }},
 "moneyFormat": {{ shop.money_format | json }},
 "inStockLine": {{ s.in_stock_line | default: 'In stock - ready to ship' | json }},
 "lowStockLine": {{ s.low_stock_line | default: 'Only a few left in stock' | json }},
 "outOfStockLine": {{ s.out_of_stock_line | default: 'Currently out of stock' | json }},
 "moneySavedLabel": {{ s.money_saved_label | default: 'You save' | json }},
 "options": {{ product.options | json }},
 "variants": [
 {%- for v in product.variants -%}
 {
 "id": {{ v.id }},
 "available": {{ v.available | json }},
 "options": {{ v.options | json }},
 "price": {{ v.price | money | json }},
 "comparePrice": {{ v.compare_at_price | money | json }},
 "priceRaw": {{ v.price }},
 "comparePriceRaw": {{ v.compare_at_price | default: 0 }},
 "saveAmountRaw": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price }}{% else %}0{% endif %},
 "featuredMediaId": {{ v.featured_media.id | json }},
 "inventoryQuantity": {{ v.inventory_quantity | default: 0 }}
 }{% unless forloop.last %},{% endunless %}
 {%- endfor -%}
 ],
 "media": [
 {%- for m in product.media -%}
 {
 "id": {{ m.id }},
 "type": {{ m.media_type | json }},
 "variantIds": {{ m.variant_ids | json }}
 }{% unless forloop.last %},{% endunless %}
 {%- endfor -%}
 ]
 }
</script>

<script src="{{ 'premium-product-hero.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
 "name": "Premium Product Hero",
 "tag": "section",
 "class": "section section-premium-product-hero",
 "enabled_on": {
 "templates": ["product"]
 },
 "max_blocks": 32,
 "settings": [
 { "type": "header", "content": "Content" },
 { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "UNIK CARE HAIR COLOUR", "info": "Shown above the product title. Leave blank to show vendor instead." },
 { "type": "text", "id": "subtitle", "label": "Short description fallback", "default": "Beautiful colour without the complicated routine.", "info": "Used when the product has no description and no custom.subtitle metafield. Each product's own description is shown automatically when this is cleared in the editor." },
 { "type": "checkbox", "id": "show_vendor", "label": "Show brand / vendor when eyebrow is empty", "default": true },
 { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
 { "type": "text", "id": "rating_value", "label": "Rating value (e.g. 4.8)", "default": "4.8" },
 { "type": "text", "id": "review_count", "label": "Review count display text", "default": "1,240 reviews" },
 { "type": "checkbox", "id": "show_verified_badge", "label": "Show verified buyers badge", "default": true },
 { "type": "text", "id": "verified_label", "label": "Verified badge label", "default": "Verified buyers" },
 { "type": "text", "id": "reviews_link", "label": "Reviews anchor link", "default": "#ProductTestimonials", "info": "Scroll target for rating link. Use section id prefix, e.g. #ProductTestimonials" },
 { "type": "color", "id": "star_color", "label": "Star colour", "default": "#f5a623" },
 { "type": "text", "id": "tax_info", "label": "Tax / shipping note", "default": "Taxes and shipping calculated at checkout." },
 { "type": "text", "id": "installment_text", "label": "Payment installment text" },
 { "type": "checkbox", "id": "show_money_saved", "label": "Show money saved line", "default": true },
 { "type": "text", "id": "money_saved_label", "label": "Money saved label", "default": "You save" },
 { "type": "checkbox", "id": "show_stock_line", "label": "Show stock status line", "default": true },
 { "type": "text", "id": "in_stock_line", "label": "In stock message", "default": "In stock - ready to ship" },
 { "type": "text", "id": "low_stock_line", "label": "Low stock message", "default": "Only a few left in stock" },
 { "type": "text", "id": "out_of_stock_line", "label": "Out of stock message", "default": "Currently out of stock" },

 { "type": "header", "content": "Highlights and variants" },
 { "type": "checkbox", "id": "use_benefits_as_highlights", "label": "Use Benefit blocks as hero highlight chips", "default": true },
 { "type": "checkbox", "id": "show_benefits_grid", "label": "Show separate benefits grid below delivery", "default": false },
 {
 "type": "select",
 "id": "variant_style",
 "label": "Colour / shade selector style",
 "default": "cards",
 "options": [
 { "value": "cards", "label": "Premium swatch cards" },
 { "value": "pills", "label": "Classic pills" }
 ]
 },

 { "type": "header", "content": "Gallery" },
 { "type": "checkbox", "id": "enable_thumbnails", "label": "Show thumbnails", "default": true },
 { "type": "checkbox", "id": "show_image_counter", "label": "Show image counter", "default": true },
 { "type": "checkbox", "id": "enable_hover_zoom", "label": "Hover zoom (desktop)", "default": true },
 { "type": "range", "id": "gallery_col_width", "label": "Gallery column width (desktop)", "min": 40, "max": 52, "step": 1, "unit": "%", "default": 50 },
 {
 "type": "select",
 "id": "gallery_aspect_ratio",
 "label": "Main image aspect ratio",
 "default": "1 / 1",
 "options": [
 { "value": "1 / 1", "label": "Square" },
 { "value": "4 / 5", "label": "Portrait 4:5" },
 { "value": "3 / 4", "label": "Portrait 3:4" }
 ]
 },
 {
 "type": "select",
 "id": "gallery_image_fit",
 "label": "Product image fit",
 "default": "cover",
 "options": [
 { "value": "contain", "label": "Contain (larger product)" },
 { "value": "cover", "label": "Cover (fill frame)" }
 ]
