{%- comment -%}
 ============================================================================
 PRODUCT FAQ
 ----
 Premium FAQ with search, category tabs/chips, animated accordion (one open),
 and optional "Still need help?" support card.

 Reuses: uc-design-tokens.css, uc-components.css, uc-icon.liquid.
 Adds: product-faq.css, product-faq.js.
 CSS prefix: pfaq-
 ============================================================================
{%- endcomment -%}
{{ 'product-faq.css' | asset_url | stylesheet_tag }}

{%- liquid
 assign s = section.settings
 assign uid = section.id
 assign faq_blocks = section.blocks | where: 'type', 'faq_item'
 assign support_blocks = section.blocks | where: 'type', 'support_link'

 assign categories = ''
 for block in faq_blocks
 assign cat = block.settings.category | strip | downcase
 unless cat == blank or categories contains cat
 assign categories = categories | append: cat | append: '|'
 endunless
 endfor
 assign category_array = categories | split: '|'
-%}

{%- assign uc_sec_scope = '#ProductFAQ-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #ProductFAQ-{{ uid }} {
 --pfaq-pad-top: {{ s.padding_top | default: 28 }}px;
 --pfaq-pad-bottom: {{ s.padding_bottom | default: 28 }}px;
 }
 {%- if s.accent_color != blank -%}
 #ProductFAQ-{{ uid }} { --pfaq-accent: {{ s.accent_color }}; }
 {%- endif -%}
 {%- if s.background_color != blank -%}
 #ProductFAQ-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="ProductFAQ-{{ uid }}"
 class="pfaq uc-sec color-{{ s.color_scheme }}"
 data-pfaq-section
>
 <div class="pfaq__inner uc-sec__container">

 {%- comment -%} Section header {%- endcomment -%}
 {%- if template.suffix == 'contact' -%}
 {% render 'uc-subpage-section-head',
 eyebrow: s.eyebrow,
 heading: s.heading,
 description: s.subtitle,
 align: 'center',
 header_class: 'pfaq__header',
 reveal: true
 %}
 {%- elsif template.name == 'product' -%}
 {% render 'uc-subpage-section-head',
 eyebrow: s.eyebrow,
 heading: s.heading,
 description: s.subtitle,
 align: 'center',
 header_class: 'pfaq__header',
 reveal: true
 %}
 {%- else -%}
 <header class="pfaq__header">
 <div class="pfaq__header-text">
 {%- if s.eyebrow != blank -%}
 <p class="pfaq__eyebrow">{{ s.eyebrow | escape }}</p>
 {%- endif -%}
 {%- if s.heading != blank -%}
 <h2 class="pfaq__heading uc-sec__heading">{{ s.heading | escape }}</h2>
 {%- endif -%}
 {%- if s.subtitle != blank -%}
 <p class="pfaq__subtitle">{{ s.subtitle | escape }}</p>
 {%- endif -%}
 </div>
 </header>
 {%- endif -%}

 {%- comment -%} Search input {%- endcomment -%}
 {%- if s.show_search -%}
 <div class="pfaq__search-wrap">
 <label for="pfaq-search-{{ uid }}" class="visually-hidden">{{ s.search_placeholder | default: 'Search questionsâ€¦' | escape }}</label>
 <span class="pfaq__search-icon" aria-hidden="true">
 {%- render 'uc-icon', icon: 'search', size: 16 -%}
 </span>
 <input
 type="search"
 id="pfaq-search-{{ uid }}"
 class="pfaq__search"
 data-pfaq-search
 placeholder="{{ s.search_placeholder | default: 'Search questionsâ€¦' | escape }}"
 autocomplete="off"
 spellcheck="false"
 aria-label="{{ s.search_placeholder | default: 'Search questions' | escape }}"
 >
 <button type="button" class="pfaq__search-clear" data-pfaq-clear hidden aria-label="Clear search">
 {%- render 'uc-icon', icon: 'x', size: 15 -%}
 </button>
 </div>
 {%- endif -%}
 </header>

 {%- if faq_blocks.size > 0 -%}
 {%- comment -%} Category tabs (desktop) / chips (mobile) {%- endcomment -%}
 {%- if category_array.size > 1 -%}
 <div class="pfaq__cats" role="group" aria-label="FAQ categories" data-pfaq-cats>
 <button
 class="pfaq__cat is-active"
 type="button"
 data-pfaq-cat="all"
 >All</button>
 {%- for cat in category_array -%}
 {%- if cat != blank -%}
 <button
 class="pfaq__cat"
 type="button"
 data-pfaq-cat="{{ cat | escape }}"
 >{{ cat | capitalize | escape }}</button>
 {%- endif -%}
 {%- endfor -%}
 </div>
 {%- endif -%}

 {%- comment -%} Empty state (shown by JS when no results) {%- endcomment -%}
 <p class="pfaq__empty" data-pfaq-empty hidden role="status" aria-live="polite">
 {{ s.empty_label | default: 'No questions match your search.' | escape }}
 </p>

 {%- comment -%} FAQ accordion list {%- endcomment -%}
 <div
 class="pfaq__items"
 id="pfaq-items-{{ uid }}"
 data-pfaq-items
 >
 {%- for block in faq_blocks -%}
 {%- assign cat_lower = block.settings.category | strip | downcase -%}
 <div
 class="pfaq__item"
 data-pfaq-item
 data-pfaq-category="{{ cat_lower | escape }}"
 data-pfaq-question="{{ block.settings.question | downcase | strip | escape }}"
 data-pfaq-answer="{{ block.settings.answer | strip_html | downcase | truncate: 500 | escape }}"
 {{ block.shopify_attributes }}
 >
 <button
 class="pfaq__trigger"
 type="button"
 aria-expanded="false"
 aria-controls="pfaq-body-{{ uid }}-{{ forloop.index }}"
 id="pfaq-trigger-{{ uid }}-{{ forloop.index }}"
 >
 {%- if block.settings.icon != blank -%}
 <span class="pfaq__trigger-icon" aria-hidden="true">
 {%- render 'uc-icon', icon: block.settings.icon, size: 18 -%}
 </span>
 {%- endif -%}
 <span class="pfaq__trigger-text">{{ block.settings.question | escape }}</span>
 <span class="pfaq__chevron" aria-hidden="true">
 {%- render 'uc-icon', icon: 'chevron-down', size: 18 -%}
 </span>
 </button>

 <div
 class="pfaq__body"
 id="pfaq-body-{{ uid }}-{{ forloop.index }}"
 aria-hidden="true"
 role="region"
 aria-labelledby="pfaq-trigger-{{ uid }}-{{ forloop.index }}"
 >
 <div class="pfaq__body-inner rte">
 {{ block.settings.answer }}
 </div>
 </div>
 </div>
 {%- endfor -%}
 </div>

 {%- if s.show_view_all and s.view_all_label != blank -%}
 <div class="pfaq__footer" data-uc-reveal>
 <a class="uc-btn uc-btn--secondary" href="{{ s.view_all_url | default: '/pages/faq' }}">
 {{ s.view_all_label | escape }}
 </a>
 </div>
 {%- endif -%}

 {%- comment -%} Support card {%- endcomment -%}
 {%- if s.show_support_card and support_blocks.size > 0 -%}
 <div class="pfaq__support">
 {%- if s.support_heading != blank -%}
 <h3 class="pfaq__support-heading">{{ s.support_heading | escape }}</h3>
 {%- endif -%}
 {%- if s.support_subtitle != blank -%}
 <p class="pfaq__support-subtitle">{{ s.support_subtitle | escape }}</p>
 {%- endif -%}
 <div class="pfaq__support-links">
 {%- for block in support_blocks -%}
 <a
 href="{{ block.settings.link | default: '#' }}"
 class="pfaq__support-btn pfaq__support-btn--{{ block.settings.type | default: 'chat' }} uc-btn uc-btn--glass"
 {%- if block.settings.type == 'email' %} target="_blank" rel="noopener"{%- endif -%}
 {%- if block.settings.type == 'whatsapp' %} target="_blank" rel="noopener"{%- endif -%}
 {{ block.shopify_attributes }}
 >
 <span class="pfaq__support-btn-icon" aria-hidden="true">
 {%- case block.settings.type -%}
 {%- when 'phone' -%}{%- render 'uc-icon', icon: 'phone', size: 18 -%}
 {%- when 'email' -%}{%- render 'uc-icon', icon: 'mail', size: 18 -%}
 {%- when 'chat' -%}{%- render 'uc-icon', icon: 'message-circle', size: 18 -%}
 {%- when 'whatsapp' -%}
 <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 0C5.373 0 0 5.373 0 12c0 2.125.553 4.118 1.516 5.851L.057 23.856a.52.52 0 0 0 .638.638l6.044-1.47A11.956 11.956 0 0 0 12.001 24C18.629 24 24 18.627 24 12S18.629 0 12.001 0zm0 21.818a9.817 9.817 0 0 1-5.009-1.37l-.358-.213-3.72.905.923-3.635-.235-.372A9.82 9.82 0 0 1 2.182 12c0-5.413 4.406-9.818 9.819-9.818S21.818 6.587 21.818 12 17.412 21.818 12 21.818z"/></svg>
 {%- else -%}{%- render 'uc-icon', icon: 'message-circle', size: 18 -%}
 {%- endcase -%}
 </span>
 {{ block.settings.label | escape }}
 </a>
 {%- endfor -%}
 </div>
 </div>
 {%- endif -%}
 {%- endif -%}

 </div>
</section>

<script src="{{ 'product-faq.js' | asset_url }}" defer="defer"></script>

{%- render 'uc-faq-schema', blocks: section.blocks -%}

{% schema %}
{
 "name": "UC FAQ",
 "tag": "section",
 "class": "section section-product-faq",
 "max_blocks": 40,
 "settings": [
 { "type": "header", "content": "Section header" },
 { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Got questions?" },
 { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
 { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Everything you need to know before you buy." },

 { "type": "header", "content": "Search" },
 { "type": "checkbox", "id": "show_search", "label": "Show search input", "default": true },
 { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search questionsâ€¦" },
 { "type": "text", "id": "empty_label", "label": "No results message", "default": "No questions match your search." },

 { "type": "header", "content": "View all link" },
 { "type": "checkbox", "id": "show_view_all", "label": "Show link to full FAQ page", "default": false },
 { "type": "text", "id": "view_all_label", "label": "View all button label", "default": "View all FAQs" },
 { "type": "url", "id": "view_all_url", "label": "Full FAQ page URL" },

 { "type": "header", "content": "Support card" },
 { "type": "checkbox", "id": "show_support_card", "label": "Show support card", "default": true },
 { "type": "text", "id": "support_heading", "label": "Support heading", "default": "Still need help?" },
 { "type": "text", "id": "support_subtitle", "label": "Support subtitle", "default": "Our team is available 24 / 7 to answer your questions." },

 { "type": "header", "content": "Layout" },
 { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
 { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },

 { "type": "header", "content": "UC - Responsive spacing" },
 { "type": "range", "id": "pad_top_lg", "label": "Top padding - laptop (990px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
 { "type": "range", "id": "pad_top_xxl", "label": "Top padding - large desktop (1440px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
 { "type": "range", "id": "container_max_lg", "label": "Container max width - laptop+", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
 { "type": "select", "id": "container_mode", "label": "Container", "default": "boxed", "options": [{"value":"boxed","label":"Boxed"},{"value":"full","label":"Full width"}] },
 { "type": "header", "content": "Typography — sizes by device" },
 { "type": "paragraph", "content": "Set font sizes per breakpoint. Values apply immediately (no override checkbox required)." },
 { "type": "range", "id": "eyebrow_size_xs", "label": "Eyebrow / pill label — mobile", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
 { "type": "range", "id": "eyebrow_size_md", "label": "Eyebrow / pill label — tablet (750px+)", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
 { "type": "range", "id": "eyebrow_size_lg", "label": "Eyebrow / pill label — laptop (990px+)", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 },
 { "type": "range", "id": "eyebrow_size_xxl", "label": "Eyebrow / pill label — large desktop", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 },
 { "type": "range", "id": "h_size_xs", "label": "Heading — mobile", "min": 18, "max": 56, "step": 1, "unit": "px", "default": 24 },
 { "type": "range", "id": "h_size_md", "label": "Heading — tablet (750px+)", "min": 18, "max": 64, "step": 1, "unit": "px", "default": 26 },
 { "type": "range", "id": "h_size_lg", "label": "Heading — laptop (990px+)", "min": 20, "max": 64, "step": 1, "unit": "px", "default": 30 },
 { "type": "range", "id": "h_size_xxl", "label": "Heading — large desktop", "min": 20, "max": 72, "step": 1, "unit": "px", "default": 32 },
 { "type": "range", "id": "sub_size_xs", "label": "Subheading — mobile", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 16 },
 { "type": "range", "id": "sub_size_md", "label": "Subheading — tablet", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 17 },
 { "type": "range", "id": "sub_size_lg", "label": "Subheading — laptop+", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 18 },
 { "type": "range", "id": "sub_size_xxl", "label": "Subheading — large desktop", "min": 12, "max": 44, "step": 1, "unit": "px", "default": 18 },
 { "type": "range", "id": "desc_size_xs", "label": "Description — mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 },
 { "type": "range", "id": "desc_size_md", "label": "Description — tablet", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
 { "type": "range", "id": "desc_size_lg", "label": "Description — laptop+", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
 { "type": "range", "id": "desc_size_xxl", "label": "Description — large desktop", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 16 },
 { "type": "range", "id": "btn_size_xs", "label": "Button / pill text — mobile", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
 { "type": "range", "id": "btn_size_md", "label": "Button / pill text — tablet", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
 { "type": "range", "id": "btn_size_lg", "label": "Button / pill text — laptop+", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
 { "type": "range", "id": "btn_size_xxl", "label": "Button / pill text — large desktop", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
 { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
 { "type": "color", "id": "background_color", "label": "Background override" },
 { "type": "color", "id": "accent_color", "label": "Accent colour override" }
 ],
 "blocks": [
 {
 "type": "faq_item",
 "name": "FAQ Item",
 "settings": [
 { "type": "text", "id": "category", "label": "Category (for tab filtering)", "default": "General" },
 { "type": "text", "id": "icon", "label": "Lucide icon name (optional)" },
 { "type": "text", "id": "question", "label": "Question", "default": "Is this product suitable for all hair types?" },
 { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes, our formula has been tested on all hair types including straight, wavy, curly, and coily. It is suitable for both men and women.</p>" }
 ]
 },
 {
 "type": "support_link",
 "name": "Support Link",
 "settings": [
 { "type": "select", "id": "type", "label": "Channel type", "options": [{"value": "chat", "label": "Live Chat"}, {"value": "whatsapp", "label": "WhatsApp"}, {"value": "email", "label": "Email"}, {"value": "phone", "label": "Phone"}], "default": "chat" },
 { "type": "text", "id": "label", "label": "Button label", "default": "Live Chat" },
 { "type": "url", "id": "link", "label": "Link" }
 ]
 }
 ],
 "presets": [
 {
 "name": "FAQ",
 "blocks": [
 { "type": "faq_item", "settings": { "category": "Product", "question": "How quickly will I see results?", "answer": "<p>Most customers notice a visible improvement within the first 2 - 3 applications. For optimal coverage results, we recommend 3 consistent applications within the first two weeks.</p>" } },
 { "type": "faq_item", "settings": { "category": "Product", "question": "Is the formula safe for daily use?", "answer": "<p>Yes, the formula is ammonia-free and enriched with natural ingredients. It is gentle enough for regular use without causing damage to hair structure.</p>" } },
 { "type": "faq_item", "settings": { "category": "Product", "question": "Does it cover grey hair completely?", "answer": "<p>Our premium formula delivers up to 100% grey hair coverage in a single application when used as directed. For stubborn or heavily grey areas, a second application within the same session is recommended.</p>" } },
 { "type": "faq_item", "settings": { "category": "Shipping", "question": "How long does delivery take?", "answer": "<p>Standard delivery takes 3 - 5 business days across Pakistan. Express delivery (1 - 2 days) is available at checkout. All orders above Rs. 2,000 qualify for free shipping.</p>" } },
 { "type": "faq_item", "settings": { "category": "Shipping", "question": "Do you ship internationally?", "answer": "<p>Currently we ship across Pakistan and to select international destinations. International shipping times vary by location  -  typically 7 - 14 business days.</p>" } },
 { "type": "faq_item", "settings": { "category": "Returns", "question": "What is your return policy?", "answer": "<p>We offer a 30-day money back guarantee. If you are not completely satisfied with your purchase for any reason, contact our support team and we will arrange a full refund  -  no questions asked.</p>" } },
 { "type": "support_link", "settings": { "type": "whatsapp", "label": "WhatsApp Us", "link": "https://wa.me/923001234567" } },
 { "type": "support_link", "settings": { "type": "email", "label": "Email Support", "link": "mailto:support@yourbrand.com" } }
 ]
 },
 {
 "name": "Content - FAQ (search and categories)",
 "settings": {
 "eyebrow": "Help centre",
 "heading": "Frequently asked questions",
 "subtitle": "Search or browse by category - we are here to help.",
 "show_search": true,
 "show_support_card": true
 }
 }
 ]
}
{% endschema %}
