{%- comment -%}
  Online Homes Store — soft announcement bar for baby toys storefront.
{%- endcomment -%}
{{ 'ohs-brand-override.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

{%- if section.blocks.size > 0 -%}
  <div class="ohs-announce" role="region" aria-label="Announcements" style="{% if s.background != blank %}background:{{ s.background }};{% endif %}{% if s.text_color != blank %}color:{{ s.text_color }};{% endif %}">
    <div class="ohs-announce__track page-width">
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "OHS Announcement Bar",
  "class": "ohs-announcement-section",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F5EE" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#777D78" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Thoughtful toys for growing minds." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OHS Announcement Bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Discover something special for little ones." } },
        { "type": "announcement", "settings": { "text": "Thoughtful toys for growing minds." } },
        { "type": "announcement", "settings": { "text": "Explore our latest arrivals." } }
      ]
    }
  ]
}
{% endschema %}
