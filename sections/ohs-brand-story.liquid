{%- comment -%}
  Brand story — colorful mission panel without invented claims.
{%- endcomment -%}
{{ 'ohs-brand-override.css' | asset_url | stylesheet_tag }}
{{ 'ohs-playful-home.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<section class="ohs-section ohs-story" id="OhsStory-{{ section.id }}" style="{% if s.background != blank %}background:{{ s.background }};{% endif %}">
  <div class="ohs-section__inner">
    <div class="ohs-story__panel">
      <div>
        {%- if s.eyebrow != blank -%}<p class="ohs-section__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ohs-section__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.body != blank -%}
          <div class="ohs-section__desc">{{ s.body }}</div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="ohs-story__points">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <li {{ block.shopify_attributes }}>
                  <span class="ohs-story__dot" aria-hidden="true"></span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="ohs-btn ohs-btn--primary" href="{{ s.button_link | default: routes.root_url }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="ohs-story__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 800px) 40vw, 100vw', alt: s.heading }}
        {%- else -%}
          {% render 'ohs-asset-img', file: 'ohs-hero-2.jpg', alt: s.heading, class: 'ohs-story__img' %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OHS Brand Story",
  "tag": "section",
  "class": "ohs-brand-story",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR MISSION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Little Play Goes a Long Way." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Online Homes Store is a cheerful home for thoughtfully chosen baby toys, playful gifts and everyday discoveries that help little ones explore the world with joy.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "About Us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F5F1E8" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Story point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Curated toys for curious little minds." }
      ]
    }
  ],
  "presets": [
    {
      "name": "OHS Brand Story",
      "blocks": [
        { "type": "point", "settings": { "text": "Playful finds for every growing stage." } },
        { "type": "point", "settings": { "text": "Simple shopping made for busy parents." } },
        { "type": "point", "settings": { "text": "Secure checkout with helpful support." } }
      ]
    }
  ]
}
{% endschema %}
