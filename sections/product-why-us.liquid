{%- comment -%}
 ============================================================================
 WHY CHOOSE US  -  PRODUCT COMPARISON + TRUST STATS
 ----
 Original section showing a modern comparison between our brand and generic
 alternatives. Two elegant cards side-by-side + animated stat counters.

 Reuses: uc-design-tokens.css, uc-components.css, uc-icon.liquid.
 New: product-why-us.css, product-why-us.js (count-up + reveal, ~75 lines).

 Two block types:
 comparison_row  -  rendered in BOTH the "ours" and "others" card
 stat  -  rendered in the stats strip below
 ============================================================================
{%- endcomment -%}
{{ 'product-why-us.css' | asset_url | stylesheet_tag }}

{%- liquid
 assign s = section.settings
 assign uid = section.id
 assign comparison_blocks = section.blocks | where: 'type', 'comparison_row'
 assign stat_blocks = section.blocks | where: 'type', 'stat'
-%}

{%- assign uc_sec_scope = '#WhyChooseUs-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #WhyChooseUs-{{ uid }} {
 --pwu-pad-top: {{ s.padding_top | default: 64 }}px;
 --pwu-pad-bottom: {{ s.padding_bottom | default: 64 }}px;
 --pwu-card-radius: {{ s.card_radius | default: 24 }}px;
 }
 {%- if s.background_color != blank -%}
 #WhyChooseUs-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
 {%- if s.accent_color != blank -%}
 #WhyChooseUs-{{ uid }} { --pwu-accent: {{ s.accent_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="WhyChooseUs-{{ uid }}"
 class="pwu uc-sec color-{{ s.color_scheme }}"
 data-pwu-section
>
 <div class="pwu__inner uc-sec__container">

 {%- comment -%} Section header {%- endcomment -%}
 <header class="pwu__header pwu__header--{{ s.heading_alignment | default: 'center' }}">
 {%- if s.eyebrow != blank -%}
 <p class="pwu__eyebrow">{{ s.eyebrow | escape }}</p>
 {%- endif -%}
 {%- if s.heading != blank -%}
 <h2 class="pwu__heading uc-sec__heading">{{ s.heading | escape }}</h2>
 {%- endif -%}
 {%- if s.subtitle != blank -%}
 <p class="pwu__subtitle">{{ s.subtitle | escape }}</p>
 {%- endif -%}
 </header>

 {%- comment -%} Comparison cards {%- endcomment -%}
 {%- if comparison_blocks.size > 0 -%}
 <div class="pwu__comparison" role="group" aria-label="Brand comparison">

 {%- comment -%} Our Brand card (left, premium styled) {%- endcomment -%}
 <div class="pwu__card pwu__card--ours">
 <div class="pwu__card-header">
 {%- if s.our_logo != blank -%}
 {%- assign pwu_logo_alt = s.our_brand_name | default: 'Our Brand' | escape -%}
 {{
 s.our_logo
 | image_url: width: 120
 | image_tag: class: 'pwu__brand-logo', loading: 'lazy', alt: pwu_logo_alt
 }}
 {%- endif -%}
 <h3 class="pwu__brand-name pwu__brand-name--ours">{{ s.our_brand_name | default: 'Our Brand' | escape }}</h3>
 <span class="pwu__brand-badge">{%- render 'uc-icon', icon: 'check', size: 12 -%} Recommended</span>
 </div>

 <div class="pwu__rows" role="list" aria-label="{{ s.our_brand_name | default: 'Our brand' | escape }} features">
 {%- for block in comparison_blocks -%}
 <div class="pwu__row pwu__row--ours" role="listitem" {{ block.shopify_attributes }}>
 <span class="pwu__feature">{{ block.settings.feature | escape }}</span>
 <div class="pwu__row-right">
 {%- if block.settings.our_check -%}
 <span class="pwu__icon pwu__icon--check" aria-label="Yes">
 {%- render 'uc-icon', icon: 'check', size: 16 -%}
 </span>
 {%- else -%}
 <span class="pwu__icon pwu__icon--cross" aria-label="No">
 {%- render 'uc-icon', icon: 'x', size: 16 -%}
 </span>
 {%- endif -%}
 {%- if block.settings.our_detail != blank -%}
 <span class="pwu__detail">{{ block.settings.our_detail | escape }}</span>
 {%- endif -%}
 </div>
 </div>
 {%- endfor -%}
 </div>
 </div>

 {%- comment -%} Others card (right, neutral/muted) {%- endcomment -%}
 <div class="pwu__card pwu__card--others">
 <div class="pwu__card-header">
 <h3 class="pwu__brand-name pwu__brand-name--others">{{ s.others_name | default: 'Other Brands' | escape }}</h3>
 </div>

 <div class="pwu__rows" role="list" aria-label="{{ s.others_name | default: 'Other brands' | escape }} features">
 {%- for block in comparison_blocks -%}
 <div class="pwu__row pwu__row--others" role="listitem">
 <span class="pwu__feature">{{ block.settings.feature | escape }}</span>
 <div class="pwu__row-right">
 {%- if block.settings.others_check -%}
 <span class="pwu__icon pwu__icon--check pwu__icon--muted" aria-label="Yes">
 {%- render 'uc-icon', icon: 'check', size: 16 -%}
 </span>
 {%- else -%}
 <span class="pwu__icon pwu__icon--cross" aria-label="No">
 {%- render 'uc-icon', icon: 'x', size: 16 -%}
 </span>
 {%- endif -%}
 {%- if block.settings.other_detail != blank -%}
 <span class="pwu__detail">{{ block.settings.other_detail | escape }}</span>
 {%- endif -%}
 </div>
 </div>
 {%- endfor -%}
 </div>
 </div>
 </div>
 {%- endif -%}

 {%- comment -%} Trust statistics strip {%- endcomment -%}
 {%- if stat_blocks.size > 0 -%}
 {%- if s.stats_heading != blank -%}
 <p class="pwu__stats-label">{{ s.stats_heading | escape }}</p>
 {%- endif -%}
 <div class="pwu__stats" data-pwu-stats role="list" aria-label="Trust statistics">
 {%- for block in stat_blocks -%}
 <div class="pwu__stat" role="listitem" {{ block.shopify_attributes }}>
 <span
 class="pwu__stat-number"
 data-count="{{ block.settings.number }}"
 data-prefix="{{ block.settings.prefix | escape }}"
 data-suffix="{{ block.settings.suffix | escape }}"
 >{{ block.settings.prefix | escape }}{{ block.settings.number | escape }}{{ block.settings.suffix | escape }}</span>
 <span class="pwu__stat-label">{{ block.settings.label | escape }}</span>
 </div>
 {%- endfor -%}
 </div>
 {%- endif -%}

 </div>
</section>

<script src="{{ 'product-why-us.js' | asset_url }}" defer="defer"></script>

