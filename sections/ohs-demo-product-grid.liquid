{%- comment -%}
  Homepage product grid — uses the same uc-product-card as collection/search/PDP.
{%- endcomment -%}
{{ 'ohs-brand-override.css' | asset_url | stylesheet_tag }}
{{ 'ohs-theme.css' | asset_url | stylesheet_tag }}
{{ 'ohs-playful-home.css' | asset_url | stylesheet_tag }}
{{ 'uc-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'uc-product-card.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign use_live = false
  if collection != blank and collection.products_count > 0
    assign use_live = true
  endif
-%}

<section class="ohs-section ohs-demo-grid" id="OhsDemoGrid-{{ section.id }}" style="{% if s.background != blank %}background:{{ s.background }};{% endif %}">
  <div class="ohs-section__inner">
    <header class="ohs-section__head ohs-demo-grid__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="ohs-section__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ohs-section__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.description != blank -%}<p class="ohs-section__desc">{{ s.description | escape }}</p>{%- endif -%}
      </div>
      {%- if s.view_all_label != blank -%}
        <a class="ohs-demo-grid__viewall" href="{{ s.view_all_link | default: routes.all_products_collection_url }}">{{ s.view_all_label | escape }}</a>
      {%- endif -%}
    </header>

    <div class="ohs-demo-grid__grid" style="--ohs-cols: {{ s.columns_desktop | default: 4 }};">
      {%- if use_live -%}
        {%- for product in collection.products limit: s.products_to_show -%}
          {% render 'uc-product-card',
            product: product,
            image_ratio: 'square',
            show_rating: true,
            show_quick_add: true,
            show_vendor: false,
            lazy: true,
            section_id: section.id,
            card_index: forloop.index
          %}
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks limit: s.products_to_show -%}
          {%- assign b = block.settings -%}
          {%- comment -%} Editorial fallback when no live collection products {%- endcomment -%}
          <article class="pc-card pc-card--static" {{ block.shopify_attributes }}>
            <div class="pc-card__media-wrap pc-card__media--square">
              <a class="pc-card__media" href="{{ b.link | default: routes.all_products_collection_url }}">
                {%- if b.image != blank -%}
                  {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 22vw, 45vw', alt: b.title }}
                {%- else -%}
                  {% render 'ohs-asset-img', file: b.asset_file, alt: b.title %}
                {%- endif -%}
              </a>
              {%- if b.badge != blank -%}
                <div class="pc-card__badges"><span class="pc-badge pc-badge--custom">{{ b.badge | escape }}</span></div>
              {%- endif -%}
            </div>
            <div class="pc-card__info">
              <a class="pc-card__title-link" href="{{ b.link | default: routes.all_products_collection_url }}">
                <h3 class="pc-card__title">{{ b.title | escape }}</h3>
              </a>
              <div class="pc-card__rating" aria-hidden="true">
                <span class="pc-card__stars">★★★★★</span>
                <span class="pc-card__rating-value">4.8</span>
                <span class="pc-card__rating-count">(22)</span>
              </div>
              <div class="pc-card__meta">
                <div class="pc-card__price-row">
                  {%- if b.compare_price != blank -%}<s class="pc-card__price pc-card__price--compare">{{ b.compare_price | escape }}</s>{%- endif -%}
                  <span class="pc-card__price">{{ b.price | escape }}</span>
                </div>
                <span class="pc-card__stock pc-card__stock--in"><span class="pc-card__stock-dot"></span>In stock</span>
              </div>
              <div class="pc-card__actions">
                <a class="pc-card__btn pc-card__btn--add" href="{{ b.link | default: routes.all_products_collection_url }}" aria-label="View {{ b.title | escape }}">
                  <span class="pc-card__btn-icon" aria-hidden="true">{% render 'uc-icon', icon: 'shopping-cart', size: 18 %}</span>
                </a>
                <a class="pc-card__btn pc-card__btn--buy" href="{{ b.link | default: routes.all_products_collection_url }}">
                  <span class="pc-card__btn-text">Buy Now</span>
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallbacks = 'Rainbow Stack Rings|ohs-prod-1.jpg|£28.00,Soft Cloud Bear|ohs-prod-2.jpg|£32.00,Wooden Block Set|ohs-prod-3.jpg|£36.00,Sensory Ball Duo|ohs-prod-4.jpg|£22.00' | split: ',' -%}
        {%- for item in fallbacks limit: s.products_to_show -%}
          {%- assign parts = item | split: '|' -%}
          <article class="pc-card pc-card--static">
            <div class="pc-card__media-wrap pc-card__media--square">
              <a class="pc-card__media" href="{{ routes.all_products_collection_url }}">
                {% render 'ohs-asset-img', file: parts[1], alt: parts[0] %}
              </a>
            </div>
            <div class="pc-card__info">
              <a class="pc-card__title-link" href="{{ routes.all_products_collection_url }}">
                <h3 class="pc-card__title">{{ parts[0] | escape }}</h3>
              </a>
              <div class="pc-card__rating" aria-hidden="true">
                <span class="pc-card__stars">★★★★★</span>
                <span class="pc-card__rating-value">4.8</span>
                <span class="pc-card__rating-count">(22)</span>
              </div>
              <div class="pc-card__meta">
                <div class="pc-card__price-row"><span class="pc-card__price">{{ parts[2] | escape }}</span></div>
                <span class="pc-card__stock pc-card__stock--in"><span class="pc-card__stock-dot"></span>In stock</span>
              </div>
              <div class="pc-card__actions">
                <a class="pc-card__btn pc-card__btn--add" href="{{ routes.all_products_collection_url }}" aria-label="Shop {{ parts[0] | escape }}">
                  <span class="pc-card__btn-icon" aria-hidden="true">{% render 'uc-icon', icon: 'shopping-cart', size: 18 %}</span>
                </a>
                <a class="pc-card__btn pc-card__btn--buy" href="{{ routes.all_products_collection_url }}">
                  <span class="pc-card__btn-text">Buy Now</span>
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OHS Product Grid",
  "tag": "section",
  "class": "ohs-demo-product-grid",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BEST SELLERS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little Favorites. Big Smiles!" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover some of our most-loved playtime picks." },
    { "type": "collection", "id": "collection", "label": "Live collection (used when it has products)" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Columns desktop", "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F7FBF8" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Demo product",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Soft Cloud Plush" },
        { "type": "text", "id": "price", "label": "Price", "default": "£24.00" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "asset_file", "label": "Fallback asset filename", "default": "ohs-prod-1.jpg" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "OHS Product Grid" }]
}
{% endschema %}
