{%- comment -%}
  Product grid for Online Homes Store.
  Uses a real collection when products exist; otherwise curated editorial cards from theme assets.
{%- endcomment -%}
{{ 'ohs-brand-override.css' | asset_url | stylesheet_tag }}
{{ 'ohs-playful-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign use_live = false
  if collection != blank and collection.products_count > 0
    assign use_live = true
  endif
-%}

<section class="ohs-section ohs-demo-grid" id="OhsDemoGrid-{{ section.id }}" style="{% if s.background != blank %}background:{{ s.background }};{% endif %}">
  <div class="ohs-section__inner">
    <header class="ohs-section__head ohs-demo-grid__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="ohs-section__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ohs-section__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.description != blank -%}<p class="ohs-section__desc">{{ s.description | escape }}</p>{%- endif -%}
      </div>
      {%- if s.view_all_label != blank -%}
        <a class="ohs-demo-grid__viewall" href="{{ s.view_all_link | default: routes.all_products_collection_url }}">{{ s.view_all_label | escape }}</a>
      {%- endif -%}
    </header>

    <div class="ohs-demo-grid__grid" style="--ohs-cols: {{ s.columns_desktop | default: 4 }};">
      {%- if use_live -%}
        {%- for product in collection.products limit: s.products_to_show -%}
          <article class="ohs-demo-card">
            <div class="ohs-demo-card__media-wrap">
              {%- if product.compare_at_price > product.price -%}
                <span class="ohs-demo-card__badge">Sale</span>
              {%- endif -%}
              <a class="ohs-demo-card__media" href="{{ product.url }}">
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 22vw, 45vw', alt: product.title }}
                {%- else -%}
                  {% render 'ohs-asset-img', file: 'ohs-prod-1.jpg', alt: product.title, class: 'ohs-demo-card__img' %}
                {%- endif -%}
              </a>
            </div>
            <div class="ohs-demo-card__body">
              <h3 class="ohs-demo-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="ohs-demo-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                {{ product.price | money }}
              </p>
              {%- if product.available -%}
                <form method="post" action="{{ routes.cart_add_url }}" class="ohs-demo-card__form">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="ohs-demo-card__btn">Add to cart</button>
                </form>
              {%- else -%}
                <span class="ohs-demo-card__btn ohs-demo-card__btn--disabled">Sold out</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks limit: s.products_to_show -%}
          {%- assign b = block.settings -%}
          <article class="ohs-demo-card" {{ block.shopify_attributes }}>
            <div class="ohs-demo-card__media-wrap">
              {%- if b.badge != blank -%}<span class="ohs-demo-card__badge">{{ b.badge | escape }}</span>{%- endif -%}
              <a class="ohs-demo-card__media" href="{{ b.link | default: routes.all_products_collection_url }}">
                {%- if b.image != blank -%}
                  {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 22vw, 45vw', alt: b.title }}
                {%- else -%}
                  {% render 'ohs-asset-img', file: b.asset_file, alt: b.title, class: 'ohs-demo-card__img' %}
                {%- endif -%}
              </a>
            </div>
            <div class="ohs-demo-card__body">
              <h3 class="ohs-demo-card__title"><a href="{{ b.link | default: routes.all_products_collection_url }}">{{ b.title | escape }}</a></h3>
              <p class="ohs-demo-card__price">
                {%- if b.compare_price != blank -%}<s>{{ b.compare_price | escape }}</s>{%- endif -%}
                {{ b.price | escape }}
              </p>
              <a class="ohs-demo-card__btn" href="{{ b.link | default: routes.all_products_collection_url }}">View product</a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Hard fallback so the section never collapses to a blank band {%- endcomment -%}
        {%- assign fallbacks = 'Rainbow Stack Rings|ohs-prod-1.jpg|$28.00,Soft Cloud Bear|ohs-prod-2.jpg|$32.00,Wooden Block Set|ohs-prod-3.jpg|$36.00,Sensory Ball Duo|ohs-prod-4.jpg|$22.00,Musical Xylophone|ohs-prod-5.jpg|$34.00,Shape Sorter Box|ohs-prod-6.jpg|$29.00,Activity Cube|ohs-prod-7.jpg|$39.00,Plush Bunny|ohs-prod-8.jpg|$26.00' | split: ',' -%}
        {%- for item in fallbacks limit: s.products_to_show -%}
          {%- assign parts = item | split: '|' -%}
          <article class="ohs-demo-card">
            <div class="ohs-demo-card__media-wrap">
              <a class="ohs-demo-card__media" href="{{ routes.all_products_collection_url }}">
                {% render 'ohs-asset-img', file: parts[1], alt: parts[0], class: 'ohs-demo-card__img' %}
              </a>
            </div>
            <div class="ohs-demo-card__body">
              <h3 class="ohs-demo-card__title"><a href="{{ routes.all_products_collection_url }}">{{ parts[0] | escape }}</a></h3>
              <p class="ohs-demo-card__price">{{ parts[2] | escape }}</p>
              <a class="ohs-demo-card__btn" href="{{ routes.all_products_collection_url }}">Shop toys</a>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OHS Product Grid",
  "tag": "section",
  "class": "ohs-demo-product-grid",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BEST SELLERS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little Favorites. Big Smiles!" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover some of our most-loved playtime picks." },
    { "type": "collection", "id": "collection", "label": "Live collection (used when it has products)" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Columns desktop", "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFDF7" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Demo product",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Soft Cloud Plush" },
        { "type": "text", "id": "price", "label": "Price", "default": "$24.00" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "asset_file", "label": "Fallback asset filename", "default": "ohs-prod-1.jpg" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "OHS Product Grid" }]
}
{% endschema %}
