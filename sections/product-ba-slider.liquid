 { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Real customers. Drag the slider to reveal the difference." },
 {
 "type": "select", "id": "heading_alignment", "label": "Header alignment", "default": "center",
 "options": [
 { "value": "left", "label": "Left" },
 { "value": "center", "label": "Center" },
 { "value": "right", "label": "Right" }
 ]
 },

 { "type": "header", "content": "Layout" },
 { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
 { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
 { "type": "range", "id": "card_gap", "label": "Gap between cards", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 20 },
 { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
 { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 14 },
 { "type": "range", "id": "caption_blur", "label": "Caption glass blur", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 16 },

 { "type": "header", "content": "Images" },
 {
 "type": "select", "id": "image_aspect", "label": "Aspect ratio", "default": "1-1",
 "info": "Square 1:1 recommended for product before/after uploads.",
 "options": [
 { "value": "7-8", "label": "Portrait 1400×1600 (7:8)" },
 { "value": "3-4", "label": "Portrait (3:4)" },
 { "value": "4-5", "label": "Portrait (4:5)" },
 { "value": "1-1", "label": "Square (1:1)" },
 { "value": "4-3", "label": "Landscape (4:3)" },
 { "value": "3-2", "label": "Landscape (3:2)" },
 { "value": "16-9", "label": "Wide (16:9)" },
 { "value": "custom", "label": "Custom height" }
 ]
 },
 { "type": "range", "id": "image_height", "label": "Custom height (if aspect = Custom)", "min": 240, "max": 680, "step": 20, "unit": "px", "default": 420 },
