{%- comment -%}
 ============================================================================
 PRODUCT BEFORE and AFTER SLIDER
 ----
 Product-page adaptation of the homepage Before and After section.

 REUSE STRATEGY (zero code duplication):
  Loads before-after-comparison.css -> 100% comparison widget CSS
  Loads before-after-comparison.js -> the existing IIFE scans for .ba
 elements and inits each one. Each carousel slide contains a .ba element,
 so every comparison gets the full drag/touch/keyboard/rAF behavior.
  Adds product-ba-slider.css for the carousel wrapper + caption card
  Adds product-ba-slider.js for carousel arrow navigation (~45 lines)

 Reuse bridge: each .pba__ba element has class="ba" so the existing JS
 auto-discovers and initialises it. No JS modifications required.
 ============================================================================
{%- endcomment -%}
{{ 'before-after-comparison.css' | asset_url | stylesheet_tag }}
{{ 'product-ba-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
 assign s = section.settings
 assign uid = section.id

 assign btn_class = 'uc-btn--premium'
 case s.button_style
 when 'secondary'
 assign btn_class = 'uc-btn--secondary'
 when 'ghost'
 assign btn_class = 'uc-btn--ghost'
 when 'glass'
 assign btn_class = 'uc-btn--glass'
 endcase
-%}

{%- assign uc_sec_scope = '#ProductBASlider-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #ProductBASlider-{{ uid }} {
 --pba-pad-top: {{ s.padding_top | default: 56 }}px;
 --pba-pad-bottom: {{ s.padding_bottom | default: 56 }}px;
 --pba-gap: {{ s.card_gap | default: 20 }}px;
 --pba-radius: {{ s.card_radius | default: 20 }}px;
 --pba-img-radius: {{ s.image_radius | default: 14 }}px;
 --pba-caption-blur: {{ s.caption_blur | default: 16 }}px;

 /* Pass through to existing BA CSS variables */
 --ba-divider-width: {{ s.divider_width | default: 3 }}px;
 --ba-divider-color: {{ s.divider_color | default: '#ffffff' }};
 --ba-handle-size: {{ s.handle_size | default: 44 }}px;
 --ba-handle-color: {{ s.handle_color | default: '#ffffff' }};
 --ba-handle-icon-color: {{ s.handle_icon_color | default: '#111111' }};
 --ba-handle-border: {{ s.handle_border | default: 2 }}px;
 --ba-anim: {{ s.animation_speed | default: 300 }}ms;
 --ba-label-bg: {{ s.label_background | default: 'rgba(17,17,17,0.55)' }};
 --ba-label-color: {{ s.label_color | default: '#ffffff' }};
 --ba-label-radius: 100px;
 --ba-img-radius: {{ s.image_radius | default: 14 }}px;
 {%- if s.image_aspect != 'custom' -%}
 --ba-aspect: {{ s.image_aspect | default: '7-8' | replace: '-', ' / ' }};
 {%- endif -%}
 --ba-img-height: {{ s.image_height | default: 420 }}px;
 }
 {%- if s.background_color != blank -%}
 #ProductBASlider-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="ProductBASlider-{{ uid }}"
 class="pba uc-sec color-{{ s.color_scheme }}"
 data-pba-section
>
 <div class="pba__inner uc-sec__container">

 {%- comment -%} Section header {%- endcomment -%}
 {%- if s.eyebrow != blank or s.heading != blank or s.subtitle != blank -%}
 <header class="pba__header pba__header--{{ s.heading_alignment | default: 'center' }}">
 {%- if s.eyebrow != blank -%}
 <p class="uc-sec__eyebrow pba__eyebrow">{{ s.eyebrow | escape }}</p>
 {%- endif -%}
 {%- if s.heading != blank -%}
 <h2 class="pba__heading uc-sec__heading">{{ s.heading | escape }}</h2>
 {%- endif -%}
 {%- if s.subtitle != blank -%}
 <p class="pba__subtitle">{{ s.subtitle | escape }}</p>
 {%- endif -%}
 </header>
 {%- endif -%}

 {%- if section.blocks.size > 0 -%}
 <div class="pba__viewport">
 {%- if s.show_arrows and section.blocks.size > 1 -%}
 <button type="button" class="pba__arrow pba__arrow--prev" data-pba-prev aria-label="Previous comparison">
 <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
 </button>
 <button type="button" class="pba__arrow pba__arrow--next" data-pba-next aria-label="Next comparison">
 <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
 </button>
 {%- endif -%}

 <ul
 class="pba__track"
 data-pba-track
 role="list"
 aria-label="{{ s.heading | default: 'Before and after transformations' | escape }}"
 >
 {%- for block in section.blocks -%}
 {%- liquid
 assign b = block.settings
 assign before_img = b.before_image
 assign after_img = b.after_image
 -%}

 <li
 class="pba__slide"
 data-pba-slide
 {{ block.shopify_attributes }}
 >
 {%- comment -%}
 .ba class triggers the existing before-after-comparison.js.
 It finds [data-ba-compare] inside and initialises drag/touch/keyboard.
 ba--reveal triggers the existing scroll reveal animation.
 {%- endcomment -%}
 <div class="ba pba__ba{% if s.enable_reveal %} ba--reveal{% endif %}">
 <div
 class="ba__compare"
 data-ba-compare
 data-start="{{ b.initial_position | default: 50 }}"
 style="--ba-object-fit: {{ b.object_fit | default: 'cover' }};{% if s.image_aspect != 'custom' %} --ba-aspect: {{ s.image_aspect | default: '7-8' | replace: '-', ' / ' }};{% else %} --ba-img-height: {{ s.image_height | default: 420 }}px;{% endif %}"
 {% if s.image_aspect == 'custom' %}data-ba-custom-height="true"{% endif %}
 role="slider"
 tabindex="0"
 aria-label="{{ b.a11y_label | default: 'Before and after comparison. Use arrow keys to reveal.' | escape }}"
 aria-valuemin="0"
 aria-valuemax="100"
 aria-valuenow="{{ b.initial_position | default: 50 }}"
 >
 {%- comment -%} AFTER layer (base, full width) {%- endcomment -%}
 <div class="ba__layer ba__layer--after">
 {%- if after_img != blank -%}
 {%- assign ba_after_alt = b.after_alt | default: 'After' | escape -%}
 {{
 after_img
 | image_url: width: 1200
 | image_tag:
 class: 'ba__img',
 loading: 'lazy',
 widths: '480, 720, 960, 1200',
 sizes: '(min-width: 990px) 45vw, 92vw',
 alt: ba_after_alt
 }}
 {%- else -%}
 {{ 'lifestyle-2' | placeholder_svg_tag: 'ba__img ba__img--placeholder' }}
 {%- endif -%}
 {%- if s.show_labels -%}
 <span class="ba__label ba__label--bottom-right">{{ b.after_text | default: 'After' | escape }}</span>
 {%- endif -%}
 </div>

 {%- comment -%} BEFORE layer (clipped top) {%- endcomment -%}
 <div class="ba__layer ba__layer--before" data-ba-before>
 {%- if before_img != blank -%}
 {%- assign ba_before_alt = b.before_alt | default: 'Before' | escape -%}
 {{
 before_img
 | image_url: width: 1200
 | image_tag:
 class: 'ba__img',
 loading: 'lazy',
 widths: '480, 720, 960, 1200',
 sizes: '(min-width: 990px) 45vw, 92vw',
 alt: ba_before_alt
 }}
 {%- else -%}
 {{ 'lifestyle-1' | placeholder_svg_tag: 'ba__img ba__img--placeholder' }}
 {%- endif -%}
 {%- if s.show_labels -%}
 <span class="ba__label ba__label--bottom-left">{{ b.before_text | default: 'Before' | escape }}</span>
 {%- endif -%}
 </div>

 {%- comment -%} Divider + handle {%- endcomment -%}
 <div class="ba__divider" data-ba-divider aria-hidden="true">
 <button type="button" class="ba__handle" data-ba-handle tabindex="-1" aria-hidden="true">
 <svg class="ba__handle-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5"/><path d="m15 7 5 5-5 5"/></svg>
 </button>
 </div>
 </div>
 </div>

 {%- comment -%} Caption card below each comparison {%- endcomment -%}
 {%- if b.customer_name != blank or b.duration != blank or b.quote != blank -%}
 <div class="pba__caption">
 <div class="pba__caption-meta">
 {%- if b.customer_name != blank -%}
 <strong class="pba__customer">{{ b.customer_name | escape }}</strong>
 {%- endif -%}
 {%- if b.duration != blank -%}
 <span class="pba__duration">{{ b.duration | escape }}</span>
 {%- endif -%}
 </div>
 {%- if b.quote != blank -%}
 <p class="pba__quote">&ldquo;{{ b.quote | escape }}&rdquo;</p>
 {%- endif -%}
 {%- if b.button_label != blank -%}
 <a href="{{ b.button_link | default: '#' }}" class="uc-btn {{ btn_class }} pba__cta-btn">
 {{ b.button_label | escape }}
 </a>
 {%- endif -%}
 </div>
 {%- endif -%}
 </li>
 {%- endfor -%}
 </ul>

 {%- if s.show_pagination and section.blocks.size > 1 -%}
 <div class="pba__progressbar" data-pba-progressbar aria-hidden="true">
 <span class="pba__progressbar-fill" data-pba-progressfill></span>
 </div>
 {%- endif -%}
 </div>
 {%- else -%}
 <div class="pba__empty">Add Before and After blocks to display comparison cards.</div>
 {%- endif -%}
 </div>
</section>

<script src="{{ 'before-after-comparison.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-ba-slider.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
 "name": "Product BA Slider",
 "tag": "section",
 "class": "section section-product-ba-slider",
 "max_blocks": 12,
 "settings": [
 { "type": "header", "content": "Section header" },
