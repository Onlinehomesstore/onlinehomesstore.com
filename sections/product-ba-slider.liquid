 { "type": "color", "id": "label_background", "label": "Label background", "default": "#000000" },
 { "type": "color", "id": "label_color", "label": "Label text colour", "default": "#ffffff" },

 { "type": "header", "content": "Comparison slider" },
 { "type": "range", "id": "animation_speed", "label": "Handle animation speed", "min": 100, "max": 600, "step": 50, "unit": "ms", "default": 300 },
 { "type": "range", "id": "divider_width", "label": "Divider width", "min": 1, "max": 10, "step": 1, "unit": "px", "default": 3 },
 { "type": "color", "id": "divider_color", "label": "Divider colour", "default": "#ffffff" },
 { "type": "range", "id": "handle_size", "label": "Handle size", "min": 32, "max": 72, "step": 4, "unit": "px", "default": 44 },
 { "type": "color", "id": "handle_color", "label": "Handle background", "default": "#ffffff" },
 { "type": "color", "id": "handle_icon_color", "label": "Handle icon colour", "default": "#111111" },
 { "type": "range", "id": "handle_border", "label": "Handle border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 2 },

 { "type": "header", "content": "Slider navigation" },
 { "type": "checkbox", "id": "show_arrows", "label": "Show prev/next arrows", "default": true },
 { "type": "checkbox", "id": "show_pagination", "label": "Show progress bar", "default": true },
 { "type": "checkbox", "id": "enable_reveal", "label": "Scroll reveal animation", "default": true },

 { "type": "header", "content": "CTA button" },
 {
 "type": "select", "id": "button_style", "label": "Button style", "default": "primary",
 "options": [
 { "value": "primary", "label": "Primary" },
 { "value": "secondary", "label": "Secondary" },
 { "value": "ghost", "label": "Ghost" }
 ]
 },

 { "type": "header", "content": "UC - Responsive spacing" },
 { "type": "range", "id": "pad_top_lg", "label": "Top padding - laptop (990px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
 { "type": "range", "id": "pad_top_xxl", "label": "Top padding - large desktop (1440px+)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
 { "type": "range", "id": "container_max_lg", "label": "Container max width - laptop+", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
 { "type": "select", "id": "container_mode", "label": "Container", "default": "boxed", "options": [{"value":"boxed","label":"Boxed"},{"value":"full","label":"Full width"}] },
 { "type": "header", "content": "Typography — sizes by device" },
 { "type": "paragraph", "content": "Set font sizes per breakpoint. Values apply immediately (no override checkbox required)." },
 { "type": "range", "id": "eyebrow_size_xs", "label": "Eyebrow / pill label — mobile", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
 { "type": "range", "id": "eyebrow_size_md", "label": "Eyebrow / pill label — tablet (750px+)", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
 { "type": "range", "id": "eyebrow_size_lg", "label": "Eyebrow / pill label — laptop (990px+)", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 },
 { "type": "range", "id": "eyebrow_size_xxl", "label": "Eyebrow / pill label — large desktop", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 },
 { "type": "range", "id": "h_size_xs", "label": "Heading — mobile", "min": 18, "max": 56, "step": 1, "unit": "px", "default": 24 },
 { "type": "range", "id": "h_size_md", "label": "Heading — tablet (750px+)", "min": 18, "max": 64, "step": 1, "unit": "px", "default": 26 },
 { "type": "range", "id": "h_size_lg", "label": "Heading — laptop (990px+)", "min": 20, "max": 64, "step": 1, "unit": "px", "default": 30 },
 { "type": "range", "id": "h_size_xxl", "label": "Heading — large desktop", "min": 20, "max": 72, "step": 1, "unit": "px", "default": 32 },
 { "type": "range", "id": "sub_size_xs", "label": "Subheading — mobile", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 16 },
 { "type": "range", "id": "sub_size_md", "label": "Subheading — tablet", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 17 },
 { "type": "range", "id": "sub_size_lg", "label": "Subheading — laptop+", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 18 },
 { "type": "range", "id": "sub_size_xxl", "label": "Subheading — large desktop", "min": 12, "max": 44, "step": 1, "unit": "px", "default": 18 },
 { "type": "range", "id": "desc_size_xs", "label": "Description — mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 },
 { "type": "range", "id": "desc_size_md", "label": "Description — tablet", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
 { "type": "range", "id": "desc_size_lg", "label": "Description — laptop+", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
 { "type": "range", "id": "desc_size_xxl", "label": "Description — large desktop", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 16 },
 { "type": "range", "id": "btn_size_xs", "label": "Button / pill text — mobile", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
 { "type": "range", "id": "btn_size_md", "label": "Button / pill text — tablet", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
 { "type": "range", "id": "btn_size_lg", "label": "Button / pill text — laptop+", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
 { "type": "range", "id": "btn_size_xxl", "label": "Button / pill text — large desktop", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
 { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
 { "type": "color", "id": "background_color", "label": "Background override" }
 ],
 "blocks": [
 {
 "type": "comparison",
 "name": "Before and After",
 "settings": [
 { "type": "header", "content": "Images" },
 { "type": "image_picker", "id": "before_image", "label": "Before image", "info": "Recommended: 1400 × 1600 px" },
 { "type": "text", "id": "before_alt", "label": "Before alt text", "default": "Before" },
 { "type": "text", "id": "before_text", "label": "Before label text", "default": "Before" },
