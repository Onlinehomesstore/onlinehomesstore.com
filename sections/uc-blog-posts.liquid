{%- comment -%}
 UC Blog Posts - category-showcase style blog grid.
 Same header rhythm + image cards as Shop by category. Namespace: ubp
{%- endcomment -%}

{%- liquid
 assign s = section.settings
 assign uid = section.id
 assign blog = blogs[s.blog]
 assign limit = s.posts_count | default: 3
-%}

{%- assign uc_sec_scope = '#Ubp-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}

{%- style -%}
 #Ubp-{{ uid }} {
 --ubp-max: {% if s.full_width %}none{% else %}var(--page-width){% endif %};
 --ubp-cols: {{ s.columns | default: 3 }};
 --ubp-gap: {{ s.card_gap | default: 24 }}px;
 --ubp-radius: {{ s.card_radius | default: 22 }}px;
 --ubp-ratio: {{ s.image_ratio | default: '16 / 9' }};
 --ubp-pad-y: {{ s.padding_top | default: 56 }}px;
 --ubp-pad-b: {{ s.padding_bottom | default: 56 }}px;
 --ubp-accent: {{ s.accent_color | default: '#B68A35' }};
 --ubp-title-color: {{ s.heading_color | default: '#171717' }};
 --ubp-desc-color: {{ s.desc_color | default: '#5A5A5A' }};
 {%- if s.heading_color_mobile != blank -%}
 --ubp-title-color-mobile: {{ s.heading_color_mobile }};
 {%- endif -%}
 {%- if s.desc_color_mobile != blank -%}
 --ubp-desc-color-mobile: {{ s.desc_color_mobile }};
 {%- endif -%}
 }
 {%- if s.background_color != blank -%}#Ubp-{{ uid }} { background: {{ s.background_color }}; }{%- endif -%}
{%- endstyle -%}

<section id="Ubp-{{ uid }}" class="ubp uc-sec" data-uc-theme-text style="--uc-theme-heading: var(--ubp-title-color); --uc-theme-body: var(--ubp-desc-color);--uc-theme-heading-mobile: var(--ubp-title-color-mobile, var(--ubp-title-color));--uc-theme-body-mobile: var(--ubp-desc-color-mobile, var(--ubp-desc-color));">
 <div class="ubp__inner">
 {%- liquid
 assign btn_url = s.btn_link
 if btn_url == blank and blog != blank
 assign btn_url = blog.url
 endif
 assign header_btn_label = s.btn_label
 if template.name == 'blog' and blog != blank
 if btn_url == blank or btn_url == blog.url
 assign header_btn_label = ''
 endif
 endif
 -%}
 {% render 'uc-section-header',
 eyebrow: s.eyebrow,
 heading: s.heading,
 description: s.description,
 button_label: header_btn_label,
 button_link: btn_url,
 reveal: true
 %}

 {%- if blog != blank and blog.articles_count > 0 -%}
 <ul class="ubp__grid" role="list" data-uc-mobile-scroll>
 {%- for article in blog.articles limit: limit -%}
 <li class="ubp__item">
 <a class="ubp__card" href="{{ article.url }}" data-uc-reveal>
 <div class="ubp__media">
 {%- if article.image != blank -%}
 <img
 class="ubp__img"
 src="{{ article.image | image_url: width: 900 }}"
 srcset="{{ article.image | image_url: width: 480 }} 480w, {{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1200 }} 1200w"
 sizes="(min-width: 990px) 30vw, (min-width: 750px) 45vw, 85vw"
 width="{{ article.image.width }}"
 height="{{ article.image.height }}"
 loading="lazy"
 alt="{{ article.image.alt | default: article.title | escape }}"
 >
 {%- else -%}
 {{ 'image' | placeholder_svg_tag: 'ubp__img ubp__img--placeholder' }}
 {%- endif -%}
 <span class="ubp__shade" aria-hidden="true"></span>
 </div>
 <div class="ubp__content">
 {%- if s.show_date or s.show_reading_time -%}
 <p class="ubp__meta">
 {%- if s.show_date -%}<span>{{ article.published_at | date: '%b %d, %Y' }}</span>{%- endif -%}
 {%- if s.show_date and s.show_reading_time -%}<span class="ubp__dot">·</span>{%- endif -%}
 {%- if s.show_reading_time -%}<span>{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | at_least: 1 }} min</span>{%- endif -%}
 </p>
 {%- endif -%}
 <h3 class="ubp__title">{{ article.title | escape }}</h3>
 {%- if s.show_excerpt -%}
 <p class="ubp__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 16 }}</p>
 {%- endif -%}
 <span class="ubp__read">
 {{ s.read_more_label | default: 'Read more' | escape }}
 {% render 'uc-icon', icon: 'arrow-right', size: 14, stroke: 2 %}
 </span>
 </div>
 </a>
 </li>
 {%- endfor -%}
 </ul>
 {%- else -%}
 <ul class="ubp__grid" role="list" data-uc-mobile-scroll>
 {%- for block in section.blocks -%}
 {%- if block.type == 'featured' -%}
 <li class="ubp__item" {{ block.shopify_attributes }}>
 <a class="ubp__card" href="{{ block.settings.link | default: routes.root_url }}">
 <div class="ubp__media">
 {%- if block.settings.image != blank -%}
 <img class="ubp__img" src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="506">
 {%- else -%}
 {{ 'image' | placeholder_svg_tag: 'ubp__img ubp__img--placeholder' }}
 {%- endif -%}
 </div>
 <div class="ubp__content">
 {%- if block.settings.date != blank -%}
 <p class="ubp__meta"><span>{{ block.settings.date | escape }}</span></p>
 {%- endif -%}
 <h3 class="ubp__title">{{ block.settings.title | escape }}</h3>
 {%- if block.settings.excerpt != blank -%}
 <p class="ubp__excerpt">{{ block.settings.excerpt | escape }}</p>
 {%- endif -%}
 <span class="ubp__read">{{ s.read_more_label | default: 'Read article' | escape }} {% render 'uc-icon', icon: 'arrow-right', size: 14, stroke: 2 %}</span>
 </div>
 </a>
 </li>
 {%- endif -%}
 {%- endfor -%}
 </ul>
 {%- if section.blocks.size == 0 -%}
 <div class="ubp__empty">No articles yet. Check back soon for hair care tips and stories.</div>
 {%- endif -%}
 {%- endif -%}
 </div>
</section>

<style>
 .ubp { display: block; }
 .ubp .uc-sec__eyebrow,
 .ubp .category-showcase__label {
   display: inline-flex !important;
   align-items: center !important;
   width: fit-content !important;
   padding: 6px 14px !important;
   border-radius: var(--uc-radius-pill, 16px) !important;
   background: rgba(182, 138, 53, 0.12) !important;
   border: 1px solid rgba(182, 138, 53, 0.22) !important;
   font-size: 11px !important;
   font-weight: 700 !important;
   letter-spacing: 0.12em !important;
   text-transform: uppercase !important;
   color: #b68a35 !important;
   white-space: nowrap !important;
 }
 .ubp__inner {
 max-width: min(var(--ubp-max, var(--page-width)), 100%);
 margin-inline: auto;
 padding: var(--ubp-pad-y, 56px) clamp(20px, 3vw, 40px) var(--ubp-pad-b, 56px);
 box-sizing: border-box;
 }

 .ubp__grid {
 list-style: none;
 margin: 0;
 padding: 0;
 display: grid;
 grid-template-columns: repeat(var(--ubp-cols, 3), minmax(0, 1fr));
 gap: var(--ubp-gap, 24px);
 align-items: stretch;
 }
 .ubp__item { display: flex; min-height: 100%; }
 .ubp__card {
 position: relative;
 display: flex;
 flex-direction: column;
 width: 100%;
 overflow: hidden;
 border-radius: var(--ubp-radius, 22px);
 text-decoration: none;
 color: #171717;
 background: #fff;
 border: 1px solid rgba(230, 224, 214, 0.95);
 box-shadow: 0 10px 28px rgba(26, 22, 18, 0.05);
 isolation: isolate;
 transition: transform 0.28s var(--uc-ease-premium, cubic-bezier(0.22, 1, 0.36, 1)), box-shadow 0.28s ease;
 }
 .ubp__media {
 position: relative;
 aspect-ratio: var(--ubp-ratio, 16 / 9);
 overflow: hidden;
 background: #f3eee6;
 flex: 0 0 auto;
 min-height: 0;
 width: 100%;
 }
 .ubp__img {
 position: absolute;
 inset: 0;
 width: 100%;
 height: 100%;
 object-fit: cover;
 display: block;
 transition: transform 0.5s var(--uc-ease-premium, cubic-bezier(0.22, 1, 0.36, 1));
 }
 .ubp__img--placeholder,
 .ubp__media svg,
 .ubp__media .placeholder-svg {
 position: absolute;
 inset: 0;
 width: 100% !important;
 height: 100% !important;
 object-fit: cover;
 display: block;
 opacity: 0.35;
 }
 .ubp__shade { display: none; }
 .ubp__content {
 position: relative;
 z-index: 1;
 display: flex;
 flex-direction: column;
 justify-content: flex-start;
 gap: 12px;
 flex: 1 1 auto;
 padding: 22px 22px 24px;
 background: #fff;
 }
 .ubp__meta {
 display: flex;
 align-items: center;
 gap: 8px;
 margin: 0;
 font-size: 13px;
 font-weight: 600;
 letter-spacing: 0.08em;
 text-transform: uppercase;
 color: rgba(23, 23, 23, 0.5);
 }
 .ubp__dot { opacity: 0.6; }
 .ubp__title {
 font-family: var(--uc-font-heading, 'Manrope', sans-serif);
 font-size: clamp(17px, 16px + 0.3vw, 19px);
 font-weight: 650;
 line-height: 1.32;
 margin: 0;
 color: var(--ubp-title-color, #2a2a2a);
 }
 .ubp__excerpt {
 margin: 0;
 font-size: var(--uc-text-body, 17px);
 line-height: 1.6;
 color: rgba(23, 23, 23, 0.68);
 display: -webkit-box;
 -webkit-line-clamp: 2;
 -webkit-box-orient: vertical;
 overflow: hidden;
 }
 .ubp__read {
 display: inline-flex;
 align-items: center;
 gap: 6px;
 margin-top: auto;
 padding-top: 4px;
 font-weight: 600;
 font-size: 15px;
 color: var(--ubp-accent, #b68a35);
 }
 .ubp__read svg { transition: transform 0.25s ease; }
 .ubp__empty {
 text-align: center;
 padding: clamp(40px, 6vw, 64px) 24px;
 color: #2a2a2a;
 font-family: var(--uc-font-body, 'Manrope', sans-serif);
 font-size: 0.95rem;
 }

 @media (hover: hover) and (prefers-reduced-motion: no-preference) {
 .ubp__card:hover {
 transform: translateY(-4px);
 box-shadow: 0 18px 40px rgba(26, 22, 18, 0.1);
 }
 .ubp__card:hover .ubp__img { transform: scale(1.02); }
 .ubp__card:hover .ubp__read svg { transform: translateX(3px); }
 }
 @media (max-width: 990px) {
 .ubp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
 }
 @media (max-width: 640px) {
 .ubp__grid {
 grid-template-columns: none;
 display: flex;
 gap: 14px;
 overflow-x: auto;
 scroll-snap-type: x mandatory;
 padding-bottom: 6px;
 -webkit-overflow-scrolling: touch;
 }
 .ubp__item {
 flex: 0 0 min(78vw, 300px);
 scroll-snap-align: start;
 }
 }
</style>

{% schema %}
{
 "name": "Blog posts",
 "tag": "section",
 "class": "section section-uc-blog-posts",
 "settings": [
 { "type": "header", "content": "Heading" },
 { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get inspired" },
 { "type": "text", "id": "heading", "label": "Heading", "default": "Designed to inspire" },
 { "type": "text", "id": "description", "label": "Description", "default": "Explore tips and ideas crafted for you." },
 { "type": "range", "id": "h_size_xs", "label": "Heading — mobile", "min": 18, "max": 40, "step": 1, "unit": "px", "default": 24 },
 { "type": "range", "id": "h_size_lg", "label": "Heading — laptop (990px+)", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 30 },
 { "type": "range", "id": "h_size_xxl", "label": "Heading — large desktop", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 32 },
 { "type": "range", "id": "desc_size_xs", "label": "Description — mobile", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 15 },
 { "type": "range", "id": "desc_size_lg", "label": "Description — laptop", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 17 },

 { "type": "header", "content": "Content" },
 { "type": "blog", "id": "blog", "label": "Blog" },
 { "type": "range", "id": "posts_count", "min": 2, "max": 6, "step": 1, "label": "Posts to show", "default": 3 },
 { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
 { "type": "checkbox", "id": "show_reading_time", "label": "Show reading time", "default": true },
 { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
 { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Read more" },

 { "type": "header", "content": "Button" },
 { "type": "text", "id": "btn_label", "label": "Button label", "default": "Explore all" },
 { "type": "url", "id": "btn_link", "label": "Button link (defaults to blog)" },

 { "type": "header", "content": "Layout" },
 { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
 { "type": "range", "id": "container_width", "min": 900, "max": 1600, "step": 20, "unit": "px", "label": "Max width", "default": 1200 },
 { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 3 },
 { "type": "range", "id": "card_gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Card gap", "default": 24 },
 { "type": "range", "id": "card_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Card radius", "default": 18 },
 {
 "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "16 / 9",
 "options": [
 { "value": "16 / 9", "label": "Landscape 1920x1080" },
 { "value": "16 / 10", "label": "Landscape wide" },
 { "value": "4 / 5", "label": "Portrait" },
 { "value": "1 / 1", "label": "Square" },
 { "value": "3 / 4", "label": "Tall portrait" }
 ]
 },
 { "type": "range", "id": "overlay_strength", "min": 10, "max": 80, "step": 5, "unit": "%", "label": "Image overlay", "default": 45 },
 { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
 { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 },

 { "type": "header", "content": "Colors" },
 { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B68A35" },
 { "type": "color", "id": "heading_color", "label": "Heading colour (desktop)", "default": "#171717" },
 { "type": "color", "id": "desc_color", "label": "Text colour (desktop)", "default": "#5A5A5A" },
 { "type": "color", "id": "heading_color_mobile", "label": "Heading colour (mobile)" },
 { "type": "color", "id": "desc_color_mobile", "label": "Text colour (mobile)" },
 { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
 { "type": "color", "id": "background_color", "label": "Section background" }
 ],
 "presets": [{ "name": "Blog posts" }],
 "blocks": [
 {
 "type": "featured",
 "name": "Featured article",
 "settings": [
 { "type": "text", "id": "title", "label": "Title", "default": "How to choose the right hair colour shade" },
 { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "A practical guide to matching UNIK shades with your natural tone." },
 { "type": "url", "id": "link", "label": "Link" },
 { "type": "text", "id": "date", "label": "Date label", "default": "Aug 2026" },
 { "type": "image_picker", "id": "image", "label": "Image" }
 ]
 }
 ],
 "max_blocks": 6
}
{% endschema %}
