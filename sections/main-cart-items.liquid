{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'uc-cart-page.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if template.name == 'cart' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<cart-items
  class="gradient color-{{ section.settings.color_scheme }} isolate uc-cartx{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}"
  data-section-id="{{ section.id }}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="page-width uc-cartx__shell">
    <div class="uc-cartx__card">
      {%- unless cart == empty -%}
      <div class="title-wrapper-with-link uc-cartx__head">
        <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
        <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
          {{- 'general.continue_shopping' | t -}}
        </a>
      </div>
      {%- endunless -%}

      {%- if settings.uc_cart_free_shipping_enable and settings.uc_cart_free_shipping_threshold != blank and cart != empty -%}
        {%- assign fs_threshold = settings.uc_cart_free_shipping_threshold | times: 100 -%}
        {%- assign fs_remaining = fs_threshold | minus: cart.total_price -%}
        {%- assign fs_pct = cart.total_price | times: 100 | divided_by: fs_threshold -%}
        {%- if fs_pct > 100 -%}{%- assign fs_pct = 100 -%}{%- endif -%}
        <div class="uc-cart-page-shipping" data-uc-cart-shipping data-threshold="{{ fs_threshold }}" data-message="{{ settings.uc_cart_free_shipping_message | escape }}" data-success="{{ settings.uc_cart_free_shipping_success | escape }}" data-money-format="{{ shop.money_format | escape }}">
          <p class="uc-cart-page-shipping__text" data-uc-cart-shipping-text>
            {%- if fs_remaining <= 0 -%}
              {{ settings.uc_cart_free_shipping_success | default: 'You unlocked free shipping!' }}
            {%- else -%}
              {%- assign fs_amount = fs_remaining | money -%}
              {%- assign fs_msg = settings.uc_cart_free_shipping_message | default: 'Spend [amount] more for free shipping' -%}
              {{ fs_msg | replace: '[amount]', fs_amount }}
            {%- endif -%}
          </p>
          <div class="uc-cart-page-shipping__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ fs_pct }}">
            <span class="uc-cart-page-shipping__fill" data-uc-cart-shipping-fill style="width: {{ fs_pct }}%;"></span>
          </div>
        </div>
      {%- endif -%}

      <div class="cart__warnings uc-cartx__empty">
        <div class="uc-cartx__empty-hero">
          <div class="uc-cartx__empty-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/>
            </svg>
          </div>
          <p class="uc-cartx__empty-eyebrow">Your bag</p>
          <h1 class="cart__empty-text uc-cartx__empty-title">{{ 'sections.cart.empty' | t }}</h1>
          {%- if settings.uc_cart_empty_text != blank -%}
            <p class="uc-cartx__empty-lead">{{ settings.uc_cart_empty_text | escape }}</p>
          {%- endif -%}
          <div class="uc-cartx__empty-actions">
            <a href="{{ routes.all_products_collection_url }}" class="button uc-cartx__empty-cta">
              {{ 'general.continue_shopping' | t }}
            </a>
            {%- if pages.contact != blank -%}
              <a href="{{ pages.contact.url }}" class="uc-cartx__empty-link">Need help choosing?</a>
            {%- endif -%}
          </div>

          {%- if shop.customer_accounts_enabled and customer == null -%}
            <div class="uc-cartx__empty-login">
              <p class="cart__login-title">{{ 'sections.cart.login.title' | t }}</p>
              <p class="cart__login-paragraph">
                {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
              </p>
            </div>
          {%- endif -%}
        </div>
      </div>

      <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
        <div class="cart__items uc-cartx__items" id="main-cart-items" data-id="{{ section.id }}">
          <div class="js-contents">
            {%- if cart != empty -%}
              <div class="uc-cartx__labels" aria-hidden="true">
                <span>{{ 'sections.cart.headings.product' | t }}</span>
                <span>{{ 'sections.cart.headings.quantity' | t }}</span>
                <span>{{ 'sections.cart.headings.price' | t }}</span>
              </div>

              <ul class="uc-cartx__list" role="list">
                {%- for item in cart.items -%}
                  <li
                    class="cart-item uc-cartx__item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}"
                    id="CartItem-{{ item.index | plus: 1 }}"
                    {% if item.parent_relationship.parent != null %}
                      aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                    {% endif %}
                  >
                    <div class="uc-cartx__media">
                      {%- if item.image -%}
                        <a href="{{ item.url }}" class="uc-cartx__imglink" aria-hidden="true" tabindex="-1">
                          <img
                            src="{{ item.image | image_url: width: 300 }}"
                            class="cart-item__image"
                            alt="{{ item.image.alt | escape }}"
                            loading="lazy"
                            width="150"
                            height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        </a>
                      {%- endif -%}
                    </div>

                    <div class="uc-cartx__info">
                      <div class="uc-cartx__title">
                        <a href="{{ item.url }}" class="cart-item__name uc-cartx__name break">{{ item.product.title | escape }}</a>
                        {%- assign cart_disclosure_modal_id = 'CartDisclosureModal-cart-' | append: item.key | replace: ':', '-' -%}
                        {%- render 'cart-disclosure-indicator', product: item.product, modal_id: cart_disclosure_modal_id -%}
                      </div>

                      <div class="uc-cartx__unit-price">
                        {%- if item.original_price != item.final_price -%}
                          <span class="uc-cartx__each">{{ item.final_price | money }} each</span>
                          <s class="uc-cartx__each-old">{{ item.original_price | money }}</s>
                        {%- else -%}
                          <span class="uc-cartx__each">{{ item.original_price | money }}{% if item.quantity > 1 %} each{% endif %}</span>
                        {%- endif -%}
                      </div>

                      {%- if item.product.has_only_default_variant == false
                        or item.properties.size != 0
                        or item.selling_plan_allocation != null
                      -%}
                        <dl class="uc-cartx__opts">
                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                              <div class="product-option">
                                <dt>{{ option.name }}:</dt>
                                <dd>{{ option.value }}</dd>
                              </div>
                            {%- endfor -%}
                          {%- endif -%}

                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="product-option">
                                <dt>{{ property.first }}:</dt>
                                <dd>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" class="link" target="_blank">
                                      {{ property.last | split: '/' | last }}
                                    </a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </dl>

                        {%- if item.selling_plan_allocation.selling_plan.name != blank -%}
                          <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                        {%- endif -%}
                      {%- endif -%}

                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>

                      {%- if item.unit_price_measurement -%}
                        <div class="uc-cartx__unit">
                          {%- render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement -%}
                        </div>
                      {%- endif -%}

                      <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                        <small class="cart-item__error-text"></small>
                      </div>
                    </div>

                    <div class="uc-cartx__qty">
                      {%- render 'loading-spinner' -%}
                      <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                        {{ 'products.product.quantity.label' | t }}
                      </label>
                      {%- assign can_update_quantity = item.instructions.can_update_quantity | default: true -%}
                      <quantity-input class="quantity cart-quantity">
                        <button
                          class="quantity__button"
                          name="minus"
                          type="button"
                          {% if can_update_quantity == false %}disabled{% endif %}
                        >
                          <span class="visually-hidden">
                            {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                          </span>
                          <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                        </button>
                        <input
                          class="quantity__input"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          data-quantity-line-key="{{ item.key }}"
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          {% # theme-check-disable %}
                          data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                          min="{{ item.variant.quantity_rule.min | default: 0 }}"
                          data-min="{{ item.variant.quantity_rule.min | default: 0 }}"
                          {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                          step="{{ item.variant.quantity_rule.increment | default: 1 }}"
                          {% # theme-check-enable %}
                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                          id="Quantity-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                          {% if can_update_quantity == false %}disabled{% endif %}
                        >
                        <button
                          class="quantity__button"
                          name="plus"
                          type="button"
                          {% if can_update_quantity == false %}disabled{% endif %}
                        >
                          <span class="visually-hidden">
                            {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                          </span>
                          <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                        </button>
                      </quantity-input>
                    </div>

                    <div class="uc-cartx__price">
                      {%- if item.quantity > 1 -%}
                        <span class="uc-cartx__line-meta">{{ item.quantity }} &times; {{ item.final_price | money }}</span>
                      {%- endif -%}
                      {%- if item.original_line_price != item.final_line_price -%}
                        <dl class="cart-item__discounted-prices">
                          <dt class="visually-hidden">{{ 'sections.cart.headings.price' | t }}</dt>
                          <dd>
                            <s class="cart-item__old-price price price--end">{{ item.original_line_price | money }}</s>
                          </dd>
                          <dd class="price price--end uc-cartx__line-total">{{ item.final_line_price | money }}</dd>
                        </dl>
                      {%- else -%}
                        <span class="price price--end uc-cartx__line-total">{{ item.original_line_price | money }}</span>
                      {%- endif -%}
                    </div>

                    <cart-remove-button
                      id="Remove-{{ item.index | plus: 1 }}"
                      data-index="{{ item.index | plus: 1 }}"
                      class="uc-cartx__remove"
                      {%- assign can_remove = item.instructions.can_remove | default: true -%}
                      {% if can_remove == false %}hidden{% endif %}
                    >
                      <a
                        href="{{ item.url_to_remove }}"
                        class="button button--tertiary"
                        aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                      >
                        <span class="svg-wrapper">{{- 'icon-remove.svg' | inline_asset_content -}}</span>
                      </a>
                    </cart-remove-button>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>

        <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
        <p
          class="visually-hidden"
          id="shopping-cart-line-item-status"
          aria-live="polite"
          aria-hidden="true"
          role="status"
        >
          {{ 'accessibility.loading' | t }}
        </p>
      </form>
    </div>

  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
