{%- comment -%}
 Premium Product Showcase  -  luxury featured collection (OS 2.0 / Dawn)
 Original implementation. Uses UC Design System + native AJAX cart.
{%- endcomment -%}
{{ 'premium-product-showcase.css' | asset_url | stylesheet_tag }}
{{ 'uc-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'uc-product-card.js' | asset_url }}" defer="defer"></script>

<script src="{{ 'premium-product-showcase.js' | asset_url }}" defer="defer"></script>

{%- liquid
 assign s = section.settings
 assign uid = section.id

 assign cs_container = '1280px'
 unless s.full_width
 case s.container_width
 when 'narrow'
 assign cs_container = '1200px'
 when 'wide'
 assign cs_container = '1440px'
 else
 assign cs_container = '1280px'
 endcase
 else
 assign cs_container = 'none'
 endunless

 assign cs_card_shadow = 0
 if s.card_shadow
 assign cs_card_shadow = s.card_shadow_strength
 endif

 assign products_limit = s.products_to_show
 assign collection = s.collection
 assign products_count = 0
 if collection != blank
 assign products_count = collection.products_count
 endif
 assign more_in_collection = false
 if collection != blank and products_count > products_limit
 assign more_in_collection = true
 endif
-%}

{%- assign uc_sec_scope = '#PremiumShowcase-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #PremiumShowcase-{{ uid }} {
 --cs-cols-desktop: {{ s.columns_desktop }};
 --cs-cols-tablet: {{ s.columns_tablet }};
 --cs-cols-mobile: 1;
 --cs-gap: {{ s.grid_gap }}px;
 --cs-card-radius: {{ s.card_radius }}px;
 --cs-card-shadow: {{ cs_card_shadow }};
 --cs-pad-top: {{ s.padding_top }}px;
 --cs-pad-bottom: {{ s.padding_bottom }}px;
 --cs-container-max: {{ cs_container }};
 --pf-card-min-height: {% if s.card_min_height > 0 %}{{ s.card_min_height }}px{% else %}auto{% endif %};
 --pf-card-padding: {{ s.card_padding }}px;
 --pf-image-fit: {{ s.image_fit }};
 --pf-badge-bestseller-bg: {{ s.badge_bestseller_bg | default: settings.uc_color_primary }};
 --pf-badge-bestseller-fg: {{ s.badge_bestseller_text | default: '#ffffff' }};
 --pf-badge-new-bg: {{ s.badge_new_bg | default: 'rgba(182,138,53,0.12)' }};
 --pf-badge-new-fg: {{ s.badge_new_text | default: settings.uc_color_primary }};
 --pf-badge-sale-bg: {{ s.badge_sale_bg | default: settings.uc_color_sale_bg }};
 --pf-badge-sale-fg: {{ s.badge_sale_text | default: settings.uc_color_sale_text }};
 --pf-savings-color: {{ s.savings_color | default: settings.uc_color_success }};
 --pf-cta-bg: {{ s.button_bg | default: settings.uc_color_primary }};
 --pf-cta-text: {{ s.button_text_color | default: '#ffffff' }};
 --pf-cta-hover-bg: {{ s.button_hover_bg | default: settings.uc_color_primary_dark }};
 --pf-cta-hover-text: {{ s.button_hover_text | default: '#ffffff' }};
 }
 @media screen and (max-width: 749px) {
 #PremiumShowcase-{{ uid }} {
 --cs-pad-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
 --cs-pad-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
 }
 }
{%- endstyle -%}

<premium-product-showcase
 id="PremiumShowcase-{{ uid }}"
 class="category-showcase pf-showcase color-{{ s.color_scheme }} gradient"
 data-header-layout="{{ s.header_layout }}"
 data-header-align="{{ s.header_alignment }}"
 data-hover="{{ s.enable_hover }}"
 data-zoom="{{ s.enable_image_zoom }}"
 data-secondary="{{ s.show_secondary_image }}"
 data-reveal="{{ s.enable_reveal }}"
>
 <div class="category-showcase__inner">

 {%- if s.subtitle != blank or s.title != blank or s.description != blank or s.show_view_all -%}
 {%- liquid
 assign pf_hdr_btn = ''
 if s.show_view_all and more_in_collection and collection != blank
 assign pf_hdr_btn = s.view_all_label | default: 'Shop All'
 endif
 -%}
 {% render 'uc-section-header',
 subheading: s.subtitle,
 title: s.title,
 description: s.description,
 button_label: pf_hdr_btn,
 button_link: collection.url,
 reveal: true
 %}
 {%- endif -%}

 {%- if collection != blank and collection.products_count > 0 -%}
 <ul class="category-showcase__grid" role="list" data-uc-mobile-scroll aria-label="{{ s.title | default: 'Products' | escape }}">
 {%- assign lazy = false -%}
 {%- for product in collection.products limit: products_limit -%}
 {%- if lazy == false and forloop.index > s.columns_desktop -%}
 {%- assign lazy = true -%}
 {%- endif -%}
 {%- liquid
 assign pf_ratio = 'square'
 if s.image_ratio == 'square'
 assign pf_ratio = 'square'
 elsif s.image_ratio == 'landscape'
 assign pf_ratio = 'landscape'
 elsif s.image_ratio == 'portrait'
 assign pf_ratio = 'portrait'
 endif
 -%}
 <li class="category-showcase__cell" style="--uc-product-image-fit: {{ s.image_fit | default: 'cover' }};">
 {% render 'uc-product-card',
 product: product,
 image_ratio: pf_ratio,
 show_rating: s.show_rating,
 show_quick_add: s.enable_quick_add,
 show_quick_view: false,
 show_vendor: s.show_vendor,
 show_swatches: false,
 lazy: lazy,
 section_id: section.id,
 card_index: forloop.index
 %}
 </li>
 {%- endfor -%}
 </ul>
 {%- else -%}
 <div class="category-showcase__empty">Select a collection with products to display this section.</div>
 {%- endif -%}

 {%- if s.show_view_all and more_in_collection and s.view_all_in_footer and collection != blank -%}
 <div class="category-showcase__footer-cta">
 <a class="category-showcase__header-btn uc-btn uc-btn--ghost" href="{{ collection.url }}">
 <span>{{ s.view_all_label | default: 'Shop All' }}</span>
 <svg class="cs-arrow" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
 </a>
 </div>
 {%- endif -%}
 </div>
</premium-product-showcase>

