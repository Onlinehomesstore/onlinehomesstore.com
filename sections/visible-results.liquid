 { "type": "header", "content": "UC - Section colors" },
 { "type": "checkbox", "id": "use_global_colors", "label": "Use global brand colors", "default": true }
 ],
 "blocks": [
 {
 "type": "statistic",
 "name": "Statistic",
 "settings": [
 { "type": "text", "id": "percentage", "label": "Number", "default": "95%" },
 { "type": "text", "id": "title", "label": "Title", "default": "Healthier hair" },
 { "type": "text", "id": "subtitle", "label": "Subtitle" },
 { "type": "text", "id": "label", "label": "Small label" },
 { "type": "checkbox", "id": "count_up", "label": "Count-up animation", "default": true },
 {
