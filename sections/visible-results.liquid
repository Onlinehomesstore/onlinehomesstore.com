 "options": [
 { "value": "500", "label": "Medium" },
 { "value": "600", "label": "Semibold" },
 { "value": "700", "label": "Bold" }
 ]
 },
 { "type": "color", "id": "number_color", "label": "Number colour" },
 { "type": "color", "id": "text_color", "label": "Text colour" },
 { "type": "range", "id": "min_width", "label": "Minimum width", "min": 100, "max": 260, "step": 10, "unit": "px", "default": 150 },
 { "type": "checkbox", "id": "show_divider", "label": "Show divider", "default": false },
 {
 "type": "select", "id": "divider_style", "label": "Divider style", "default": "line",
 "options": [
 { "value": "line", "label": "Line" },
 { "value": "dot", "label": "Dot" }
 ]
 },
 { "type": "range", "id": "animation_delay", "label": "Animation delay", "min": 0, "max": 800, "step": 50, "unit": "ms", "default": 0 }
 ]
 },
 {
 "type": "feature",
 "name": "Feature",
 "settings": [
 { "type": "header", "content": "Icon" },
 {
 "type": "select", "id": "icon", "label": "Built-in icon", "default": "droplet",
 "options": [
 { "value": "droplet", "label": "Droplet" },
 { "value": "sun", "label": "Sun" },
 { "value": "leaf", "label": "Leaf" },
 { "value": "shield", "label": "Shield" },
 { "value": "sparkle", "label": "Sparkle" },
 { "value": "heart", "label": "Heart" },
 { "value": "check", "label": "Check" },
 { "value": "star", "label": "Star" },
 { "value": "flask", "label": "Flask" },
