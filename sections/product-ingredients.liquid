{%- comment -%}
 ============================================================================
 PRODUCT INGREDIENTS
 ----------------------------------------------------------------------------
 Mobile-first: header → hero image → ingredient cards.
 Desktop: copy + cards left, hero image right.

 Image source (in order):
 1) Section setting "Hero / formula image"
 2) Product featured image (fallback)
 3) Theme-editor placeholder panel

 Reuses: uc-design-tokens.css, uc-components.css, uc-icon.liquid.
 Adds: product-ingredients.css
 CSS prefix: pi-
 ============================================================================
{%- endcomment -%}
{{ 'product-ingredients.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'

  # Prefer section hero image; fall back to product featured image so the media column is useful by default
  assign pi_hero = s.hero_image
  if pi_hero == blank and product != blank and product.featured_image != blank
    assign pi_hero = product.featured_image
  endif

  assign pi_has_media = false
  if pi_hero != blank
    assign pi_has_media = true
  endif

  # Keep a visible image slot in the theme editor even when empty
  assign pi_show_media = false
  if pi_has_media or request.design_mode
    assign pi_show_media = true
  endif
-%}

{%- assign uc_sec_scope = '#ProductIngredients-' | append: uid -%}
{%- render 'uc-section-vars', section: section, scope: uc_sec_scope -%}
{%- render 'uc-section-colors', section: section -%}

{%- style -%}
 #ProductIngredients-{{ uid }} {
 --pi-pad-top: {{ s.padding_top | default: 64 }}px;
 --pi-pad-bottom: {{ s.padding_bottom | default: 64 }}px;
 --pi-card-radius: {{ s.card_radius | default: 16 }}px;
 --pi-img-radius: {{ s.image_radius | default: 24 }}px;
 --pi-gap: {{ s.grid_gap | default: 14 }}px;
 }
 {%- if s.background_color != blank -%}
 #ProductIngredients-{{ uid }} { background: {{ s.background_color }}; }
 {%- endif -%}
 {%- if s.accent_color != blank -%}
 #ProductIngredients-{{ uid }} { --pi-accent: {{ s.accent_color }}; }
 {%- endif -%}
{%- endstyle -%}

<section
 id="ProductIngredients-{{ uid }}"
 class="pi uc-sec color-{{ s.color_scheme }}{% if s.enable_reveal %} pi--reveal{% endif %}{% unless pi_show_media %} pi--no-media{% endunless %}{% if pi_show_media and pi_has_media == false %} pi--media-placeholder{% endif %}"
 data-pi-section
>
 <div class="pi__inner uc-sec__container">

 <div class="pi__main">
 {%- render 'uc-section-header',
   eyebrow: s.eyebrow,
   heading: s.heading,
   description: s.subtitle,
   header_class: 'pi__header',
   reveal: s.enable_reveal
 -%}

 {%- unless pi_show_media -%}
 {%- if s.formula_badge != blank or s.ingredient_count != blank -%}
 <div class="pi__meta-chips" aria-label="Formula highlights">
 {%- if s.formula_badge != blank -%}
 <span class="pi__meta-chip pi__meta-chip--formula">{{ s.formula_badge | escape }}</span>
 {%- endif -%}
 {%- if s.ingredient_count != blank -%}
 <span class="pi__meta-chip pi__meta-chip--count">
 <strong>{{ s.ingredient_count | escape }}</strong>
 {{ s.count_label | default: 'Active Ingredients' | escape }}
 </span>
 {%- endif -%}
 </div>
 {%- endif -%}
 {%- endunless -%}

 <div class="pi__content">
 {%- if ingredient_blocks.size > 0 -%}
 <div class="pi__grid" data-pi-accordions>
 {%- for block in ingredient_blocks -%}
 {%- assign delay = forloop.index0 | times: 60 -%}
 <div
 class="pi__card"
 data-pi-reveal
 data-pi-accordion
 style="--pi-delay: {{ delay }}ms"
 {{ block.shopify_attributes }}
 >
 {%- comment -%} Card header: always visible {%- endcomment -%}
 <button
 type="button"
 class="pi__card-trigger"
 aria-expanded="false"
 aria-controls="pi-acc-{{ uid }}-{{ forloop.index }}"
 >
 <div class="pi__card-left">
 {%- if block.settings.image != blank -%}
 {%- assign pi_card_alt = block.settings.name | escape -%}
 <div class="pi__card-img-wrap">
 {{
 block.settings.image
 | image_url: width: 120
 | image_tag:
 class: 'pi__card-img',
 loading: 'lazy',
 widths: '60, 90, 120',
 alt: pi_card_alt
 }}
 </div>
 {%- else -%}
 <div class="pi__card-img-wrap pi__card-img-wrap--empty" aria-hidden="true">
 {%- render 'uc-icon', icon: 'leaf', size: 22 -%}
 </div>
 {%- endif -%}
 <div class="pi__card-info">
 <div class="pi__card-badges">
 {%- if block.settings.is_natural -%}
 <span class="pi__badge pi__badge--natural">Natural</span>
 {%- endif -%}
 {%- if block.settings.certification != blank -%}
 <span class="pi__badge pi__badge--cert">{{ block.settings.certification | escape }}</span>
 {%- endif -%}
 </div>
 <strong class="pi__card-name">{{ block.settings.name | escape }}</strong>
 {%- if block.settings.scientific_name != blank -%}
 <em class="pi__card-sci">{{ block.settings.scientific_name | escape }}</em>
 {%- endif -%}
 </div>
 </div>
 <span class="pi__card-chevron" aria-hidden="true">
 {%- render 'uc-icon', icon: 'arrow-right', size: 15 -%}
 </span>
 </button>

 {%- comment -%} Card body: expanded on click {%- endcomment -%}
 <div
 class="pi__card-body"
 id="pi-acc-{{ uid }}-{{ forloop.index }}"
 aria-hidden="true"
 >
 <div class="pi__card-details">
 {%- if block.settings.purpose != blank -%}
 <div class="pi__card-row">
 <span class="pi__card-row-label">Purpose</span>
 <span class="pi__card-row-val">{{ block.settings.purpose | escape }}</span>
 </div>
 {%- endif -%}
 {%- if block.settings.key_benefit != blank -%}
 <div class="pi__card-row">
 <span class="pi__card-row-label">Key Benefit</span>
 <span class="pi__card-row-val">{{ block.settings.key_benefit | escape }}</span>
 </div>
 {%- endif -%}
 {%- if block.settings.details != blank -%}
 <div class="pi__card-rte rte">{{ block.settings.details }}</div>
 {%- endif -%}
 </div>
 </div>
 </div>
 {%- endfor -%}
 </div>
 {%- endif -%}

 {%- if s.cta_label != blank -%}
 <div class="pi__cta" data-pi-reveal>
 <a href="{{ s.cta_link | default: '#' }}" class="uc-btn uc-btn--premium">
 {{ s.cta_label | escape }}
 </a>
 </div>
 {%- endif -%}
 </div>
 </div>

 {%- if pi_show_media -%}
 <div class="pi__media" data-pi-reveal>
 {%- if pi_has_media -%}
 {%- assign pi_hero_alt = s.hero_image_alt | default: s.heading | default: product.title | escape -%}
 {{
 pi_hero
 | image_url: width: 900
 | image_tag:
 class: 'pi__media-img',
 loading: 'lazy',
 widths: '480, 720, 900',
 sizes: '(min-width: 990px) 40vw, 92vw',
 alt: pi_hero_alt
 }}
 {%- else -%}
 <div class="pi__media-img pi__media-img--placeholder" role="img" aria-label="Add a hero image in section settings">
 <span class="pi__media-placeholder-label">Add hero image</span>
 <span class="pi__media-placeholder-hint">Theme editor → Ingredients → Hero image</span>
 </div>
 {%- endif -%}
 {%- if s.formula_badge != blank -%}
 <div class="pi__formula-badge">
 <span class="pi__formula-badge-text">{{ s.formula_badge | escape }}</span>
 </div>
 {%- endif -%}
 {%- if s.ingredient_count != blank -%}
 <div class="pi__count-badge">
 <strong class="pi__count-num">{{ s.ingredient_count }}</strong>
 <span class="pi__count-label">{{ s.count_label | default: 'Active Ingredients' | escape }}</span>
 </div>
 {%- endif -%}
 </div>
 {%- endif -%}

 </div>
</section>

<script>
 (function () {
 var section = document.getElementById('ProductIngredients-{{ uid }}');
 if (!section) return;

 /* Reveal animation */
 if (section.classList.contains('pi--reveal') && window.IntersectionObserver) {
 var io = new IntersectionObserver(function (entries, obs) {
 entries.forEach(function (e) {
 if (!e.isIntersecting) return;
 e.target.classList.add('is-in');
 obs.unobserve(e.target);
 });
 }, { threshold: 0.08, rootMargin: '0px 0px -4% 0px' });
 section.querySelectorAll('[data-pi-reveal]').forEach(function (el) { io.observe(el); });
 } else {
 section.querySelectorAll('[data-pi-reveal]').forEach(function (el) { el.classList.add('is-in'); });
 }

 /* One-open accordion for ingredient cards */
 var accWrapper = section.querySelector('[data-pi-accordions]');
 if (!accWrapper) return;
 accWrapper.addEventListener('click', function (e) {
 var trigger = e.target.closest('.pi__card-trigger');
 if (!trigger) return;
 var card = trigger.closest('[data-pi-accordion]');
 var isOpen = card.classList.contains('is-open');

 accWrapper.querySelectorAll('[data-pi-accordion]').forEach(function (c) {
 c.classList.remove('is-open');
 var t = c.querySelector('.pi__card-trigger');
 var b = c.querySelector('.pi__card-body');
 if (t) t.setAttribute('aria-expanded', 'false');
 if (b) b.setAttribute('aria-hidden', 'true');
 });

 if (!isOpen) {
 card.classList.add('is-open');
 trigger.setAttribute('aria-expanded', 'true');
 var body = card.querySelector('.pi__card-body');
 if (body) body.setAttribute('aria-hidden', 'false');
 }
 });
 })();
</script>

{% schema %}
{
 "name": "UC Ingredients showcase",
 "tag": "section",
 "class": "section section-product-ingredients",
 "max_blocks": 16,
 "settings": [
 { "type": "header", "content": "Section header" },
 { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "What's inside" },
 { "type": "text", "id": "heading", "label": "Heading", "default": "Power-packed ingredients" },
 { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Every ingredient is chosen for maximum efficacy. No fillers, no compromises." },
 { "type": "text", "id": "cta_label", "label": "CTA label" },
 { "type": "url", "id": "cta_link", "label": "CTA link" },

 { "type": "header", "content": "Hero image (right column on desktop)" },
