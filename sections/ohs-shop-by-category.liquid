{%- comment -%}
  Shop by category — colorful category cards for baby toys.
{%- endcomment -%}
{{ 'ohs-brand-override.css' | asset_url | stylesheet_tag }}
{{ 'ohs-theme.css' | asset_url | stylesheet_tag }}
{{ 'ohs-playful-home.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<section class="ohs-section" id="OhsCats-{{ section.id }}" style="{% if s.background != blank %}background:{{ s.background }};{% endif %}">
  <div class="ohs-section__inner">
    <header class="ohs-section__head ohs-section__head--center" data-uc-reveal>
      {%- if s.eyebrow != blank -%}<p class="ohs-section__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="ohs-section__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.description != blank -%}<p class="ohs-section__desc">{{ s.description | escape }}</p>{%- endif -%}
    </header>

    <div class="ohs-card-rail" data-ohs-card-rail id="OhsCatRail-{{ section.id }}">
      <div class="ohs-card-rail__viewport" data-ohs-rail-viewport>
        <div class="ohs-card-rail__track" data-ohs-rail-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign href = b.link
          assign title = b.title
          assign image = b.image
          # Prefer picker/asset art over collection.featured_image to avoid
          # repeated photography when many cards share one collection.
          if b.collection != blank
            if href == blank
              assign href = b.collection.url
            endif
            if title == blank
              assign title = b.collection.title
            endif
          endif
          if href == blank
            assign href = routes.all_products_collection_url
          endif
          if title == blank
            assign title = 'Category'
          endif
          assign tone = b.tone | default: 'cream'
          assign fallback = b.asset_file | default: 'ohs-cat-baby.jpg'
        -%}
        <a class="ohs-cat-card ohs-tile--{{ tone }}" href="{{ href }}" {{ block.shopify_attributes }} data-uc-reveal data-reveal-delay="{{ forloop.index0 | times: 40 }}">
          <div class="ohs-cat-card__media">
            {%- if image != blank -%}
              {{ image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 22vw, 45vw', alt: title }}
            {%- else -%}
              {% render 'ohs-asset-img', file: fallback, alt: title %}
            {%- endif -%}
          </div>
          <div class="ohs-cat-card__body">
            <h3 class="ohs-cat-card__title">{{ title | escape }}</h3>
            {%- if b.description != blank -%}
              <p class="ohs-cat-card__desc">{{ b.description | escape }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
        </div>
      </div>
      {%- if section.blocks.size > 2 -%}
        <div class="ohs-card-rail__nav" aria-hidden="false">
          <button type="button" class="ohs-card-rail__arrow" data-ohs-rail-prev aria-label="Previous categories">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="ohs-card-rail__arrow" data-ohs-rail-next aria-label="Next categories">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OHS Shop by Category",
  "tag": "section",
  "class": "ohs-shop-by-category",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP BY INTEREST" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Their Next Favorite!" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Explore toys made for every little interest." },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFDF7" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Baby Toys" },
        { "type": "textarea", "id": "description", "label": "Short description", "default": "Gentle play for the littlest hands." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Custom link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_file", "label": "Fallback asset filename", "default": "ohs-cat-baby.jpg" },
        {
          "type": "select",
          "id": "tone",
          "label": "Pastel tone",
          "options": [
            { "value": "cream", "label": "Cream" },
            { "value": "mint", "label": "Mint" },
            { "value": "peach", "label": "Peach" },
            { "value": "powder", "label": "Sky" },
            { "value": "lavender", "label": "Lavender" },
            { "value": "butter", "label": "Butter" },
            { "value": "coral", "label": "Coral soft" },
            { "value": "sage", "label": "Sage" }
          ],
          "default": "cream"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OHS Shop by Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Baby Toys", "description": "Soft starts for tiny explorers.", "tone": "powder", "asset_file": "ohs-cat-baby.jpg" } },
        { "type": "category", "settings": { "title": "Rattles & Teethers", "description": "Comforting first textures.", "tone": "peach", "asset_file": "ohs-cat-baby.jpg" } },
        { "type": "category", "settings": { "title": "Plush & Soft Toys", "description": "Cuddle-ready companions.", "tone": "lavender", "asset_file": "ohs-feat-soft.jpg" } },
        { "type": "category", "settings": { "title": "Wooden Toys", "description": "Natural, lasting play.", "tone": "butter", "asset_file": "ohs-feat-wooden.jpg" } },
        { "type": "category", "settings": { "title": "Educational Toys", "description": "Curiosity through play.", "tone": "mint", "asset_file": "ohs-feat-learning.jpg" } },
        { "type": "category", "settings": { "title": "Sensory Toys", "description": "Touch, sound and discovery.", "tone": "lavender", "asset_file": "ohs-feat-explorers.jpg" } },
        { "type": "category", "settings": { "title": "Musical Toys", "description": "Rhythm for little ears.", "tone": "coral", "asset_file": "ohs-prod-1.jpg" } },
        { "type": "category", "settings": { "title": "Building Blocks", "description": "Stack, build and imagine.", "tone": "mint", "asset_file": "ohs-feat-explorers.jpg" } },
        { "type": "category", "settings": { "title": "Puzzles & Games", "description": "Focus and fun together.", "tone": "powder", "asset_file": "ohs-feat-learning.jpg" } },
        { "type": "category", "settings": { "title": "Bath Toys", "description": "Splashy smile-makers.", "tone": "powder", "asset_file": "ohs-cat-baby.jpg" } },
        { "type": "category", "settings": { "title": "Activity Gyms", "description": "Tummy-time adventures.", "tone": "peach", "asset_file": "ohs-feat-first.jpg" } },
        { "type": "category", "settings": { "title": "Pretend Play", "description": "Stories start here.", "tone": "butter", "asset_file": "ohs-feat-gifts.jpg" } }
      ]
    }
  ]
}
{% endschema %}
