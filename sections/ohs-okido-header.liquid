{%- comment -%}
  OHS playful header: announcement-ready top utility + shopping nav.
{%- endcomment -%}
{{ 'ohs-brand-override.css' | asset_url | stylesheet_tag }}
{{ 'ohs-okido-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ohs-okido-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings
  assign menu = st.menu
  assign search_placeholder = st.search_placeholder | default: 'Search our store'
  assign use_fallback_nav = false
  if menu == blank or menu.links.size < 4
    assign use_fallback_nav = true
  endif
-%}

<header class="ohs-okido" data-ohs-okido id="OhsOkido-{{ section.id }}">
  <div class="ohs-okido__top">
    <div class="ohs-okido__top-inner">
      <button
        type="button"
        class="ohs-okido__menu-btn"
        data-ohs-okido-open
        aria-expanded="false"
        aria-controls="OhsOkidoDrawer-{{ section.id }}"
        aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
      </button>

      <form class="ohs-okido__search ohs-okido__search-form" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5" stroke-linecap="round"/></svg>
        <label class="ohs-okido__sr-only" for="OhsOkidoSearch-{{ section.id }}">{{ search_placeholder | escape }}</label>
        <input
          id="OhsOkidoSearch-{{ section.id }}"
          class="ohs-okido__search-input"
          type="search"
          name="q"
          placeholder="{{ search_placeholder | escape }}"
          autocomplete="off"
        >
      </form>

      <a class="ohs-okido__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if st.logo != blank -%}
          {{ st.logo | image_url: width: 420 | image_tag: class: 'ohs-okido__logo-img', widths: '160,240,320,420', loading: 'eager', alt: shop.name }}
        {%- else -%}
          <img
            class="ohs-okido__logo-img ohs-okido__logo-img--brand"
            src="{{ 'ohs-logo-primary.svg' | asset_url }}"
            alt="Online Homes Store"
            width="260"
            height="36"
            loading="eager"
          >
        {%- endif -%}
      </a>

      <div class="ohs-okido__tools">
        {%- if st.enable_country_selector -%}
          <span class="ohs-okido__currency" aria-label="Currency">
            <span>{{ cart.currency.symbol }} {{ cart.currency.iso_code }}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        {%- endif -%}

        <a class="ohs-okido__icon" href="{{ routes.account_login_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 19.2c1.6-3 4-4.5 6.5-4.5s4.9 1.5 6.5 4.5" stroke-linecap="round"/></svg>
        </a>

        {%- if st.enable_wishlist -%}
          <a class="ohs-okido__icon" href="{{ st.wishlist_url | default: '/pages/wishlist' }}" aria-label="{{ st.wishlist_label | default: 'Wishlist' | escape }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-9.2A3.8 3.8 0 0 1 12 7.5a3.8 3.8 0 0 1 7 3.3C19 15.6 12 20 12 20z" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}

        <a class="ohs-okido__icon" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="Cart">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.5h11l-.8 9.2a2 2 0 0 1-2 1.8H9.3a2 2 0 0 1-2-1.8L6.5 8.5z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" stroke-linecap="round"/></svg>
          <span class="ohs-okido__badge">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  <nav class="ohs-okido__nav" aria-label="Main menu">
    <ul class="ohs-okido__nav-inner" role="list">
      {%- unless use_fallback_nav -%}
        {%- for link in menu.links -%}
          <li class="ohs-okido__nav-item">
            {%- if link.links != blank and link.links.size > 0 -%}
              <a class="ohs-okido__nav-link{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}">
                <span>{{ link.title | escape }}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <ul class="ohs-okido__drop" role="list">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <a class="ohs-okido__nav-link{% if link.active %} is-active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                {{ link.title | escape }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="ohs-okido__nav-item"><a class="ohs-okido__nav-link" href="{{ routes.root_url }}">Home</a></li>
        <li class="ohs-okido__nav-item"><a class="ohs-okido__nav-link" href="/collections/all">Shop All</a></li>
        <li class="ohs-okido__nav-item"><a class="ohs-okido__nav-link" href="/collections/build-and-discover">Baby Toys</a></li>
        <li class="ohs-okido__nav-item"><a class="ohs-okido__nav-link" href="/collections/build-and-discover">Educational Toys</a></li>
        <li class="ohs-okido__nav-item"><a class="ohs-okido__nav-link" href="/collections/build-and-discover">Wooden Toys</a></li>
        <li class="ohs-okido__nav-item"><a class="ohs-okido__nav-link" href="/collections/stories-in-motion">Soft Toys</a></li>
        <li class="ohs-okido__nav-item"><a class="ohs-okido__nav-link" href="/collections/stories-in-motion">Sensory Toys</a></li>
        <li class="ohs-okido__nav-item"><a class="ohs-okido__nav-link" href="/collections/all">Gifts</a></li>
      {%- endunless -%}
    </ul>
  </nav>

  <div class="ohs-okido__drawer" id="OhsOkidoDrawer-{{ section.id }}" data-ohs-okido-drawer aria-hidden="true">
    <div class="ohs-okido__drawer-overlay" data-ohs-okido-close></div>
    <div class="ohs-okido__drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="ohs-okido__drawer-head">
        <span class="ohs-okido__drawer-title">Online Homes Store</span>
        <button type="button" class="ohs-okido__drawer-close" data-ohs-okido-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
        </button>
      </div>
      <form class="ohs-okido__drawer-search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#222" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5" stroke-linecap="round"/></svg>
        <input type="search" name="q" placeholder="{{ search_placeholder | escape }}">
      </form>
      <ul class="ohs-okido__drawer-nav" role="list">
        {%- unless use_fallback_nav -%}
          {%- for link in menu.links -%}
            <li>
              {%- if link.links != blank and link.links.size > 0 -%}
                <details>
                  <summary>{{ link.title | escape }}</summary>
                  <ul class="ohs-okido__drawer-sub" role="list">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="/collections/all">Shop All</a></li>
          <li><a href="/collections/build-and-discover">Baby Toys</a></li>
          <li><a href="/collections/build-and-discover">Educational Toys</a></li>
          <li><a href="/collections/build-and-discover">Wooden Toys</a></li>
          <li><a href="/collections/stories-in-motion">Soft Toys</a></li>
          <li><a href="/collections/stories-in-motion">Sensory Toys</a></li>
          <li><a href="/collections/all">Gifts</a></li>
        {%- endunless -%}
      </ul>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "OHS Okido Header",
  "tag": "section",
  "class": "ohs-okido-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Custom logo image (optional)" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search our store" },
    { "type": "checkbox", "id": "enable_country_selector", "label": "Show currency selector", "default": true },
    { "type": "checkbox", "id": "enable_wishlist", "label": "Show wishlist", "default": true },
    { "type": "text", "id": "wishlist_label", "label": "Wishlist label", "default": "Wishlist" },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist page" },
    { "type": "checkbox", "id": "sticky_header", "label": "Sticky header", "default": true }
  ],
  "presets": [{ "name": "OHS Okido Header" }]
}
{% endschema %}
