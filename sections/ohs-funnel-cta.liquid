{%- comment -%} Compact mid-page sales CTA for Toys Home funnel {%- endcomment -%}
{{ 'ohs-theme.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="ohs-funnel-cta" id="OhsFunnel-{{ section.id }}" style="background:{{ s.background | default: '#E2F0E6' }};">
  <div class="ohs-funnel-cta__inner">
    <div class="ohs-funnel-cta__copy">
      {%- if s.eyebrow != blank -%}<p class="ohs-section__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="ohs-section__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="ohs-section__desc">{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <div class="ohs-funnel-cta__actions">
      {%- if s.button_label != blank -%}
        <a class="ohs-btn ohs-btn--primary" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
      {%- if s.button_label_2 != blank -%}
        <a class="ohs-btn ohs-btn--secondary" href="{{ s.button_link_2 | default: routes.all_products_collection_url }}">{{ s.button_label_2 | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OHS Funnel CTA",
  "tag": "section",
  "class": "ohs-funnel-cta-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "READY TO PLAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find their next favorite toy today" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Shop bestsellers, browse by age, or explore gifts — free to discover, easy to checkout." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop Best Sellers" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "Shop All Toys" },
    { "type": "url", "id": "button_link_2", "label": "Secondary link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#E2F0E6" }
  ],
  "presets": [{ "name": "OHS Funnel CTA" }]
}
{% endschema %}
